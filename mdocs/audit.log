{"timestamp":"2026-10-08T19:48:58.645Z","type":"tool","initiativeId":"multi-version-release-setup-1-20-1-1-21-1","step":"PLAN","details":{"toolName":"write","args":{"content":"name: Build\n\non:\n  push:\n    branches: [main, 'version/*']\n  pull_request:\n    branches: [main, 'version/*']\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          fetch-tags: true\n\n      # Gradle runs on JDK 21; each branch's Gradle toolchain\n      # (21 for 1.21.1, 17 for 1.20.1) is auto-provisioned via the\n      # foojay resolver in settings.gradle.\n      - name: Setup JDK 21\n        uses: actions/setup-java@v4\n        with:\n          java-version: '21'\n          distribution: 'temurin'\n\n      - name: Setup Gradle\n        uses: gradle/actions/setup-gradle@v4\n\n      # This is needed to be able to run ./gradlew below\n      # You can run `git update-index --chmod +x gradlew` then remove this step.\n      - name: Make Gradle wrapper executable\n        run: chmod +x ./gradlew\n\n      - name: Build with Gradle\n        run: ./gradlew build\n\n      - name: Upload mod jar\n        uses: actions/upload-artifact@v4\n        with:\n          name: siasworkshop-${{ github.ref_name }}\n          path: build/libs/\n          if-no-files-found: error\n","path":".github/workflows/build.yml"}}}
{"timestamp":"2026-10-08T19:48:58.649Z","type":"tool","initiativeId":"multi-version-release-setup-1-20-1-1-21-1","step":"PLAN","details":{"toolName":"write","args":{"content":"name: Build\n\non:\n  push:\n    branches: [main, 'version/*']\n  pull_request:\n    branches: [main, 'version/*']\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          fetch-tags: true\n\n      # Gradle runs on JDK 21; each branch's Gradle toolchain\n      # (21 for 1.21.1, 17 for 1.20.1) is auto-provisioned via the\n      # foojay resolver in settings.gradle.\n      - name: Setup JDK 21\n        uses: actions/setup-java@v4\n        with:\n          java-version: '21'\n          distribution: 'temurin'\n\n      - name: Setup Gradle\n        uses: gradle/actions/setup-gradle@v4\n\n      # This is needed to be able to run ./gradlew below\n      # You can run `git update-index --chmod +x gradlew` then remove this step.\n      - name: Make Gradle wrapper executable\n        run: chmod +x ./gradlew\n\n      - name: Build with Gradle\n        run: ./gradlew build\n\n      - name: Upload mod jar\n        uses: actions/upload-artifact@v4\n        with:\n          name: siasworkshop-${{ github.ref_name }}\n          path: build/libs/\n          if-no-files-found: error\n","path":".github/workflows/build.yml"}}}
