{"timestamp":"2026-10-17T18:08:23.391Z","type":"tool","initiativeId":"mcp-hotplug-debug-access--2026-10-17","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Wire-tap test: sidecar.py --tap must record the full mod<->sidecar exchange as\ntimestamped, direction-tagged JSON lines while the protocol on stdout stays pure.\n\nRuns the same crossed-pipe topology as test_sidecar_bridge.py, asserts the tap file\ncaptured both directions (out: initialize/initialized/decide-response; in: the mod's\ninitialize result and tool results) and that every tap line parses as the documented\n{\"ts\", \"dir\", \"msg\"} shape.\n\nRun: python3 test_tap.py\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nHERE = os.path.dirname(os.path.abspath(__file__))\n\n\ndef main() -> int:\n    tap_path = os.path.join(tempfile.mkdtemp(prefix=\"siasworkshop-tap-\"), \"wire.jsonl\")\n    mock = subprocess.Popen([sys.executable, os.path.join(HERE, \"mockmod.py\"),\n                             os.path.join(HERE, \"scenarios/stone_bricks_chest.json\")],\n                            stdin=subprocess.PIPE, stdout=subprocess.PIPE)\n    sidecar = subprocess.Popen([sys.executable, os.path.join(HERE, \"sidecar.py\"),\n                                \"--replay\", os.path.join(HERE, \"replay/bridge-script.json\"),\n                                \"--tap\", tap_path],\n                               stdin=subprocess.PIPE, stdout=subprocess.PIPE)\n    write_lock = threading.Lock()\n    done = threading.Event()\n\n    def relay(src, dst):\n        for line in src:\n            with write_lock:\n                dst.write(line)\n                dst.flush()\n        done.set()\n\n    for args in ((sidecar.stdout, mock.stdin), (mock.stdout, sidecar.stdin)):\n        threading.Thread(target=relay, args=args, daemon=True).start()\n\n    time.sleep(0.7)  # handshake first\n    decide_request = (json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"tools/call\",\n                                  \"params\": {\"name\": \"decide\",\n                                             \"arguments\": {\"agent\": \"agent-1\"}}}) + \"\\n\").encode()\n    with write_lock:\n        sidecar.stdin.write(decide_request)\n        sidecar.stdin.flush()\n    finished = done.wait(timeout=20)\n    time.sleep(0.3)  # let the tap file flush before reading it\n    for proc in (mock, sidecar):\n        try:\n            proc.terminate()\n            proc.wait(timeout=5)\n        except Exception:\n            proc.kill()\n\n    failures = 0\n    if not finished:\n        failures += 1\n        print(\"FAIL: relay ended before the decide cycle\")\n\n    rows = []\n    if os.path.exists(tap_path):\n        with open(tap_path, encoding=\"utf-8\") as fh:\n            for lineno, text in enumerate(fh, 1):\n                text = text.strip()\n                if not text:\n                    continue\n                try:\n                    row = json.loads(text)\n                except ValueError:\n                    failures += 1\n                    print(f\"FAIL: tap line {lineno} is not JSON: {text[:120]!r}\")\n                    continue\n                if not (\"ts\" in row and \"dir\" in row and (\"msg\" in row or \"unparsed\" in row)):\n                    failures += 1\n                    print(f\"FAIL: tap line {lineno} missing ts/dir/msg: {row}\")\n                    continue\n                if row[\"dir\"] not in (\"in\", \"out\"):\n                    failures += 1\n                    print(f\"FAIL: tap line {lineno} bad dir: {row['dir']}\")\n                    continue\n                rows.append(row)\n    else:\n        failures += 1\n        print(f\"FAIL: tap file was never created: {tap_path}\")\n\n    out_methods = [r[\"msg\"].get(\"method\") for r in rows if r[\"dir\"] == \"out\" and \"msg\" in r]\n    in_results = [r[\"msg\"] for r in rows if r[\"dir\"] == \"in\" and \"msg\" in r\n                  and \"result\" in r[\"msg\"]]\n    if \"initialize\" not in out_methods:\n        failures += 1\n        print(\"FAIL: tap missing outbound initialize\")\n    if \"notifications/initialized\" not in out_methods:\n        failures += 1\n        print(\"FAIL: tap missing outbound initialized notification\")\n    if not any(m.get(\"id\") == 99 for m in in_results):\n        failures += 1\n        print(\"FAIL: tap missing the decide response (id 99)\")\n    if not any(m.get(\"id\") == 99 for m in [r[\"msg\"] for r in rows if r[\"dir\"] == \"out\" and \"msg\" in r]):\n        failures += 1\n        print(\"FAIL: tap missing the inbound decide request relayed to the sidecar\")\n    if not any(r[\"dir\"] == \"in\" and \"msg\" in r and r[\"msg\"].get(\"result\", {}).get(\"serverInfo\")\n               for r in rows):\n        failures += 1\n        print(\"FAIL: tap missing the mod's initialize result (inbound serverInfo)\")\n    if any(\"unparsed\" in r for r in rows):\n        failures += 1\n        print(\"FAIL: wire corruption — unparsed lines on the tap\")\n\n    print(f\"tap rows: {len(rows)} ({sum(1 for r in rows if r['dir'] == 'out')} out,\"\n          f\" {sum(1 for r in rows if r['dir'] == 'in')} in)\")\n    print(\"tap test:\", \"PASS\" if failures == 0 else f\"{failures} failures\")\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","path":"sidecar/test_tap.py"}}}
{"timestamp":"2026-10-17T18:08:23.395Z","type":"tool","initiativeId":"mcp-hotplug-debug-access--2026-10-17","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Wire-tap test: sidecar.py --tap must record the full mod<->sidecar exchange as\ntimestamped, direction-tagged JSON lines while the protocol on stdout stays pure.\n\nRuns the same crossed-pipe topology as test_sidecar_bridge.py, asserts the tap file\ncaptured both directions (out: initialize/initialized/decide-response; in: the mod's\ninitialize result and tool results) and that every tap line parses as the documented\n{\"ts\", \"dir\", \"msg\"} shape.\n\nRun: python3 test_tap.py\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\n\nHERE = os.path.dirname(os.path.abspath(__file__))\n\n\ndef main() -> int:\n    tap_path = os.path.join(tempfile.mkdtemp(prefix=\"siasworkshop-tap-\"), \"wire.jsonl\")\n    mock = subprocess.Popen([sys.executable, os.path.join(HERE, \"mockmod.py\"),\n                             os.path.join(HERE, \"scenarios/stone_bricks_chest.json\")],\n                            stdin=subprocess.PIPE, stdout=subprocess.PIPE)\n    sidecar = subprocess.Popen([sys.executable, os.path.join(HERE, \"sidecar.py\"),\n                                \"--replay\", os.path.join(HERE, \"replay/bridge-script.json\"),\n                                \"--tap\", tap_path],\n                               stdin=subprocess.PIPE, stdout=subprocess.PIPE)\n    write_lock = threading.Lock()\n    done = threading.Event()\n\n    def relay(src, dst):\n        for line in src:\n            with write_lock:\n                dst.write(line)\n                dst.flush()\n        done.set()\n\n    for args in ((sidecar.stdout, mock.stdin), (mock.stdout, sidecar.stdin)):\n        threading.Thread(target=relay, args=args, daemon=True).start()\n\n    time.sleep(0.7)  # handshake first\n    decide_request = (json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"tools/call\",\n                                  \"params\": {\"name\": \"decide\",\n                                             \"arguments\": {\"agent\": \"agent-1\"}}}) + \"\\n\").encode()\n    with write_lock:\n        sidecar.stdin.write(decide_request)\n        sidecar.stdin.flush()\n    finished = done.wait(timeout=20)\n    time.sleep(0.3)  # let the tap file flush before reading it\n    for proc in (mock, sidecar):\n        try:\n            proc.terminate()\n            proc.wait(timeout=5)\n        except Exception:\n            proc.kill()\n\n    failures = 0\n    if not finished:\n        failures += 1\n        print(\"FAIL: relay ended before the decide cycle\")\n\n    rows = []\n    if os.path.exists(tap_path):\n        with open(tap_path, encoding=\"utf-8\") as fh:\n            for lineno, text in enumerate(fh, 1):\n                text = text.strip()\n                if not text:\n                    continue\n                try:\n                    row = json.loads(text)\n                except ValueError:\n                    failures += 1\n                    print(f\"FAIL: tap line {lineno} is not JSON: {text[:120]!r}\")\n                    continue\n                if not (\"ts\" in row and \"dir\" in row and (\"msg\" in row or \"unparsed\" in row)):\n                    failures += 1\n                    print(f\"FAIL: tap line {lineno} missing ts/dir/msg: {row}\")\n                    continue\n                if row[\"dir\"] not in (\"in\", \"out\"):\n                    failures += 1\n                    print(f\"FAIL: tap line {lineno} bad dir: {row['dir']}\")\n                    continue\n                rows.append(row)\n    else:\n        failures += 1\n        print(f\"FAIL: tap file was never created: {tap_path}\")\n\n    out_methods = [r[\"msg\"].get(\"method\") for r in rows if r[\"dir\"] == \"out\" and \"msg\" in r]\n    in_results = [r[\"msg\"] for r in rows if r[\"dir\"] == \"in\" and \"msg\" in r\n                  and \"result\" in r[\"msg\"]]\n    if \"initialize\" not in out_methods:\n        failures += 1\n        print(\"FAIL: tap missing outbound initialize\")\n    if \"notifications/initialized\" not in out_methods:\n        failures += 1\n        print(\"FAIL: tap missing outbound initialized notification\")\n    if not any(m.get(\"id\") == 99 for m in in_results):\n        failures += 1\n        print(\"FAIL: tap missing the decide response (id 99)\")\n    if not any(m.get(\"id\") == 99 for m in [r[\"msg\"] for r in rows if r[\"dir\"] == \"out\" and \"msg\" in r]):\n        failures += 1\n        print(\"FAIL: tap missing the inbound decide request relayed to the sidecar\")\n    if not any(r[\"dir\"] == \"in\" and \"msg\" in r and r[\"msg\"].get(\"result\", {}).get(\"serverInfo\")\n               for r in rows):\n        failures += 1\n        print(\"FAIL: tap missing the mod's initialize result (inbound serverInfo)\")\n    if any(\"unparsed\" in r for r in rows):\n        failures += 1\n        print(\"FAIL: wire corruption — unparsed lines on the tap\")\n\n    print(f\"tap rows: {len(rows)} ({sum(1 for r in rows if r['dir'] == 'out')} out,\"\n          f\" {sum(1 for r in rows if r['dir'] == 'in')} in)\")\n    print(\"tap test:\", \"PASS\" if failures == 0 else f\"{failures} failures\")\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","path":"sidecar/test_tap.py"}}}
{"timestamp":"2026-10-17T18:09:14.036Z","type":"tool","initiativeId":"mcp-hotplug-debug-access--2026-10-17","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    write_lock = threading.Lock()\n    done = threading.Event()\n\n    def relay(src, dst, tag):\n        for line in src:\n            with write_lock:\n                dst.write(line)\n                dst.flush()\n            if tag == \"s2m\" and '\"id\":99' in line.decode(errors=\"replace\").replace(\" \", \"\") \\\n                    and '\"result\"' in line.decode(errors=\"replace\"):\n                done.set()\n        done.set()\n\n    for args in ((sidecar.stdout, mock.stdin, \"s2m\"), (mock.stdout, sidecar.stdin, \"m2s\")):\n        threading.Thread(target=relay, args=args, daemon=True).start()","oldString":"    write_lock = threading.Lock()\n    done = threading.Event()\n\n    def relay(src, dst):\n        for line in src:\n            with write_lock:\n                dst.write(line)\n                dst.flush()\n        done.set()\n\n    for args in ((sidecar.stdout, mock.stdin), (mock.stdout, sidecar.stdin)):\n        threading.Thread(target=relay, args=args, daemon=True).start()","path":"sidecar/test_tap.py"}}}
