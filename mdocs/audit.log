{"timestamp":"2026-10-14T19:45:28.377Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    // --- pool citations ------------------------------------------------------------\n\n    /** Replaces the agent's citation candidates with the entries retrieved for this decision. */\n    private static void rememberCitations(WorkshopAgentEntity agent, List<PoolEntry> retrieved) {\n        if (!retrieved.isEmpty()) {\n            pendingCitations.put(agent.getUUID(), retrieved.stream().map(PoolEntry::id).toList());\n        }\n    }\n\n    /**\n     * When a task this agent claimed resolves DONE, the entries it retrieved when deciding\n     * are cited via {@code pool.recordSuccess} — the plan reuse earned the success. FAILED\n     * resolutions cite nothing (and lease sweeps never reach here: they release the claim).\n     * The board's own resolution hook writes the outcome entry; this only bumps the reused\n     * entries' success counters.\n     */\n    private static void resolveCitations(WorkshopAgentEntity agent, TaskBoard board, AgentDecisionPool pool, long now) {\n        List<String> entryIds = pendingCitations.get(agent.getUUID());\n        if (entryIds == null || entryIds.isEmpty()) {\n            return;\n        }\n        for (BoardTask task : board.tasks()) {\n            boolean mine = agent.getUUID().equals(task.claimantUuid());\n            if (mine && task.status() == BoardTask.Status.DONE) {\n                for (String entryId : entryIds) {\n                    pool.recordSuccess(entryId, now);\n                }\n                pendingCitations.remove(agent.getUUID());\n                return;\n            }\n        }\n    }","oldString":"    // --- pool citations ------------------------------------------------------------\n\n    private static void rememberCitations(WorkshopAgentEntity agent, List<BoardTask> open, List<PoolEntry> retrieved) {\n        if (retrieved.isEmpty()) {\n            return;\n        }\n        List<String> ids = retrieved.stream().map(PoolEntry::id).toList();\n        pendingCitations.computeIfAbsent(agent.getUUID(), key -> new HashMap<>())\n                .put(open.get(0).key(), ids); // refreshed on every decision; keyed by highest-priority open task\n    }\n\n    /** When a task this agent claimed resolves, cite the retrieved entries (DONE → recordSuccess). */\n    private static void resolveCitations(WorkshopAgentEntity agent, TaskBoard board, AgentDecisionPool pool, long now) {\n        Map<String, List<String>> citations = pendingCitations.get(agent.getUUID());\n        if (citations == null || citations.isEmpty()) {\n            return;\n        }\n        for (BoardTask task : board.tasks()) {\n            List<String> entryIds = citations.get(task.key());\n            if (entryIds == null || task.status() == BoardTask.Status.OPEN || task.status() == BoardTask.Status.CLAIMED) {\n                continue;\n            }\n            if (task.status() == BoardTask.Status.DONE) {\n                for (String entryId : entryIds) {\n                    pool.recordSuccess(entryId, now);\n                }\n            }\n            citations.remove(task.key());\n            if (citations.isEmpty()) {\n                pendingCitations.remove(agent.getUUID());\n                return;\n            }\n        }\n    }","path":"src/main/java/com/siaws/siawsmod/content/agents/AgentDecisionLoop.java"}}}
