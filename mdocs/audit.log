trieved.isEmpty()) {\n            return;\n        }\n        List<String> ids = retrieved.stream().map(PoolEntry::id).toList();\n        pendingCitations.computeIfAbsent(agent.getUUID(), key -> new HashMap<>())\n                .put(open.get(0).key(), ids); // refreshed on every decision; keyed by highest-priority open task\n    }\n\n    /** When a task this agent claimed resolves, cite the retrieved entries (DONE → recordSuccess). */\n    private static void resolveCitations(WorkshopAgentEntity agent, TaskBoard board, AgentDecisionPool pool, long now) {\n        Map<String, List<String>> citations = pendingCitations.get(agent.getUUID());\n        if (citations == null || citations.isEmpty()) {\n            return;\n        }\n        for (BoardTask task : board.tasks()) {\n            List<String> entryIds = citations.get(task.key());\n            if (entryIds == null || task.status() == BoardTask.Status.OPEN || task.status() == BoardTask.Status.CLAIMED) {\n                continue;\n            }\n            if (task.status() == BoardTask.Status.DONE) {\n                for (String entryId : entryIds) {\n                    pool.recordSuccess(entryId, now);\n                }\n            }\n            citations.remove(task.key());\n            if (citations.isEmpty()) {\n                pendingCitations.remove(agent.getUUID());\n                return;\n            }\n        }\n    }","path":"src/main/java/com/siaws/siawsmod/content/agents/AgentDecisionLoop.java"}}}
