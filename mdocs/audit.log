recorded None, not invalid)\")\n\n\ndef main() -> int:\n    test_score_run()\n    test_jeva_metrics()\n    test_summarize()\n    test_integration()\n    test_native_tier0()\n    print(f\"\\ncorpus tests: {'PASS' if FAILURES == 0 else f'{FAILURES} failures'}\")\n    return 1 if FAILURES else 0","oldString":"def main() -> int:\n    test_score_run()\n    test_jeva_metrics()\n    test_summarize()\n    test_integration()\n    print(f\"\\ncorpus tests: {'PASS' if FAILURES == 0 else f'{FAILURES} failures'}\")\n    return 1 if FAILURES else 0","path":"sidecar/test_corpus.py"}}}
