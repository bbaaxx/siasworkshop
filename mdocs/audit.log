{"timestamp":"2026-10-14T14:42:35.901Z","type":"tool","initiativeId":"agents-v1-decision-pool-goals--2026-10-14","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    private static void runShelterDetector(ServerLevel level, TaskBoard board, AgentDecisionPool pool,\n            int poolMaxEntries, ServerPlayer player, BlockPos center, long now, int radius) {\n        boolean bedNearby = hasBedNearby(level, center, radius);\n        // raw sky light is 15 for any column open to the sky at any time of day (StarLight stores\n        // it without the night-time skydarken), so this is a true exposure check, not a daylight check\n        boolean exposed = level.canSeeSky(center);\n        String key = \"comfort:shelter:\" + player.getUUID();\n        if (!bedNearby || exposed) {\n            board.raiseIfAbsent(key, BoardTask.Type.COMFORT_SHELTER,\n                    (exposed ? \"exposed\" : \"no bed\") + \" at night for \" + player.getName().getString(), now);\n        } else {\n            board.clearIfOpen(key);\n            board.autoCompleteClaimed(key, now, pool, poolMaxEntries);\n        }\n    }","oldString":"    private static void runShelterDetector(ServerLevel level, TaskBoard board, AgentDecisionPool pool,\n            int poolMaxEntries, ServerPlayer player, BlockPos center, long now, int radius) {\n        boolean bedNearby = hasBedNearby(level, center, radius);\n        boolean exposed = level.getBrightness(LightLayer.SKY, center) >= 15;\n        String key = \"comfort:shelter:\" + player.getUUID();\n        if (!bedNearby || exposed) {\n            board.raiseIfAbsent(key, BoardTask.Type.COMFORT_SHELTER,\n                    (exposed ? \"exposed\" : \"no bed\") + \" at night for \" + player.getName().getString(), now);\n        } else {\n            board.clearIfOpen(key);\n            board.autoCompleteClaimed(key, now, pool, poolMaxEntries);\n        }\n    }","path":"src/main/java/com/siaws/siawsmod/content/agents/tasks/ComfortDetectors.java"}}}
{"timestamp":"2026-10-14T14:42:35.905Z","type":"tool","initiativeId":"agents-v1-decision-pool-goals--2026-10-14","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    private static void runShelterDetector(ServerLevel level, TaskBoard board, AgentDecisionPool pool,\n            int poolMaxEntries, ServerPlayer player, BlockPos center, long now, int radius) {\n        boolean bedNearby = hasBedNearby(level, center, radius);\n        // raw sky light is 15 for any column open to the sky at any time of day (StarLight stores\n        // it without the night-time skydarken), so this is a true exposure check, not a daylight check\n        boolean exposed = level.canSeeSky(center);\n        String key = \"comfort:shelter:\" + player.getUUID();\n        if (!bedNearby || exposed) {\n            board.raiseIfAbsent(key, BoardTask.Type.COMFORT_SHELTER,\n                    (exposed ? \"exposed\" : \"no bed\") + \" at night for \" + player.getName().getString(), now);\n        } else {\n            board.clearIfOpen(key);\n            board.autoCompleteClaimed(key, now, pool, poolMaxEntries);\n        }\n    }","oldString":"    private static void runShelterDetector(ServerLevel level, TaskBoard board, AgentDecisionPool pool,\n            int poolMaxEntries, ServerPlayer player, BlockPos center, long now, int radius) {\n        boolean bedNearby = hasBedNearby(level, center, radius);\n        boolean exposed = level.getBrightness(LightLayer.SKY, center) >= 15;\n        String key = \"comfort:shelter:\" + player.getUUID();\n        if (!bedNearby || exposed) {\n            board.raiseIfAbsent(key, BoardTask.Type.COMFORT_SHELTER,\n                    (exposed ? \"exposed\" : \"no bed\") + \" at night for \" + player.getName().getString(), now);\n        } else {\n            board.clearIfOpen(key);\n            board.autoCompleteClaimed(key, now, pool, poolMaxEntries);\n        }\n    }","path":"src/main/java/com/siaws/siawsmod/content/agents/tasks/ComfortDetectors.java"}}}
