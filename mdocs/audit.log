{"timestamp":"2026-10-08T20:10:08.025Z","type":"tool","step":"COMPLETE","details":{"toolName":"edit","args":{"newString":"legacyForge {\n    // NeoForge 1.20.1 kept Forge-compatible coordinates (net.neoforged:forge).\n    // neoForgeVersion (not version =) makes the legacy plugin resolve the neoforged group;\n    // plain version = targets MinecraftForge instead.\n    // -Puse_minecraftforge builds against MinecraftForge (net.minecraftforge group) to verify\n    // the mod against the other half of the 47.1-compatible line; the published reobf jar is the same.\n    if (project.hasProperty('use_minecraftforge')) {\n        version = project.neo_version\n    } else {\n        enable {\n            neoForgeVersion = project.neo_version\n        }\n    }","oldString":"legacyForge {\n    // NeoForge 1.20.1 keeps Forge-compatible coordinates (net.neoforged:forge).\n    // neoForgeVersion (not version =) makes the legacy plugin resolve the neoforged group;\n    // plain version = would target MinecraftForge instead.\n    enable {\n        neoForgeVersion = project.neo_version\n    }","path":"build.gradle"}}}
{"timestamp":"2026-10-08T20:10:08.029Z","type":"tool","step":"COMPLETE","details":{"toolName":"edit","args":{"newString":"legacyForge {\n    // NeoForge 1.20.1 kept Forge-compatible coordinates (net.neoforged:forge).\n    // neoForgeVersion (not version =) makes the legacy plugin resolve the neoforged group;\n    // plain version = targets MinecraftForge instead.\n    // -Puse_minecraftforge builds against MinecraftForge (net.minecraftforge group) to verify\n    // the mod against the other half of the 47.1-compatible line; the published reobf jar is the same.\n    if (project.hasProperty('use_minecraftforge')) {\n        version = project.neo_version\n    } else {\n        enable {\n            neoForgeVersion = project.neo_version\n        }\n    }","oldString":"legacyForge {\n    // NeoForge 1.20.1 keeps Forge-compatible coordinates (net.neoforged:forge).\n    // neoForgeVersion (not version =) makes the legacy plugin resolve the neoforged group;\n    // plain version = would target MinecraftForge instead.\n    enable {\n        neoForgeVersion = project.neo_version\n    }","path":"build.gradle"}}}
