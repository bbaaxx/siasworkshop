{"timestamp":"2026-10-18T04:19:59.144Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"bash","args":{"command":"python3 - <<'EOF'\nimport random, copy, json\n\ntasks = [\"build:mazons:-20,86,0\", \"comfort:light:9a41f0c2-7d18-4a5e-b3f9-2c8e6d1f4a77\"]\n\ndef order(seed, perms):\n    rng = random.Random(seed)\n    t = copy.deepcopy(tasks)\n    if perms > 1:\n        rng.shuffle(t)\n    return tuple(t)\n\nfor trial in range(1, 6):\n    o1 = order(42 + trial*1000 + 1, 2)\n    o2 = order(42 + trial*1000 + 2, 2)\n    print(f\"trial {trial}: perm1={o1[0][:12]:12} perm2={o2[0][:12]:12} flip={o1 != o2}\")\n\n# null-board scenario, seed 11, one task\nprint(\"null 1-task order:\", order(11 + 1000 + 1, 2))\nEOF"}}}
{"timestamp":"2026-10-18T04:19:59.148Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"bash","args":{"command":"python3 - <<'EOF'\nimport random, copy, json\n\ntasks = [\"build:mazons:-20,86,0\", \"comfort:light:9a41f0c2-7d18-4a5e-b3f9-2c8e6d1f4a77\"]\n\ndef order(seed, perms):\n    rng = random.Random(seed)\n    t = copy.deepcopy(tasks)\n    if perms > 1:\n        rng.shuffle(t)\n    return tuple(t)\n\nfor trial in range(1, 6):\n    o1 = order(42 + trial*1000 + 1, 2)\n    o2 = order(42 + trial*1000 + 2, 2)\n    print(f\"trial {trial}: perm1={o1[0][:12]:12} perm2={o2[0][:12]:12} flip={o1 != o2}\")\n\n# null-board scenario, seed 11, one task\nprint(\"null 1-task order:\", order(11 + 1000 + 1, 2))\nEOF"}}}
{"timestamp":"2026-10-18T04:20:12.209Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"edit","args":{"path":"sidecar/corpus_score.py","oldString":"JEVA Tier-0: null/coverage is a SEPARATE question from the decision, never a list\noption. A binary coverage answer gives no AUROC, so a soft coverage_confidence is\nrecorded per run — AUROC becomes computable at Tier 1 from the paired answers.\n\"\"\"","newString":"JEVA Tier-0: null/coverage is a SEPARATE question from the decision, never a list\noption. A binary coverage answer gives no AUROC, so a soft coverage_confidence is\nrecorded per run — AUROC becomes computable at Tier 1 from the paired answers.\n\nJEVA Tier-1 (probe_decision rows): rows also carry a float coverage_confidence\n(P(yes)); null_auc turns it into detection metrics. POSITIVE = null board (nothing\nclaimable): a good model says P(yes)~0 there, so detection_score = 1 - confidence.\n\"\"\""}}}
{"timestamp":"2026-10-18T04:20:12.214Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"edit","args":{"path":"sidecar/corpus_score.py","oldString":"JEVA Tier-0: null/coverage is a SEPARATE question from the decision, never a list\noption. A binary coverage answer gives no AUROC, so a soft coverage_confidence is\nrecorded per run — AUROC becomes computable at Tier 1 from the paired answers.\n\"\"\"","newString":"JEVA Tier-0: null/coverage is a SEPARATE question from the decision, never a list\noption. A binary coverage answer gives no AUROC, so a soft coverage_confidence is\nrecorded per run — AUROC becomes computable at Tier 1 from the paired answers.\n\nJEVA Tier-1 (probe_decision rows): rows also carry a float coverage_confidence\n(P(yes)); null_auc turns it into detection metrics. POSITIVE = null board (nothing\nclaimable): a good model says P(yes)~0 there, so detection_score = 1 - confidence.\n\"\"\""}}}
{"timestamp":"2026-10-18T04:20:34.502Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"edit","args":{"newString":"    null_truth = bool((assert_spec or {}).get(\"null_ground_truth\"))\n    tp = fp = tn = fn = 0\n    for r in rows:\n        cov = r.get(\"coverage_any_claimable\")\n        if not isinstance(cov, bool):\n            continue\n        if null_truth:\n            fp, tn = (fp + 1, tn) if cov else (fp, tn + 1)\n        else:\n            tp, fn = (tp + 1, fn) if cov else (tp, fn + 1)\n    tpr = tp / (tp + fn) if (tp + fn) else None\n    fpr = fp / (fp + tn) if (fp + tn) else None\n    result = {\n        \"flip_rate\": flipped / len(eligible) if eligible else 0.0,\n        \"flip_trials\": flipped,\n        \"eligible_trials\": len(eligible),\n        \"all_order_accuracy\": all_order_accuracy,\n        \"n_runs\": n_runs,\n        \"per_order_accuracy\": per_order_accuracy,\n        \"null_matrix\": {\"tp\": tp, \"fp\": fp, \"tn\": tn, \"fn\": fn, \"tpr\": tpr, \"fpr\": fpr},\n    }\n    # Tier-1: soft coverage_confidence present -> AUROC of null-board detection.\n    has_conf = any(_is_number(r.get(\"coverage_confidence\")) for r in rows)\n    if has_conf:\n        truth_rows = [dict(r, null_ground_truth=null_truth) for r in rows]\n        result[\"null_auc\"] = null_auc(truth_rows)\n    return result\n\n\ndef _is_number(v) -> bool:\n    return isinstance(v, (int, float)) and not isinstance(v, bool)\n\n\ndef null_auc(rows, fpr_target=0.05) -> dict:\n    \"\"\"Tier-1 null-board detection from soft coverage_confidence.\n\n    POSITIVE = null board (nothing claimable); detection_score = 1 - P(yes), so a\n    good model scores ~1 on null boards and ~0 elsewhere. Rows with missing/None/\n    non-float confidence are skipped; truth comes from each row's\n    \"null_ground_truth\". AUC is the rank-based Mann-Whitney statistic (ties 0.5);\n    tpr_at_fpr is the TPR at the largest detection-score threshold whose FPR stays\n    <= fpr_target (0.0 when even the strictest data threshold exceeds the budget).\n    auc/tpr_at_fpr are None when either class has no rows.\n    \"\"\"\n    scores = [(1.0 - float(r[\"coverage_confidence\"]), bool(r.get(\"null_ground_truth\")))\n              for r in rows if _is_number(r.get(\"coverage_confidence\"))]\n    n = len(scores)\n    pos = [s for s, is_null in scores if is_null]\n    neg = [s for s, is_null in scores if not is_null]\n    auc = tpr_at_fpr = None\n    if pos and neg:\n        wins = sum(1.0 if p > g else 0.5 if p == g else 0.0 for p in pos for g in neg)\n        auc = wins / (len(pos) * len(neg))\n        for thr in sorted({s for s, _ in scores}, reverse=True):\n            fpr = sum(1 for s, is_null in scores if not is_null and s >= thr) / len(neg)\n            if fpr <= fpr_target:\n                tpr_at_fpr = sum(1 for s, is_null in scores if is_null and s >= thr) / len(pos)\n                break\n        else:\n            tpr_at_fpr = 0.0\n    return {\"auc\": auc, \"tpr_at_fpr\": tpr_at_fpr, \"fpr_target\": fpr_target, \"n\": n}","oldString":"    null_truth = bool((assert_spec or {}).get(\"null_ground_truth\"))\n    tp = fp = tn = fn = 0\n    for r in rows:\n        cov = r.get(\"coverage_any_claimable\")\n        if not isinstance(cov, bool):\n            continue\n        if null_truth:\n            fp, tn = (fp + 1, tn) if cov else (fp, tn + 1)\n        else:\n            tp, fn = (tp + 1, fn) if cov else (tp, fn + 1)\n    tpr = tp / (tp + fn) if (tp + fn) else None\n    fpr = fp / (fp + tn) if (fp + tn) else None\n    return {\n        \"flip_rate\": flipped / len(eligible) if eligible else 0.0,\n        \"flip_trials\": flipped,\n        \"eligible_trials\": len(eligible),\n        \"all_order_accuracy\": all_order_accuracy,\n        \"n_runs\": n_runs,\n        \"per_order_accuracy\": per_order_accuracy,\n        \"null_matrix\": {\"tp\": tp, \"fp\": fp, \"tn\": tn, \"fn\": fn, \"tpr\": tpr, \"fpr\": fpr},\n    }","path":"sidecar/corpus_score.py"}}}
