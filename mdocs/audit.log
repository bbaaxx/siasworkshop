{"timestamp":"2026-10-16T21:29:26.195Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Tool catalog: descriptors, schema-subset validation, and model-facing renderers.\n\nImplements the descriptor format from mdocs/wiki/reference/mcp-pattern-tree-design.md\n(D4/D5). Wire names use underscores (MCP tool names must match ^[a-zA-Z0-9_-]{1,64}$);\ndotted ids remain the internal/catalog alias. Stdlib only.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass\n\nPOS_REF = \"#types/pos\"\n\n\n# --- schema subset -----------------------------------------------------------\n\ndef check_value(schema: dict, value) -> str | None:\n    \"\"\"Validate one value against the schema subset; returns an error string or None.\"\"\"\n    ref = schema.get(\"$ref\")\n    if ref is not None:\n        if ref == POS_REF:\n            if not (isinstance(value, dict)\n                    and all(isinstance(value.get(k), int) and not isinstance(value.get(k), bool)\n                            for k in (\"x\", \"y\", \"z\"))):\n                return \"expected pos {x,y,z} ints\"\n            return None\n        return f\"unknown $ref {ref}\"\n    t = schema.get(\"type\")\n    if t == \"string\" and not isinstance(value, str):\n        return \"expected string\"\n    if t == \"number\" and not (isinstance(value, (int, float)) and not isinstance(value, bool)):\n        return \"expected number\"\n    if t == \"integer\" and not (isinstance(value, int) and not isinstance(value, bool)):\n        return \"expected integer\"\n    if t == \"boolean\" and not isinstance(value, bool):\n        return \"expected boolean\"\n    if t == \"array\":\n        if not isinstance(value, list):\n            return \"expected array\"\n        for item in value:\n            err = check_value(schema.get(\"items\", {}), item)\n            if err:\n                return f\"array item: {err}\"\n    enum = schema.get(\"enum\")\n    if enum is not None and value not in enum:\n        return f\"expected one of {enum}\"\n    return None\n\n\ndef check_args(inputs: dict, args) -> str | None:\n    \"\"\"Validate a tool-call argument object against a descriptor's inputs; error or None.\"\"\"\n    if not isinstance(args, dict):\n        return \"args is not a JSON object\"\n    for req in inputs.get(\"required\", []):\n        if req not in args:\n            return f\"missing required arg '{req}'\"\n    props = inputs.get(\"properties\", {})\n    for key, val in args.items():\n        if key not in props:\n            return f\"unknown arg '{key}'\"\n        err = check_value(props[key], val)\n        if err:\n            return f\"arg '{key}': {err}\"\n    return None\n\n\ndef resolve(schema: dict) -> dict:\n    \"\"\"Inline #types/pos refs so the schema is a standalone JSON Schema (native tool rendering).\"\"\"\n    out = {}\n    for key, val in schema.items():\n        if key == \"$ref\" and val == POS_REF:\n            return {\"type\": \"object\",\n                    \"properties\": {k: {\"type\": \"integer\"} for k in (\"x\", \"y\", \"z\")},\n                    \"required\": [\"x\", \"y\", \"z\"],\n                    \"additionalProperties\": False}\n        if isinstance(val, dict):\n            out[key] = resolve(val)\n        else:\n            out[key] = val\n    return out\n\n\n# --- descriptors -------------------------------------------------------------\n\n@dataclass(frozen=True)\nclass Tool:\n    id: str                 # dotted internal id, e.g. \"observe.self\"\n    kind: str               # observe | pattern | effect\n    description: str\n    inputs: dict            # schema subset\n    args_hint: str = \"\"     # compact arg spelling for prompt rendering, e.g. \"task=<key>\"\n\n    @property\n    def wire(self) -> str:\n        return self.id.replace(\".\", \"_\")\n\n    @classmethod\n    def from_dict(cls, d: dict) -> \"Tool\":\n        return cls(id=d[\"id\"], kind=d[\"kind\"], description=d.get(\"description\", \"\"),\n                   inputs=d.get(\"inputs\", {\"type\": \"object\", \"properties\": {}}),\n                   args_hint=d.get(\"argsHint\", \"\"))\n\n\ndef catalog_name(wire_name: str) -> str:\n    return wire_name.replace(\"_\", \".\")\n\n\n# The S0 parity surface: the v1 three decision actions + two observation tools.\nS0_TOOLS: list[Tool] = [\n    Tool(id=\"observe.self\", kind=\"observe\",\n         description=\"Read-only: this agent's compact situation snapshot (self, players, nearby blocks/entities, environment).\",\n         inputs={\"type\": \"object\", \"properties\": {}}),\n    Tool(id=\"observe.board\", kind=\"observe\",\n         description=\"Read-only: the shared task board — open tasks with their exact claim keys.\",\n         inputs={\"type\": \"object\", \"properties\": {}}),\n    Tool(id=\"claim\", kind=\"effect\",\n         description=\"Start work on an OPEN TASK from the board. Once claimed, the agent's hands \"\n                     \"(walk, place, light, build) run automatically in the mod.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"task\": {\"type\": \"string\"}},\n                 \"required\": []},\n         args_hint=\"task=<exact key from the board> (optional; omitted = highest-priority open task)\"),\n    Tool(id=\"rest\", kind=\"effect\",\n         description=\"Deliberately idle this cycle.\",\n         inputs={\"type\": \"object\", \"properties\": {}}, args_hint=\"\"),\n    Tool(id=\"say\", kind=\"effect\",\n         description=\"Speak one short line to a player (shows up in their chat).\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"player\": {\"type\": \"string\"}, \"msg\": {\"type\": \"string\"}},\n                 \"required\": [\"player\", \"msg\"]},\n         args_hint=\"player=<name>, msg=<short text>\"),\n]\n\n\ndef by_wire(name: str) -> Tool | None:\n    for tool in S0_TOOLS:\n        if tool.wire == name:\n            return tool\n    return None\n\n\n# --- renderers ----------------------------------------------------------------\n\ndef render_native(tools: list[Tool] | None = None) -> list[dict]:\n    \"\"\"OpenAI/MCP-native tools array (function calling).\"\"\"\n    return [{\"type\": \"function\",\n             \"function\": {\"name\": t.wire,\n                          \"description\": t.description,\n                          \"parameters\": resolve(t.inputs)}}\n            for t in (tools or S0_TOOLS)]\n\n\ndef render_prompt(tools: list[Tool] | None = None) -> str:\n    \"\"\"Prompt-mode tool block: the catalog rendered as text with a constrained-JSON contract.\"\"\"\n    lines = [\"You control a Minecraft villager-agent through TOOLS. \"\n             \"Think briefly, then answer with exactly one JSON object: {\\\"tool\\\":\\\"<id>\\\",\\\"args\\\":{...}}. \"\n             \"No code fences, no prose.\"]\n    for t in (tools or S0_TOOLS):\n        hint = f\" args: {t.args_hint}\" if t.args_hint else \"\"\n        lines.append(f\"- {t.wire} — {t.description}{hint}\")\n    return \"\\n\".join(lines)\n\n\n# --- v1 prompt replica (A/B parity baseline) ----------------------------------\n\nV1_SYSTEM = (\"You pick ONE action for a Minecraft villager-agent. Think briefly, then answer with \"\n             \"one JSON object only: {\\\"action\\\":\\\"...\\\",\\\"args\\\":{...}}. No code fences, no prose.\")\n\n\ndef render_v1_user(observation: str, open_task_lines: list[str]) -> str:\n    \"\"\"Faithful replica of LlmPrompts.userPrompt with empty pool/build-cards (the S0 decision space).\"\"\"\n    sb = [\"SITUATION:\\n\" + observation, \"\\nOPEN TASKS:\"]\n    if not open_task_lines:\n        sb.append(' none — reply {\"action\":\"rest\",\"args\":{}}.')\n    else:\n        for line in open_task_lines:\n            sb.append(\"\\n- \" + line)\n    sb.append(\"\\n\\nDECISION — reply with exactly one JSON object:\")\n    sb.append('\\n- Start work on an OPEN TASK: {\"action\":\"claim\",\"args\":{\"task\":\"<key>\"}} (copy the key exactly)')\n    sb.append('\\n- Idle: {\"action\":\"rest\",\"args\":{}}')\n    sb.append('\\n- Speak to a player: {\"action\":\"say\",\"args\":{\"player\":\"<name>\",\"msg\":\"<short text>\"}}')\n    sb.append(\"\\nClaiming is the only way to act: once a task is claimed, the agent's hands\"\n              \" (walk, place, light, build) run automatically. Any other action is ignored.\")\n    return \"\".join(sb)\n\n\ndef first_json_object(text: str) -> dict | None:\n    \"\"\"First {...} span parsed (fence/prose tolerant); mirrors LlmActions.parseJsonObject.\"\"\"\n    if text is None:\n        return None\n    trimmed = text.strip()\n    if not trimmed:\n        return None\n    for candidate in (trimmed,):\n        try:\n            val = json.loads(candidate)\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            pass\n    start, end = trimmed.find(\"{\"), trimmed.rfind(\"}\")\n    if start >= 0 and end > start:\n        try:\n            val = json.loads(trimmed[start:end + 1])\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            return None\n    return None\n","path":"sidecar/catalog.py"}}}
{"timestamp":"2026-10-16T21:29:26.198Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Tool catalog: descriptors, schema-subset validation, and model-facing renderers.\n\nImplements the descriptor format from mdocs/wiki/reference/mcp-pattern-tree-design.md\n(D4/D5). Wire names use underscores (MCP tool names must match ^[a-zA-Z0-9_-]{1,64}$);\ndotted ids remain the internal/catalog alias. Stdlib only.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom dataclasses import dataclass\n\nPOS_REF = \"#types/pos\"\n\n\n# --- schema subset -----------------------------------------------------------\n\ndef check_value(schema: dict, value) -> str | None:\n    \"\"\"Validate one value against the schema subset; returns an error string or None.\"\"\"\n    ref = schema.get(\"$ref\")\n    if ref is not None:\n        if ref == POS_REF:\n            if not (isinstance(value, dict)\n                    and all(isinstance(value.get(k), int) and not isinstance(value.get(k), bool)\n                            for k in (\"x\", \"y\", \"z\"))):\n                return \"expected pos {x,y,z} ints\"\n            return None\n        return f\"unknown $ref {ref}\"\n    t = schema.get(\"type\")\n    if t == \"string\" and not isinstance(value, str):\n        return \"expected string\"\n    if t == \"number\" and not (isinstance(value, (int, float)) and not isinstance(value, bool)):\n        return \"expected number\"\n    if t == \"integer\" and not (isinstance(value, int) and not isinstance(value, bool)):\n        return \"expected integer\"\n    if t == \"boolean\" and not isinstance(value, bool):\n        return \"expected boolean\"\n    if t == \"array\":\n        if not isinstance(value, list):\n            return \"expected array\"\n        for item in value:\n            err = check_value(schema.get(\"items\", {}), item)\n            if err:\n                return f\"array item: {err}\"\n    enum = schema.get(\"enum\")\n    if enum is not None and value not in enum:\n        return f\"expected one of {enum}\"\n    return None\n\n\ndef check_args(inputs: dict, args) -> str | None:\n    \"\"\"Validate a tool-call argument object against a descriptor's inputs; error or None.\"\"\"\n    if not isinstance(args, dict):\n        return \"args is not a JSON object\"\n    for req in inputs.get(\"required\", []):\n        if req not in args:\n            return f\"missing required arg '{req}'\"\n    props = inputs.get(\"properties\", {})\n    for key, val in args.items():\n        if key not in props:\n            return f\"unknown arg '{key}'\"\n        err = check_value(props[key], val)\n        if err:\n            return f\"arg '{key}': {err}\"\n    return None\n\n\ndef resolve(schema: dict) -> dict:\n    \"\"\"Inline #types/pos refs so the schema is a standalone JSON Schema (native tool rendering).\"\"\"\n    out = {}\n    for key, val in schema.items():\n        if key == \"$ref\" and val == POS_REF:\n            return {\"type\": \"object\",\n                    \"properties\": {k: {\"type\": \"integer\"} for k in (\"x\", \"y\", \"z\")},\n                    \"required\": [\"x\", \"y\", \"z\"],\n                    \"additionalProperties\": False}\n        if isinstance(val, dict):\n            out[key] = resolve(val)\n        else:\n            out[key] = val\n    return out\n\n\n# --- descriptors -------------------------------------------------------------\n\n@dataclass(frozen=True)\nclass Tool:\n    id: str                 # dotted internal id, e.g. \"observe.self\"\n    kind: str               # observe | pattern | effect\n    description: str\n    inputs: dict            # schema subset\n    args_hint: str = \"\"     # compact arg spelling for prompt rendering, e.g. \"task=<key>\"\n\n    @property\n    def wire(self) -> str:\n        return self.id.replace(\".\", \"_\")\n\n    @classmethod\n    def from_dict(cls, d: dict) -> \"Tool\":\n        return cls(id=d[\"id\"], kind=d[\"kind\"], description=d.get(\"description\", \"\"),\n                   inputs=d.get(\"inputs\", {\"type\": \"object\", \"properties\": {}}),\n                   args_hint=d.get(\"argsHint\", \"\"))\n\n\ndef catalog_name(wire_name: str) -> str:\n    return wire_name.replace(\"_\", \".\")\n\n\n# The S0 parity surface: the v1 three decision actions + two observation tools.\nS0_TOOLS: list[Tool] = [\n    Tool(id=\"observe.self\", kind=\"observe\",\n         description=\"Read-only: this agent's compact situation snapshot (self, players, nearby blocks/entities, environment).\",\n         inputs={\"type\": \"object\", \"properties\": {}}),\n    Tool(id=\"observe.board\", kind=\"observe\",\n         description=\"Read-only: the shared task board — open tasks with their exact claim keys.\",\n         inputs={\"type\": \"object\", \"properties\": {}}),\n    Tool(id=\"claim\", kind=\"effect\",\n         description=\"Start work on an OPEN TASK from the board. Once claimed, the agent's hands \"\n                     \"(walk, place, light, build) run automatically in the mod.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"task\": {\"type\": \"string\"}},\n                 \"required\": []},\n         args_hint=\"task=<exact key from the board> (optional; omitted = highest-priority open task)\"),\n    Tool(id=\"rest\", kind=\"effect\",\n         description=\"Deliberately idle this cycle.\",\n         inputs={\"type\": \"object\", \"properties\": {}}, args_hint=\"\"),\n    Tool(id=\"say\", kind=\"effect\",\n         description=\"Speak one short line to a player (shows up in their chat).\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"player\": {\"type\": \"string\"}, \"msg\": {\"type\": \"string\"}},\n                 \"required\": [\"player\", \"msg\"]},\n         args_hint=\"player=<name>, msg=<short text>\"),\n]\n\n\ndef by_wire(name: str) -> Tool | None:\n    for tool in S0_TOOLS:\n        if tool.wire == name:\n            return tool\n    return None\n\n\n# --- renderers ----------------------------------------------------------------\n\ndef render_native(tools: list[Tool] | None = None) -> list[dict]:\n    \"\"\"OpenAI/MCP-native tools array (function calling).\"\"\"\n    return [{\"type\": \"function\",\n             \"function\": {\"name\": t.wire,\n                          \"description\": t.description,\n                          \"parameters\": resolve(t.inputs)}}\n            for t in (tools or S0_TOOLS)]\n\n\ndef render_prompt(tools: list[Tool] | None = None) -> str:\n    \"\"\"Prompt-mode tool block: the catalog rendered as text with a constrained-JSON contract.\"\"\"\n    lines = [\"You control a Minecraft villager-agent through TOOLS. \"\n             \"Think briefly, then answer with exactly one JSON object: {\\\"tool\\\":\\\"<id>\\\",\\\"args\\\":{...}}. \"\n             \"No code fences, no prose.\"]\n    for t in (tools or S0_TOOLS):\n        hint = f\" args: {t.args_hint}\" if t.args_hint else \"\"\n        lines.append(f\"- {t.wire} — {t.description}{hint}\")\n    return \"\\n\".join(lines)\n\n\n# --- v1 prompt replica (A/B parity baseline) ----------------------------------\n\nV1_SYSTEM = (\"You pick ONE action for a Minecraft villager-agent. Think briefly, then answer with \"\n             \"one JSON object only: {\\\"action\\\":\\\"...\\\",\\\"args\\\":{...}}. No code fences, no prose.\")\n\n\ndef render_v1_user(observation: str, open_task_lines: list[str]) -> str:\n    \"\"\"Faithful replica of LlmPrompts.userPrompt with empty pool/build-cards (the S0 decision space).\"\"\"\n    sb = [\"SITUATION:\\n\" + observation, \"\\nOPEN TASKS:\"]\n    if not open_task_lines:\n        sb.append(' none — reply {\"action\":\"rest\",\"args\":{}}.')\n    else:\n        for line in open_task_lines:\n            sb.append(\"\\n- \" + line)\n    sb.append(\"\\n\\nDECISION — reply with exactly one JSON object:\")\n    sb.append('\\n- Start work on an OPEN TASK: {\"action\":\"claim\",\"args\":{\"task\":\"<key>\"}} (copy the key exactly)')\n    sb.append('\\n- Idle: {\"action\":\"rest\",\"args\":{}}')\n    sb.append('\\n- Speak to a player: {\"action\":\"say\",\"args\":{\"player\":\"<name>\",\"msg\":\"<short text>\"}}')\n    sb.append(\"\\nClaiming is the only way to act: once a task is claimed, the agent's hands\"\n              \" (walk, place, light, build) run automatically. Any other action is ignored.\")\n    return \"\".join(sb)\n\n\ndef first_json_object(text: str) -> dict | None:\n    \"\"\"First {...} span parsed (fence/prose tolerant); mirrors LlmActions.parseJsonObject.\"\"\"\n    if text is None:\n        return None\n    trimmed = text.strip()\n    if not trimmed:\n        return None\n    for candidate in (trimmed,):\n        try:\n            val = json.loads(candidate)\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            pass\n    start, end = trimmed.find(\"{\"), trimmed.rfind(\"}\")\n    if start >= 0 and end > start:\n        try:\n            val = json.loads(trimmed[start:end + 1])\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            return None\n    return None\n","path":"sidecar/catalog.py"}}}
{"timestamp":"2026-10-16T21:29:51.919Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Model leg: minimal OpenAI-compatible chat client (stdlib urllib) + per-model profiles.\n\nFailure taxonomy mirrors LlmClient.LlmResult: every failure collapses into a machine-ish\nstring (http_<code>, timeout, connect_error...) so callers can count and fall back.\nNever sends response_format (LM Studio/llama.cpp rejects json_object — SEQ-011).\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport time\nimport urllib.error\nimport urllib.request\nfrom dataclasses import dataclass, field\n\n\n@dataclass\nclass ModelReply:\n    ok: bool\n    content: str | None = None                 # text content (prompt-mode answers)\n    tool_calls: list[dict] | None = None       # [{\"id\", \"name\", \"args\"}]\n    prompt_tokens: int | None = None\n    completion_tokens: int | None = None\n    latency_ms: int = 0\n    error: str | None = None                   # machine-ish failure reason\n\n\nclass OpenAiChat:\n    \"\"\"One-shot stateless chat client; a fresh instance per request is fine (no sessions).\"\"\"\n\n    def __init__(self, endpoint: str, api_key: str | None, timeout_seconds: int = 120):\n        # OpenRouter 404s double-slash paths (SEQ-014): strip trailing slashes.\n        self.endpoint = endpoint.rstrip(\"/\")\n        self.api_key = api_key\n        self.timeout = timeout_seconds\n\n    def chat(self, model: str, messages: list[dict], tools: list[dict] | None = None,\n             temperature: float = 0.3, max_tokens: int = 1024) -> ModelReply:\n        body = {\"model\": model, \"temperature\": temperature, \"max_tokens\": max_tokens,\n                \"messages\": messages}\n        if tools is not None:\n            body[\"tools\"] = tools\n            body[\"tool_choice\"] = \"auto\"\n        request = urllib.request.Request(\n            self.endpoint + \"/chat/completions\",\n            data=json.dumps(body).encode(),\n            headers={\"Content-Type\": \"application/json\"},\n            method=\"POST\")\n        if self.api_key:\n            request.add_header(\"Authorization\", \"Bearer \" + self.api_key)\n        started = time.monotonic()\n        try:\n            with urllib.request.urlopen(request, timeout=self.timeout) as response:\n                payload = json.loads(response.read().decode())\n        except urllib.error.HTTPError as e:\n            return ModelReply(ok=False, error=f\"http_{e.code}\",\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        except TimeoutError:\n            return ModelReply(ok=False, error=\"timeout\",\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        except urllib.error.URLError as e:\n            reason = e.reason.__class__.__name__ if hasattr(e.reason, \"__class__\") else \"url_error\"\n            return ModelReply(ok=False, error=f\"connect_{reason}\",\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        except (ValueError, OSError) as e:\n            return ModelReply(ok=False, error=e.__class__.__name__,\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        latency_ms = int((time.monotonic() - started) * 1000)\n        try:\n            choice = payload[\"choices\"][0]\n            message = choice[\"message\"]\n            usage = payload.get(\"usage\") or {}\n            tool_calls = None\n            for call in (message.get(\"tool_calls\") or []):\n                fn = call[\"function\"]\n                try:\n                    args = json.loads(fn.get(\"arguments\") or \"{}\")\n                except ValueError:\n                    return ModelReply(ok=False, error=f\"bad_tool_args:{fn.get('name')}\",\n                                      latency_ms=latency_ms)\n                tool_calls.append({\"id\": call.get(\"id\"), \"name\": fn[\"name\"], \"args\": args})\n            content = message.get(\"content\")\n            if tool_calls is None and (content is None or content == \"\"):\n                # e.g. reasoning model that burned the whole budget (finish_reason=length)\n                finish = choice.get(\"finish_reason\")\n                return ModelReply(ok=False, error=f\"empty_content:{finish}\",\n                                  prompt_tokens=usage.get(\"prompt_tokens\"),\n                                  completion_tokens=usage.get(\"completion_tokens\"),\n                                  latency_ms=latency_ms)\n            return ModelReply(ok=True, content=content, tool_calls=tool_calls,\n                              prompt_tokens=usage.get(\"prompt_tokens\"),\n                              completion_tokens=usage.get(\"completion_tokens\"),\n                              latency_ms=latency_ms)\n        except (KeyError, IndexError, TypeError) as e:\n            return ModelReply(ok=False, error=f\"missing_fields:{e.__class__.__name__}\",\n                              latency_ms=latency_ms)\n\n\n# --- per-model profiles (D8: model variance lives here) ------------------------\n\nPROFILES: dict[str, dict] = {\n    \"prism-ml/bonsai-27b\": {\n        \"mode\": \"prompt\",          # llama.cpp local: prompt-constrained JSON, not native tool calling\n        \"max_tokens\": 1024,        # reasoning burns 500-900 hidden tokens (SEQ-011)\n        \"temperature\": 0.3,\n        \"timeout_seconds\": 120,\n    },\n    \"~deepseek/deepseek-pro-latest\": {\n        \"mode\": \"native\",          # OpenRouter cloud: reliable tool calling, second-fast\n        \"max_tokens\": 1024,\n        \"temperature\": 0.3,\n        \"timeout_seconds\": 120,\n    },\n    \"default\": {\n        \"mode\": \"prompt\",\n        \"max_tokens\": 1024,\n        \"temperature\": 0.3,\n        \"timeout_seconds\": 120,\n    },\n}\n\n\ndef profile_for(model: str) -> dict:\n    if model in PROFILES:\n        return PROFILES[model]\n    for prefix, profile in PROFILES.items():\n        if prefix != \"default\" and model.startswith(prefix.rstrip(\"-latest\")):\n            return profile\n    return PROFILES[\"default\"]\n\n\nclass FakeModel:\n    \"\"\"Replay-mode model: serves scripted raw replies, no network. The gametest analog.\n\n    Each script entry: {\"name\", \"content\"? , \"tool_call\"?: {\"name\", \"arguments\"},\n                       \"modes\"?: [...], \"expect_tool\"?, \"expect_decision\"?, \"expect_exec\"?}\n    {{build_key}} / {{player}} placeholders are substituted from the scenario.\n    \"\"\"\n\n    def __init__(self, script: list[dict], scenario: dict):\n        self._script = [s for s in script]\n        self._scenario = scenario\n        self._cursor = 0\n        self.calls: list[dict] = []\n\n    def _fill(self, text: str) -> str:\n        build_key = next((t[\"key\"] for t in self._scenario.get(\"open_tasks\", [])\n                          if t.get(\"type\") == \"BUILD\"), \"\")\n        return (text.replace(\"{{build_key}}\", build_key)\n                    .replace(\"{{player}}\", self._scenario.get(\"player_name\", \"Dev\")))\n\n    def chat(self, model: str, messages: list[dict], tools: list[dict] | None = None,\n             temperature: float = 0.3, max_tokens: int = 1024) -> ModelReply:\n        self.calls.append({\"n_messages\": len(messages), \"has_tools\": tools is not None})\n        applicable = [s for s in self._script if not s.get(\"modes\") or model in s[\"modes\"]]\n        if self._cursor >= len(applicable):\n            entry = applicable[-1]\n        else:\n            entry = applicable[self._cursor]\n            self._cursor += 1\n        time.sleep(0.01)\n        if \"tool_call\" in entry:\n            call = entry[\"tool_call\"]\n            return ModelReply(ok=True, content=None, tool_calls=[{\n                \"id\": \"call_replay\", \"name\": call[\"name\"],\n                \"args\": json.loads(self._fill(json.dumps(call[\"arguments\"])))}],\n                prompt_tokens=100, completion_tokens=20, latency_ms=10)\n        return ModelReply(ok=True, content=self._fill(entry.get(\"content\", \"\")),\n                          prompt_tokens=100, completion_tokens=20, latency_ms=10)\n","path":"sidecar/model.py"}}}
{"timestamp":"2026-10-16T21:29:51.922Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Model leg: minimal OpenAI-compatible chat client (stdlib urllib) + per-model profiles.\n\nFailure taxonomy mirrors LlmClient.LlmResult: every failure collapses into a machine-ish\nstring (http_<code>, timeout, connect_error...) so callers can count and fall back.\nNever sends response_format (LM Studio/llama.cpp rejects json_object — SEQ-011).\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport time\nimport urllib.error\nimport urllib.request\nfrom dataclasses import dataclass, field\n\n\n@dataclass\nclass ModelReply:\n    ok: bool\n    content: str | None = None                 # text content (prompt-mode answers)\n    tool_calls: list[dict] | None = None       # [{\"id\", \"name\", \"args\"}]\n    prompt_tokens: int | None = None\n    completion_tokens: int | None = None\n    latency_ms: int = 0\n    error: str | None = None                   # machine-ish failure reason\n\n\nclass OpenAiChat:\n    \"\"\"One-shot stateless chat client; a fresh instance per request is fine (no sessions).\"\"\"\n\n    def __init__(self, endpoint: str, api_key: str | None, timeout_seconds: int = 120):\n        # OpenRouter 404s double-slash paths (SEQ-014): strip trailing slashes.\n        self.endpoint = endpoint.rstrip(\"/\")\n        self.api_key = api_key\n        self.timeout = timeout_seconds\n\n    def chat(self, model: str, messages: list[dict], tools: list[dict] | None = None,\n             temperature: float = 0.3, max_tokens: int = 1024) -> ModelReply:\n        body = {\"model\": model, \"temperature\": temperature, \"max_tokens\": max_tokens,\n                \"messages\": messages}\n        if tools is not None:\n            body[\"tools\"] = tools\n            body[\"tool_choice\"] = \"auto\"\n        request = urllib.request.Request(\n            self.endpoint + \"/chat/completions\",\n            data=json.dumps(body).encode(),\n            headers={\"Content-Type\": \"application/json\"},\n            method=\"POST\")\n        if self.api_key:\n            request.add_header(\"Authorization\", \"Bearer \" + self.api_key)\n        started = time.monotonic()\n        try:\n            with urllib.request.urlopen(request, timeout=self.timeout) as response:\n                payload = json.loads(response.read().decode())\n        except urllib.error.HTTPError as e:\n            return ModelReply(ok=False, error=f\"http_{e.code}\",\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        except TimeoutError:\n            return ModelReply(ok=False, error=\"timeout\",\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        except urllib.error.URLError as e:\n            reason = e.reason.__class__.__name__ if hasattr(e.reason, \"__class__\") else \"url_error\"\n            return ModelReply(ok=False, error=f\"connect_{reason}\",\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        except (ValueError, OSError) as e:\n            return ModelReply(ok=False, error=e.__class__.__name__,\n                              latency_ms=int((time.monotonic() - started) * 1000))\n        latency_ms = int((time.monotonic() - started) * 1000)\n        try:\n            choice = payload[\"choices\"][0]\n            message = choice[\"message\"]\n            usage = payload.get(\"usage\") or {}\n            tool_calls = None\n            for call in (message.get(\"tool_calls\") or []):\n                fn = call[\"function\"]\n                try:\n                    args = json.loads(fn.get(\"arguments\") or \"{}\")\n                except ValueError:\n                    return ModelReply(ok=False, error=f\"bad_tool_args:{fn.get('name')}\",\n                                      latency_ms=latency_ms)\n                tool_calls.append({\"id\": call.get(\"id\"), \"name\": fn[\"name\"], \"args\": args})\n            content = message.get(\"content\")\n            if tool_calls is None and (content is None or content == \"\"):\n                # e.g. reasoning model that burned the whole budget (finish_reason=length)\n                finish = choice.get(\"finish_reason\")\n                return ModelReply(ok=False, error=f\"empty_content:{finish}\",\n                                  prompt_tokens=usage.get(\"prompt_tokens\"),\n                                  completion_tokens=usage.get(\"completion_tokens\"),\n                                  latency_ms=latency_ms)\n            return ModelReply(ok=True, content=content, tool_calls=tool_calls,\n                              prompt_tokens=usage.get(\"prompt_tokens\"),\n                              completion_tokens=usage.get(\"completion_tokens\"),\n                              latency_ms=latency_ms)\n        except (KeyError, IndexError, TypeError) as e:\n            return ModelReply(ok=False, error=f\"missing_fields:{e.__class__.__name__}\",\n                              latency_ms=latency_ms)\n\n\n# --- per-model profiles (D8: model variance lives here) ------------------------\n\nPROFILES: dict[str, dict] = {\n    \"prism-ml/bonsai-27b\": {\n        \"mode\": \"prompt\",          # llama.cpp local: prompt-constrained JSON, not native tool calling\n        \"max_tokens\": 1024,        # reasoning burns 500-900 hidden tokens (SEQ-011)\n        \"temperature\": 0.3,\n        \"timeout_seconds\": 120,\n    },\n    \"~deepseek/deepseek-pro-latest\": {\n        \"mode\": \"native\",          # OpenRouter cloud: reliable tool calling, second-fast\n        \"max_tokens\": 1024,\n        \"temperature\": 0.3,\n        \"timeout_seconds\": 120,\n    },\n    \"default\": {\n        \"mode\": \"prompt\",\n        \"max_tokens\": 1024,\n        \"temperature\": 0.3,\n        \"timeout_seconds\": 120,\n    },\n}\n\n\ndef profile_for(model: str) -> dict:\n    if model in PROFILES:\n        return PROFILES[model]\n    for prefix, profile in PROFILES.items():\n        if prefix != \"default\" and model.startswith(prefix.rstrip(\"-latest\")):\n            return profile\n    return PROFILES[\"default\"]\n\n\nclass FakeModel:\n    \"\"\"Replay-mode model: serves scripted raw replies, no network. The gametest analog.\n\n    Each script entry: {\"name\", \"content\"? , \"tool_call\"?: {\"name\", \"arguments\"},\n                       \"modes\"?: [...], \"expect_tool\"?, \"expect_decision\"?, \"expect_exec\"?}\n    {{build_key}} / {{player}} placeholders are substituted from the scenario.\n    \"\"\"\n\n    def __init__(self, script: list[dict], scenario: dict):\n        self._script = [s for s in script]\n        self._scenario = scenario\n        self._cursor = 0\n        self.calls: list[dict] = []\n\n    def _fill(self, text: str) -> str:\n        build_key = next((t[\"key\"] for t in self._scenario.get(\"open_tasks\", [])\n                          if t.get(\"type\") == \"BUILD\"), \"\")\n        return (text.replace(\"{{build_key}}\", build_key)\n                    .replace(\"{{player}}\", self._scenario.get(\"player_name\", \"Dev\")))\n\n    def chat(self, model: str, messages: list[dict], tools: list[dict] | None = None,\n             temperature: float = 0.3, max_tokens: int = 1024) -> ModelReply:\n        self.calls.append({\"n_messages\": len(messages), \"has_tools\": tools is not None})\n        applicable = [s for s in self._script if not s.get(\"modes\") or model in s[\"modes\"]]\n        if self._cursor >= len(applicable):\n            entry = applicable[-1]\n        else:\n            entry = applicable[self._cursor]\n            self._cursor += 1\n        time.sleep(0.01)\n        if \"tool_call\" in entry:\n            call = entry[\"tool_call\"]\n            return ModelReply(ok=True, content=None, tool_calls=[{\n                \"id\": \"call_replay\", \"name\": call[\"name\"],\n                \"args\": json.loads(self._fill(json.dumps(call[\"arguments\"])))}],\n                prompt_tokens=100, completion_tokens=20, latency_ms=10)\n        return ModelReply(ok=True, content=self._fill(entry.get(\"content\", \"\")),\n                          prompt_tokens=100, completion_tokens=20, latency_ms=10)\n","path":"sidecar/model.py"}}}
{"timestamp":"2026-10-16T21:30:13.161Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"MCP-over-stdio client (sidecar role, D2).\n\nFraming: newline-delimited JSON-RPC, exactly as the mod will implement it on the Java side.\nThe client writes requests to the peer's stdin and reads responses from the peer's stdout.\nIn production the mod spawns the sidecar and these are the sidecar's own pipes, reversed;\nhere the spike spawns the mock mod and drives the same wire from the parent.\n\"\"\"\nfrom __future__ import annotations\n\nimport itertools\nimport json\nimport select\nimport subprocess\nimport sys\n\n\nclass JsonRpcPipe:\n    def __init__(self, reader, writer):\n        self._reader = reader          # binary readable (peer's stdout)\n        self._writer = writer          # binary writable (peer's stdin)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str | None, params: dict | None = None,\n             is_notification: bool = False) -> int | None:\n        msg = {\"jsonrpc\": \"2.0\"}\n        msg_id = None\n        if not is_notification:\n            msg_id = next(self._ids)\n            msg[\"id\"] = msg_id\n        if method is not None:\n            msg[\"method\"] = method\n        if params is not None:\n            msg[\"params\"] = params\n        self._writer.write(json.dumps(msg).encode() + b\"\\n\")\n        self._writer.flush()\n        return msg_id\n\n    def recv(self, timeout_s: float | None = None) -> dict | None:\n        \"\"\"Next JSON-RPC message, or None on timeout/EOF. Server->client traffic only here.\"\"\"\n        ready, _, _ = select.select([self._reader], [], [], timeout_s)\n        if not ready:\n            return None\n        line = self._reader.readline()\n        if not line:\n            return None\n        line = line.strip()\n        if not line:\n            return {}\n        try:\n            return json.loads(line.decode())\n        except ValueError:\n            return {}\n\n\nPROTOCOL_VERSION = \"2025-06-18\"\n\n\nclass McpClient:\n    \"\"\"Minimal MCP client: initialize handshake, tools/list, tools/call.\"\"\"\n\n    def __init__(self, proc: subprocess.Popen):\n        self._proc = proc\n        self._pipe = JsonRpcPipe(proc.stdout, proc.stdin)\n\n    def start(self) -> dict:\n        self._pipe.send(\"initialize\", {\n            \"protocolVersion\": PROTOCOL_VERSION,\n            \"capabilities\": {},\n            \"clientInfo\": {\"name\": \"siasworkshop-sidecar-s0\", \"version\": \"0.1.0\"},\n        })\n        while True:\n            msg = self._pipe.recv(timeout_s=30)\n            if msg is None:\n                raise RuntimeError(\"mock mod did not answer initialize (EOF/timeout)\")\n            if msg.get(\"id\") == 1 and \"result\" in msg:\n                result = msg[\"result\"]\n                break\n            if \"error\" in msg:\n                raise RuntimeError(f\"initialize rejected: {msg['error']}\")\n        self._pipe.send(\"notifications/initialized\", is_notification=True)\n        return result\n\n    def list_tools(self) -> list[dict]:\n        msg_id = self._pipe.send(\"tools/list\")\n        reply = self._wait_result(msg_id)\n        return reply[\"result\"][\"tools\"]\n\n    def call(self, name: str, args: dict, timeout_s: float = 30) -> dict:\n        \"\"\"tools/call; returns {\"ok\": bool, \"content\": parsed-or-text, \"is_error\": bool}.\"\"\"\n        msg_id = self._pipe.send(\"tools/call\", {\"name\": name, \"arguments\": args})\n        reply = self._wait_result(msg_id, timeout_s)\n        result = reply[\"result\"]\n        content = result.get(\"content\") or []\n        text = \"\\n\".join(c.get(\"text\", \"\") for c in content if c.get(\"type\") == \"text\")\n        parsed = None\n        try:\n            parsed = json.loads(text) if text.strip() else None\n        except ValueError:\n            parsed = None\n        return {\"ok\": not result.get(\"isError\", False), \"content\": parsed if parsed is not None else text,\n                \"is_error\": result.get(\"isError\", False), \"raw\": text}\n\n    def _wait_result(self, msg_id: int, timeout_s: float = 30) -> dict:\n        while True:\n            msg = self._pipe.recv(timeout_s=timeout_s)\n            if msg is None:\n                raise RuntimeError(f\"no reply to request {msg_id} (EOF/timeout)\")\n            if msg.get(\"method\"):          # notification (e.g. tools/list_changed): ignore\n                continue\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"request {msg_id} failed: {msg['error']}\")\n                return msg\n\n    def close(self):\n        try:\n            if self._proc.stdin:\n                self._proc.stdin.close()\n        except BrokenPipeError:\n            pass\n        try:\n            self._proc.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            self._proc.kill()\n\n\ndef spawn_mock(scenario_path: str, python: str = sys.executable) -> McpClient:\n    import os.path\n    mock = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"mockmod.py\")\n    proc = subprocess.Popen([python, mock, scenario_path],\n                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=None)\n    return McpClient(proc)\n","path":"sidecar/mcp.py"}}}
{"timestamp":"2026-10-16T21:30:13.165Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"MCP-over-stdio client (sidecar role, D2).\n\nFraming: newline-delimited JSON-RPC, exactly as the mod will implement it on the Java side.\nThe client writes requests to the peer's stdin and reads responses from the peer's stdout.\nIn production the mod spawns the sidecar and these are the sidecar's own pipes, reversed;\nhere the spike spawns the mock mod and drives the same wire from the parent.\n\"\"\"\nfrom __future__ import annotations\n\nimport itertools\nimport json\nimport select\nimport subprocess\nimport sys\n\n\nclass JsonRpcPipe:\n    def __init__(self, reader, writer):\n        self._reader = reader          # binary readable (peer's stdout)\n        self._writer = writer          # binary writable (peer's stdin)\n        self._ids = itertools.count(1)\n\n    def send(self, method: str | None, params: dict | None = None,\n             is_notification: bool = False) -> int | None:\n        msg = {\"jsonrpc\": \"2.0\"}\n        msg_id = None\n        if not is_notification:\n            msg_id = next(self._ids)\n            msg[\"id\"] = msg_id\n        if method is not None:\n            msg[\"method\"] = method\n        if params is not None:\n            msg[\"params\"] = params\n        self._writer.write(json.dumps(msg).encode() + b\"\\n\")\n        self._writer.flush()\n        return msg_id\n\n    def recv(self, timeout_s: float | None = None) -> dict | None:\n        \"\"\"Next JSON-RPC message, or None on timeout/EOF. Server->client traffic only here.\"\"\"\n        ready, _, _ = select.select([self._reader], [], [], timeout_s)\n        if not ready:\n            return None\n        line = self._reader.readline()\n        if not line:\n            return None\n        line = line.strip()\n        if not line:\n            return {}\n        try:\n            return json.loads(line.decode())\n        except ValueError:\n            return {}\n\n\nPROTOCOL_VERSION = \"2025-06-18\"\n\n\nclass McpClient:\n    \"\"\"Minimal MCP client: initialize handshake, tools/list, tools/call.\"\"\"\n\n    def __init__(self, proc: subprocess.Popen):\n        self._proc = proc\n        self._pipe = JsonRpcPipe(proc.stdout, proc.stdin)\n\n    def start(self) -> dict:\n        self._pipe.send(\"initialize\", {\n            \"protocolVersion\": PROTOCOL_VERSION,\n            \"capabilities\": {},\n            \"clientInfo\": {\"name\": \"siasworkshop-sidecar-s0\", \"version\": \"0.1.0\"},\n        })\n        while True:\n            msg = self._pipe.recv(timeout_s=30)\n            if msg is None:\n                raise RuntimeError(\"mock mod did not answer initialize (EOF/timeout)\")\n            if msg.get(\"id\") == 1 and \"result\" in msg:\n                result = msg[\"result\"]\n                break\n            if \"error\" in msg:\n                raise RuntimeError(f\"initialize rejected: {msg['error']}\")\n        self._pipe.send(\"notifications/initialized\", is_notification=True)\n        return result\n\n    def list_tools(self) -> list[dict]:\n        msg_id = self._pipe.send(\"tools/list\")\n        reply = self._wait_result(msg_id)\n        return reply[\"result\"][\"tools\"]\n\n    def call(self, name: str, args: dict, timeout_s: float = 30) -> dict:\n        \"\"\"tools/call; returns {\"ok\": bool, \"content\": parsed-or-text, \"is_error\": bool}.\"\"\"\n        msg_id = self._pipe.send(\"tools/call\", {\"name\": name, \"arguments\": args})\n        reply = self._wait_result(msg_id, timeout_s)\n        result = reply[\"result\"]\n        content = result.get(\"content\") or []\n        text = \"\\n\".join(c.get(\"text\", \"\") for c in content if c.get(\"type\") == \"text\")\n        parsed = None\n        try:\n            parsed = json.loads(text) if text.strip() else None\n        except ValueError:\n            parsed = None\n        return {\"ok\": not result.get(\"isError\", False), \"content\": parsed if parsed is not None else text,\n                \"is_error\": result.get(\"isError\", False), \"raw\": text}\n\n    def _wait_result(self, msg_id: int, timeout_s: float = 30) -> dict:\n        while True:\n            msg = self._pipe.recv(timeout_s=timeout_s)\n            if msg is None:\n                raise RuntimeError(f\"no reply to request {msg_id} (EOF/timeout)\")\n            if msg.get(\"method\"):          # notification (e.g. tools/list_changed): ignore\n                continue\n            if msg.get(\"id\") == msg_id:\n                if \"error\" in msg:\n                    raise RuntimeError(f\"request {msg_id} failed: {msg['error']}\")\n                return msg\n\n    def close(self):\n        try:\n            if self._proc.stdin:\n                self._proc.stdin.close()\n        except BrokenPipeError:\n            pass\n        try:\n            self._proc.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            self._proc.kill()\n\n\ndef spawn_mock(scenario_path: str, python: str = sys.executable) -> McpClient:\n    import os.path\n    mock = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"mockmod.py\")\n    proc = subprocess.Popen([python, mock, scenario_path],\n                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=None)\n    return McpClient(proc)\n","path":"sidecar/mcp.py"}}}
{"timestamp":"2026-10-16T21:30:30.093Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Mock mod: plays the mod's MCP-server role for the S0 spike (D1/D2).\n\nSpeaks newline-delimited JSON-RPC on stdin/stdout (stdout is pure protocol — logs go to\nstderr). Owns a small scripted world (scenario JSON): observation text + open tasks.\nMirrors the mod's safety boundary (D7): unknown tools and bad args are rejected with a\nstructured error the model side can read and recover from.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\n\nfrom catalog import S0_TOOLS, by_wire, check_args\n\n\nclass MockWorld:\n    def __init__(self, scenario: dict):\n        self.scenario = scenario\n        self.claimed: dict[str, str] = {}   # key -> claimant\n        self.said: list[dict] = []\n\n    def open_tasks(self) -> list[dict]:\n        return [t for t in self.scenario.get(\"open_tasks\", [])\n                if t[\"key\"] not in self.claimed and t.get(\"claimable\", True)]\n\n\ndef tool_descriptor(t) -> dict:\n    from catalog import resolve\n    return {\"name\": t.wire, \"description\": t.description, \"inputSchema\": resolve(t.inputs)}\n\n\ndef handle_call(world: MockWorld, name: str, args: dict) -> dict:\n    tool = by_wire(name)\n    if tool is None:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"unknown tool '{name}'\"})}]}\n    err = check_args(tool.inputs, args)\n    if err:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"bad args for {name}: {err}\"})}]}\n    if name == \"observe_self\":\n        result = {\"observation\": world.scenario.get(\"observation\", \"\")}\n    elif name == \"observe_board\":\n        open_tasks = world.open_tasks()\n        result = {\"open_tasks\": [f\"{t['key']} — {t.get('detail', '')}\" for t in open_tasks]} \\\n            if open_tasks else {\"open_tasks\": []}\n    elif name == \"claim\":\n        wanted = args.get(\"task\")\n        open_tasks = world.open_tasks()\n        target = None\n        if wanted:\n            target = next((t for t in open_tasks if t[\"key\"] == wanted), None)\n            if target is None:\n                return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": json.dumps(\n                    {\"reject\": f\"unknown or claimed task key '{wanted}'\",\n                     \"open\": [t[\"key\"] for t in open_tasks]})}]}\n        elif open_tasks:\n            target = open_tasks[0]  # mock priority: board order\n        if target is None:\n            return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": \"no open tasks to claim\"})}]}\n        world.claimed[target[\"key\"]] = \"agent-1\"\n        result = {\"claimed\": target[\"key\"]}\n    elif name == \"rest\":\n        result = {\"resting\": True}\n    elif name == \"say\":\n        world.said.append({\"player\": args[\"player\"], \"msg\": args[\"msg\"]})\n        result = {\"said\": {\"player\": args[\"player\"], \"msg\": args[\"msg\"]}}\n    else:  # pragma: no cover - by_wire covers the S0 set\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"tool '{name}' not implemented by mock\"})}]}\n    return {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\": json.dumps(result)}]}\n\n\ndef serve(scenario_path: str) -> None:\n    with open(scenario_path, encoding=\"utf-8\") as fh:\n        scenario = json.load(fh)\n    world = MockWorld(scenario)\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            msg = json.loads(line)\n        except ValueError:\n            continue\n        method, msg_id = msg.get(\"method\"), msg.get(\"id\")\n        if method == \"initialize\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\n                \"protocolVersion\": msg.get(\"params\", {}).get(\"protocolVersion\", \"2025-06-18\"),\n                \"capabilities\": {\"tools\": {}},\n                \"serverInfo\": {\"name\": \"siasworkshop-mockmod\", \"version\": \"0.1.0\"}}}\n        elif method == \"notifications/initialized\":\n            continue\n        elif method == \"tools/list\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"result\": {\"tools\": [tool_descriptor(t) for t in S0_TOOLS]}}\n        elif method == \"tools/call\":\n            params = msg.get(\"params\", {})\n            result = handle_call(world, params.get(\"name\", \"\"), params.get(\"arguments\") or {})\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": result}\n        else:\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"error\": {\"code\": -32601, \"message\": f\"method not found: {method}\"}}\n        sys.stdout.write(json.dumps(reply) + \"\\n\")\n        sys.stdout.flush()\n        if method == \"tools/call\" and world.said:\n            sys.stderr.write(f\"[mockmod] say: {world.said[-1]}\\n\")\n            sys.stderr.flush()\n\n\nif __name__ == \"__main__\":\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"usage: mockmod.py <scenario.json>\\n\")\n        sys.exit(2)\n    serve(sys.argv[1])\n","path":"sidecar/mockmod.py"}}}
{"timestamp":"2026-10-16T21:30:30.098Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Mock mod: plays the mod's MCP-server role for the S0 spike (D1/D2).\n\nSpeaks newline-delimited JSON-RPC on stdin/stdout (stdout is pure protocol — logs go to\nstderr). Owns a small scripted world (scenario JSON): observation text + open tasks.\nMirrors the mod's safety boundary (D7): unknown tools and bad args are rejected with a\nstructured error the model side can read and recover from.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\n\nfrom catalog import S0_TOOLS, by_wire, check_args\n\n\nclass MockWorld:\n    def __init__(self, scenario: dict):\n        self.scenario = scenario\n        self.claimed: dict[str, str] = {}   # key -> claimant\n        self.said: list[dict] = []\n\n    def open_tasks(self) -> list[dict]:\n        return [t for t in self.scenario.get(\"open_tasks\", [])\n                if t[\"key\"] not in self.claimed and t.get(\"claimable\", True)]\n\n\ndef tool_descriptor(t) -> dict:\n    from catalog import resolve\n    return {\"name\": t.wire, \"description\": t.description, \"inputSchema\": resolve(t.inputs)}\n\n\ndef handle_call(world: MockWorld, name: str, args: dict) -> dict:\n    tool = by_wire(name)\n    if tool is None:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"unknown tool '{name}'\"})}]}\n    err = check_args(tool.inputs, args)\n    if err:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"bad args for {name}: {err}\"})}]}\n    if name == \"observe_self\":\n        result = {\"observation\": world.scenario.get(\"observation\", \"\")}\n    elif name == \"observe_board\":\n        open_tasks = world.open_tasks()\n        result = {\"open_tasks\": [f\"{t['key']} — {t.get('detail', '')}\" for t in open_tasks]} \\\n            if open_tasks else {\"open_tasks\": []}\n    elif name == \"claim\":\n        wanted = args.get(\"task\")\n        open_tasks = world.open_tasks()\n        target = None\n        if wanted:\n            target = next((t for t in open_tasks if t[\"key\"] == wanted), None)\n            if target is None:\n                return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": json.dumps(\n                    {\"reject\": f\"unknown or claimed task key '{wanted}'\",\n                     \"open\": [t[\"key\"] for t in open_tasks]})}]}\n        elif open_tasks:\n            target = open_tasks[0]  # mock priority: board order\n        if target is None:\n            return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": \"no open tasks to claim\"})}]}\n        world.claimed[target[\"key\"]] = \"agent-1\"\n        result = {\"claimed\": target[\"key\"]}\n    elif name == \"rest\":\n        result = {\"resting\": True}\n    elif name == \"say\":\n        world.said.append({\"player\": args[\"player\"], \"msg\": args[\"msg\"]})\n        result = {\"said\": {\"player\": args[\"player\"], \"msg\": args[\"msg\"]}}\n    else:  # pragma: no cover - by_wire covers the S0 set\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"tool '{name}' not implemented by mock\"})}]}\n    return {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\": json.dumps(result)}]}\n\n\ndef serve(scenario_path: str) -> None:\n    with open(scenario_path, encoding=\"utf-8\") as fh:\n        scenario = json.load(fh)\n    world = MockWorld(scenario)\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            msg = json.loads(line)\n        except ValueError:\n            continue\n        method, msg_id = msg.get(\"method\"), msg.get(\"id\")\n        if method == \"initialize\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\n                \"protocolVersion\": msg.get(\"params\", {}).get(\"protocolVersion\", \"2025-06-18\"),\n                \"capabilities\": {\"tools\": {}},\n                \"serverInfo\": {\"name\": \"siasworkshop-mockmod\", \"version\": \"0.1.0\"}}}\n        elif method == \"notifications/initialized\":\n            continue\n        elif method == \"tools/list\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"result\": {\"tools\": [tool_descriptor(t) for t in S0_TOOLS]}}\n        elif method == \"tools/call\":\n            params = msg.get(\"params\", {})\n            result = handle_call(world, params.get(\"name\", \"\"), params.get(\"arguments\") or {})\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": result}\n        else:\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"error\": {\"code\": -32601, \"message\": f\"method not found: {method}\"}}\n        sys.stdout.write(json.dumps(reply) + \"\\n\")\n        sys.stdout.flush()\n        if method == \"tools/call\" and world.said:\n            sys.stderr.write(f\"[mockmod] say: {world.said[-1]}\\n\")\n            sys.stderr.flush()\n\n\nif __name__ == \"__main__\":\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"usage: mockmod.py <scenario.json>\\n\")\n        sys.exit(2)\n    serve(sys.argv[1])\n","path":"sidecar/mockmod.py"}}}
{"timestamp":"2026-10-16T21:30:50.969Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Decision session driver (S0): one decision through the mock mod, in one of three modes.\n\n- v1         : LlmPrompts replica, {\"action\",\"args\"} contract, no tool catalog (baseline)\n- mcp-prompt : catalog rendered into the prompt, {\"tool\",\"args\"} contract (local-model path)\n- mcp-native : catalog sent as native function-calling tools (cloud-model path)\n\nAll modes observe through the same MCP pipe, validate against the same catalog, and\nexecute through the same tools/call boundary — so measured differences attribute to the\nmodel-facing surface, not the plumbing.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport time\nfrom dataclasses import dataclass, field, asdict\n\nimport catalog\nfrom catalog import by_wire, check_args, first_json_object, render_native, render_prompt, render_v1_user, V1_SYSTEM\nfrom mcp import McpClient\n\n\n@dataclass\nclass Decision:\n    mode: str\n    tool: str | None = None\n    args: dict | None = None\n    decision_outcome: str = \"ok\"       # ok | malformed_json | unknown_tool | bad_args | model_error:<x>\n    exec_outcome: str | None = None    # exec_ok | exec_reject:<reason> | None (not executed)\n    model_error: str | None = None\n    model_latency_ms: int = 0\n    total_latency_ms: int = 0\n    prompt_tokens: int | None = None\n    completion_tokens: int | None = None\n    raw_preview: str | None = None\n\n    def to_row(self, model: str, scenario: str, iteration: int) -> dict:\n        row = asdict(self)\n        row.update({\"model\": model, \"scenario\": scenario, \"iteration\": iteration})\n        return row\n\n\ndef _preview(text: str | None, limit: int = 200) -> str | None:\n    if text is None:\n        return None\n    flat = \" \".join(text.split())\n    return flat if len(flat) <= limit else flat[:limit] + \"...\"\n\n\ndef _board_lines(board: dict) -> list[str]:\n    return list(board.get(\"content\", {}).get(\"open_tasks\") or [])\n\n\ndef run_decision(mode: str, model, model_tag: str, client: McpClient,\n                 profile: dict) -> Decision:\n    started = time.monotonic()\n    obs = client.call(\"observe_self\")\n    board = client.call(\"observe_board\")\n    observation = obs[\"content\"].get(\"observation\", \"\") if obs[\"ok\"] else \"\"\n    open_lines = _board_lines(board)\n    open_keys = [line.split(\" — \")[0] for line in open_lines]\n\n    temperature = profile.get(\"temperature\", 0.3)\n    max_tokens = profile.get(\"max_tokens\", 1024)\n    decision = Decision(mode=mode)\n\n    if mode == \"v1\":\n        messages = [\n            {\"role\": \"system\", \"content\": V1_SYSTEM},\n            {\"role\": \"user\", \"content\": render_v1_user(observation, open_lines)},\n        ]\n        reply = model.chat(model_tag, messages, temperature=temperature, max_tokens=max_tokens)\n        decision.model_latency_ms = reply.latency_ms\n        decision.prompt_tokens, decision.completion_tokens = reply.prompt_tokens, reply.completion_tokens\n        if not reply.ok:\n            decision.decision_outcome = \"model_error:\" + (reply.error or \"unknown\")\n            decision.raw_preview = _preview(getattr(reply, \"content\", None))\n            return _finish(decision, started)\n        candidate = first_json_object(reply.content or \"\")\n        decision.raw_preview = _preview(reply.content)\n        if candidate is None:\n            decision.decision_outcome = \"malformed_json\"\n            return _finish(decision, started)\n        action = candidate.get(\"action\")\n        args = candidate.get(\"args\") if isinstance(candidate.get(\"args\"), dict) else {}\n        if not isinstance(action, str):\n            decision.decision_outcome = \"malformed_json\"\n            return _finish(decision, started)\n        decision.tool, decision.args = action, args\n\n    elif mode == \"mcp-prompt\":\n        messages = [\n            {\"role\": \"system\", \"content\": render_prompt()},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")\n             + '\\n\\nDecide: reply with exactly one JSON object {\"tool\":\"<id>\",\"args\":{...}}.'},\n        ]\n        reply = model.chat(model_tag, messages, temperature=temperature, max_tokens=max_tokens)\n        decision.model_latency_ms = reply.latency_ms\n        decision.prompt_tokens, decision.completion_tokens = reply.prompt_tokens, reply.completion_tokens\n        if not reply.ok:\n            decision.decision_outcome = \"model_error:\" + (reply.error or \"unknown\")\n            return _finish(decision, started)\n        candidate = first_json_object(reply.content or \"\")\n        decision.raw_preview = _preview(reply.content)\n        if candidate is None or not isinstance(candidate.get(\"tool\"), str):\n            decision.decision_outcome = \"malformed_json\"\n            return _finish(decision, started)\n        decision.tool = candidate[\"tool\"]\n        decision.args = candidate.get(\"args\") if isinstance(candidate.get(\"args\"), dict) else {}\n\n    elif mode == \"mcp-native\":\n        messages = [\n            {\"role\": \"system\", \"content\":\n                \"You control a Minecraft villager-agent. Observe the situation, then call exactly \"\n                \"one tool to decide: claim a task, rest, or say something.\"},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")},\n        ]\n        reply = model.chat(model_tag, messages, tools=render_native(),\n                           temperature=temperature, max_tokens=max_tokens)\n        decision.model_latency_ms = reply.latency_ms\n        decision.prompt_tokens, decision.completion_tokens = reply.prompt_tokens, reply.completion_tokens\n        if not reply.ok:\n            decision.decision_outcome = \"model_error:\" + (reply.error or \"unknown\")\n            return _finish(decision, started)\n        if not reply.tool_calls:\n            decision.decision_outcome = \"malformed_json\"\n            decision.raw_preview = _preview(reply.content)\n            return _finish(decision, started)\n        call = reply.tool_calls[0]\n        decision.tool, decision.args = call[\"name\"], call[\"args\"]\n\n    else:\n        decision.decision_outcome = \"model_error:unknown_mode:\" + mode\n        return _finish(decision, started)\n\n    # --- catalog validation (the D7 boundary, same for every mode) -------------\n    tool = by_wire(decision.tool) if decision.tool else None\n    if tool is None:\n        decision.decision_outcome = \"unknown_tool\"\n        return _finish(decision, started)\n    arg_err = check_args(tool.inputs, decision.args if decision.args is not None else {})\n    if arg_err:\n        decision.decision_outcome = \"bad_args\"\n        decision.model_error = arg_err\n        return _finish(decision, started)\n\n    # --- execute through the mod boundary ---------------------------------------\n    result = client.call(tool.wire, decision.args or {})\n    if result[\"ok\"]:\n        decision.exec_outcome = \"exec_ok\"\n    else:\n        reject = result[\"content\"].get(\"reject\") if isinstance(result[\"content\"], dict) else str(result[\"content\"])\n        decision.exec_outcome = \"exec_reject:\" + str(reject)\n    return _finish(decision, started)\n\n\ndef _finish(decision: Decision, started: float) -> Decision:\n    decision.total_latency_ms = int((time.monotonic() - started) * 1000)\n    return decision\n","path":"sidecar/session.py"}}}
{"timestamp":"2026-10-16T21:30:50.973Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Decision session driver (S0): one decision through the mock mod, in one of three modes.\n\n- v1         : LlmPrompts replica, {\"action\",\"args\"} contract, no tool catalog (baseline)\n- mcp-prompt : catalog rendered into the prompt, {\"tool\",\"args\"} contract (local-model path)\n- mcp-native : catalog sent as native function-calling tools (cloud-model path)\n\nAll modes observe through the same MCP pipe, validate against the same catalog, and\nexecute through the same tools/call boundary — so measured differences attribute to the\nmodel-facing surface, not the plumbing.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport time\nfrom dataclasses import dataclass, field, asdict\n\nimport catalog\nfrom catalog import by_wire, check_args, first_json_object, render_native, render_prompt, render_v1_user, V1_SYSTEM\nfrom mcp import McpClient\n\n\n@dataclass\nclass Decision:\n    mode: str\n    tool: str | None = None\n    args: dict | None = None\n    decision_outcome: str = \"ok\"       # ok | malformed_json | unknown_tool | bad_args | model_error:<x>\n    exec_outcome: str | None = None    # exec_ok | exec_reject:<reason> | None (not executed)\n    model_error: str | None = None\n    model_latency_ms: int = 0\n    total_latency_ms: int = 0\n    prompt_tokens: int | None = None\n    completion_tokens: int | None = None\n    raw_preview: str | None = None\n\n    def to_row(self, model: str, scenario: str, iteration: int) -> dict:\n        row = asdict(self)\n        row.update({\"model\": model, \"scenario\": scenario, \"iteration\": iteration})\n        return row\n\n\ndef _preview(text: str | None, limit: int = 200) -> str | None:\n    if text is None:\n        return None\n    flat = \" \".join(text.split())\n    return flat if len(flat) <= limit else flat[:limit] + \"...\"\n\n\ndef _board_lines(board: dict) -> list[str]:\n    return list(board.get(\"content\", {}).get(\"open_tasks\") or [])\n\n\ndef run_decision(mode: str, model, model_tag: str, client: McpClient,\n                 profile: dict) -> Decision:\n    started = time.monotonic()\n    obs = client.call(\"observe_self\")\n    board = client.call(\"observe_board\")\n    observation = obs[\"content\"].get(\"observation\", \"\") if obs[\"ok\"] else \"\"\n    open_lines = _board_lines(board)\n    open_keys = [line.split(\" — \")[0] for line in open_lines]\n\n    temperature = profile.get(\"temperature\", 0.3)\n    max_tokens = profile.get(\"max_tokens\", 1024)\n    decision = Decision(mode=mode)\n\n    if mode == \"v1\":\n        messages = [\n            {\"role\": \"system\", \"content\": V1_SYSTEM},\n            {\"role\": \"user\", \"content\": render_v1_user(observation, open_lines)},\n        ]\n        reply = model.chat(model_tag, messages, temperature=temperature, max_tokens=max_tokens)\n        decision.model_latency_ms = reply.latency_ms\n        decision.prompt_tokens, decision.completion_tokens = reply.prompt_tokens, reply.completion_tokens\n        if not reply.ok:\n            decision.decision_outcome = \"model_error:\" + (reply.error or \"unknown\")\n            decision.raw_preview = _preview(getattr(reply, \"content\", None))\n            return _finish(decision, started)\n        candidate = first_json_object(reply.content or \"\")\n        decision.raw_preview = _preview(reply.content)\n        if candidate is None:\n            decision.decision_outcome = \"malformed_json\"\n            return _finish(decision, started)\n        action = candidate.get(\"action\")\n        args = candidate.get(\"args\") if isinstance(candidate.get(\"args\"), dict) else {}\n        if not isinstance(action, str):\n            decision.decision_outcome = \"malformed_json\"\n            return _finish(decision, started)\n        decision.tool, decision.args = action, args\n\n    elif mode == \"mcp-prompt\":\n        messages = [\n            {\"role\": \"system\", \"content\": render_prompt()},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")\n             + '\\n\\nDecide: reply with exactly one JSON object {\"tool\":\"<id>\",\"args\":{...}}.'},\n        ]\n        reply = model.chat(model_tag, messages, temperature=temperature, max_tokens=max_tokens)\n        decision.model_latency_ms = reply.latency_ms\n        decision.prompt_tokens, decision.completion_tokens = reply.prompt_tokens, reply.completion_tokens\n        if not reply.ok:\n            decision.decision_outcome = \"model_error:\" + (reply.error or \"unknown\")\n            return _finish(decision, started)\n        candidate = first_json_object(reply.content or \"\")\n        decision.raw_preview = _preview(reply.content)\n        if candidate is None or not isinstance(candidate.get(\"tool\"), str):\n            decision.decision_outcome = \"malformed_json\"\n            return _finish(decision, started)\n        decision.tool = candidate[\"tool\"]\n        decision.args = candidate.get(\"args\") if isinstance(candidate.get(\"args\"), dict) else {}\n\n    elif mode == \"mcp-native\":\n        messages = [\n            {\"role\": \"system\", \"content\":\n                \"You control a Minecraft villager-agent. Observe the situation, then call exactly \"\n                \"one tool to decide: claim a task, rest, or say something.\"},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")},\n        ]\n        reply = model.chat(model_tag, messages, tools=render_native(),\n                           temperature=temperature, max_tokens=max_tokens)\n        decision.model_latency_ms = reply.latency_ms\n        decision.prompt_tokens, decision.completion_tokens = reply.prompt_tokens, reply.completion_tokens\n        if not reply.ok:\n            decision.decision_outcome = \"model_error:\" + (reply.error or \"unknown\")\n            return _finish(decision, started)\n        if not reply.tool_calls:\n            decision.decision_outcome = \"malformed_json\"\n            decision.raw_preview = _preview(reply.content)\n            return _finish(decision, started)\n        call = reply.tool_calls[0]\n        decision.tool, decision.args = call[\"name\"], call[\"args\"]\n\n    else:\n        decision.decision_outcome = \"model_error:unknown_mode:\" + mode\n        return _finish(decision, started)\n\n    # --- catalog validation (the D7 boundary, same for every mode) -------------\n    tool = by_wire(decision.tool) if decision.tool else None\n    if tool is None:\n        decision.decision_outcome = \"unknown_tool\"\n        return _finish(decision, started)\n    arg_err = check_args(tool.inputs, decision.args if decision.args is not None else {})\n    if arg_err:\n        decision.decision_outcome = \"bad_args\"\n        decision.model_error = arg_err\n        return _finish(decision, started)\n\n    # --- execute through the mod boundary ---------------------------------------\n    result = client.call(tool.wire, decision.args or {})\n    if result[\"ok\"]:\n        decision.exec_outcome = \"exec_ok\"\n    else:\n        reject = result[\"content\"].get(\"reject\") if isinstance(result[\"content\"], dict) else str(result[\"content\"])\n        decision.exec_outcome = \"exec_reject:\" + str(reject)\n    return _finish(decision, started)\n\n\ndef _finish(decision: Decision, started: float) -> Decision:\n    decision.total_latency_ms = int((time.monotonic() - started) * 1000)\n    return decision\n","path":"sidecar/session.py"}}}
{"timestamp":"2026-10-16T21:31:17.610Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"S0 spike runner: A/B one decision surface (v1 vs mcp-prompt vs mcp-native) per model.\n\nExamples:\n  # deterministic plumbing self-test (no network, FakeModel with scripted replies):\n  python3 run_spike.py --replay replay/script.json --scenario scenarios/stone_bricks_chest.json\n\n  # local leg (LM Studio):\n  python3 run_spike.py --endpoint http://127.0.0.1:1234/v1 --model prism-ml/bonsai-27b \\\n      --mode all --iterations 2 --scenario scenarios/stone_bricks_chest.json\n\n  # cloud leg (OpenRouter config from the test world; key never printed):\n  python3 run_spike.py --cloud-config ../run/saves/TestLLM_01/serverconfig/siasworkshop-server.toml \\\n      --mode all --iterations 3 --scenario scenarios/stone_bricks_chest.json\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport statistics\nimport sys\nimport time\n\nfrom mcp import spawn_mock\nfrom model import FakeModel, OpenAiChat, profile_for\nfrom session import run_decision\n\nMODES = [\"v1\", \"mcp-prompt\", \"mcp-native\"]\n\n\ndef parse_llm_toml(path: str) -> dict:\n    \"\"\"Naive [llm] section parse (avoids a tomllib dependency floor); apiKey stays internal.\"\"\"\n    cfg: dict = {}\n    in_llm = False\n    with open(path, encoding=\"utf-8\") as fh:\n        for line in fh:\n            stripped = line.strip()\n            if stripped.startswith(\"[\"):\n                in_llm = stripped == \"[llm]\"\n                continue\n            if not in_llm or \"=\" not in stripped or stripped.startswith(\"#\"):\n                continue\n            key, _, val = stripped.partition(\"=\")\n            key, val = key.strip(), val.strip()\n            if val.startswith('\"') and val.endswith('\"'):\n                cfg[key] = val[1:-1]\n            else:\n                try:\n                    cfg[key] = int(val)\n                except ValueError:\n                    try:\n                        cfg[key] = float(val)\n                    except ValueError:\n                        cfg[key] = val.lower() == \"true\"\n    return cfg\n\n\ndef load_scenario(path: str) -> dict:\n    with open(path, encoding=\"utf-8\") as fh:\n        return json.load(fh)\n\n\ndef run_one(mode: str, model, model_tag: str, scenario_path: str, profile: dict) -> dict:\n    client = spawn_mock(scenario_path)\n    try:\n        client.start()\n        client.list_tools()  # exercises the catalog hop; result unused by S0 decisions\n        decision = run_decision(mode, model, model_tag, client, profile)\n        scenario = load_scenario(scenario_path)\n        return decision.to_row(model=model_tag, scenario=scenario.get(\"name\", scenario_path),\n                               iteration=0)\n    finally:\n        client.close()\n\n\ndef summarize(rows: list[dict]) -> None:\n    groups: dict[tuple, list[dict]] = {}\n    for row in rows:\n        groups.setdefault((row[\"model\"], row[\"mode\"]), []).append(row)\n    print(\"\\n=== summary (model × mode) ===\")\n    header = f'{\"model\":<34} {\"mode\":<11} {\"n\":>3} {\"ok%\":>6} {\"malformed%\":>10} {\"other%\":>7} {\"mean s\":>7} {\"p50 s\":>6} {\"tok/call\":>8}'\n    print(header)\n    print(\"-\" * len(header))\n    for (model, mode), group in sorted(groups.items()):\n        n = len(group)\n        oks = sum(1 for r in group if r[\"decision_outcome\"] == \"ok\" and (r[\"exec_outcome\"] or \"exec_ok\") == \"exec_ok\")\n        malformed = sum(1 for r in group if r[\"decision_outcome\"] == \"malformed_json\")\n        lat = [r[\"total_latency_ms\"] / 1000 for r in group]\n        toks = [r[\"completion_tokens\"] for r in group if r[\"completion_tokens\"] is not None]\n        print(f\"{model:<34} {mode:<11} {n:>3} {oks / n * 100:>5.0f}% {malformed / n * 100:>9.0f}% \"\n              f\"{(n - oks - malformed) / n * 100:>6.0f}% {statistics.mean(lat):>7.1f} \"\n              f\"{statistics.median(lat):>6.1f} \"\n              f\"{(int(statistics.mean(toks)) if toks else 0):>8}\")\n\n\ndef replay(script_path: str, scenario_path: str) -> int:\n    \"\"\"Deterministic plumbing test: scripted model replies, asserted outcomes (the gametest analog).\"\"\"\n    with open(script_path, encoding=\"utf-8\") as fh:\n        script = json.load(fh)\n    scenario = load_scenario(scenario_path)\n    failures = 0\n    rows = []\n    for mode in MODES:\n        applicable = [s for s in script if not s.get(\"modes\") or mode in s[\"modes\"]]\n        model = FakeModel(applicable, scenario)\n        for entry in applicable:\n            row = run_one(mode, model, mode, scenario_path, {})\n            rows.append(row)\n            checks = []\n            if \"expect_tool\" in entry:\n                checks.append((\"tool\", row[\"tool\"], entry[\"expect_tool\"]))\n            if \"expect_decision\" in entry:\n                checks.append((\"decision_outcome\", row[\"decision_outcome\"], entry[\"expect_decision\"]))\n            if \"expect_exec\" in entry:\n                checks.append((\"exec_outcome\", row[\"exec_outcome\"], entry[\"expect_exec\"]))\n            failed = [c for c in checks if c[1] != c[2]]\n            status = \"PASS\" if not failed else \"FAIL\"\n            if failed:\n                failures += 1\n            detail = f\"tool={row['tool']} decision={row['decision_outcome']} exec={row['exec_outcome']}\"\n            print(f\"[{status}] {mode:<11} {entry['name']:<22} {detail}\")\n            for kind, actual, expected in failed:\n                print(f\"        ^ {kind}: expected {expected!r}, got {actual!r}\")\n    print(f\"\\nreplay: {len(rows)} runs, {failures} failures\")\n    return 1 if failures else 0\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--scenario\", default=\"scenarios/stone_bricks_chest.json\")\n    ap.add_argument(\"--mode\", default=\"all\", choices=[\"all\"] + MODES)\n    ap.add_argument(\"--iterations\", type=int, default=1)\n    ap.add_argument(\"--endpoint\")\n    ap.add_argument(\"--model\")\n    ap.add_argument(\"--api-key-env\", default=\"OPENROUTER_API_KEY\")\n    ap.add_argument(\"--cloud-config\", help=\"path to siasworkshop-server.toml with an [llm] section\")\n    ap.add_argument(\"--replay\", metavar=\"SCRIPT.json\", help=\"scripted-reply plumbing self-test (no network)\")\n    ap.add_argument(\"--out\", help=\"metrics JSONL path (default: metrics-<ts>.jsonl)\")\n    args = ap.parse_args()\n\n    scenario_path = os.path.abspath(args.scenario)\n    if args.replay:\n        return replay(os.path.abspath(args.replay), scenario_path)\n\n    endpoint, model, api_key = args.endpoint, args.model, None\n    timeout_s = 120\n    if args.cloud_config:\n        cfg = parse_llm_toml(os.path.abspath(args.cloud_config))\n        endpoint = endpoint or cfg.get(\"endpoint\")\n        model = model or cfg.get(\"model\")\n        api_key = cfg.get(\"apiKey\") or None\n        timeout_s = int(cfg.get(\"timeoutSeconds\", 120))\n        print(f\"cloud config: endpoint={endpoint} model={model} apiKey={'<present>' if api_key else '<absent>'}\")\n    api_key = api_key or os.environ.get(args.api_key_env) or None\n    if not endpoint or not model:\n        ap.error(\"--endpoint and --model are required (or --cloud-config)\")\n    profile = profile_for(model)\n    profile = dict(profile, timeout_seconds=timeout_s)\n    chat = OpenAiChat(endpoint, api_key, timeout_s)\n    modes = MODES if args.mode == \"all\" else [args.mode]\n    out_path = args.out or f\"metrics-{time.strftime('%Y%m%d-%H%M%S')}.jsonl\"\n    rows: list[dict] = []\n    with open(out_path, \"a\", encoding=\"utf-8\") as out:\n        for iteration in range(1, args.iterations + 1):\n            for mode in modes:\n                mode_profile = dict(profile)\n                if args.mode == \"all\":\n                    pass  # profile's render mode is fixed per model; --mode forces the surface for A/B\n                if mode == \"mcp-native\" and profile[\"mode\"] == \"prompt\":\n                    print(f\"note: {model} profile is prompt-mode; mcp-native leg tests wire compat anyway\")\n                row = run_one(mode, chat, model, scenario_path, mode_profile)\n                row[\"iteration\"] = iteration\n                rows.append(row)\n                out.write(json.dumps(row) + \"\\n\")\n                out.flush()\n                print(f\"iter {iteration} {mode:<11} -> decision={row['decision_outcome']:<12} \"\n                      f\"tool={row['tool']} exec={row['exec_outcome']} \"\n                      f\"model={row['model_latency_ms']}ms total={row['total_latency_ms']}ms \"\n                      f\"ctoks={row['completion_tokens']}\")\n    summarize(rows)\n    print(f\"\\nmetrics -> {out_path}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","path":"sidecar/run_spike.py"}}}
{"timestamp":"2026-10-16T21:31:17.614Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"S0 spike runner: A/B one decision surface (v1 vs mcp-prompt vs mcp-native) per model.\n\nExamples:\n  # deterministic plumbing self-test (no network, FakeModel with scripted replies):\n  python3 run_spike.py --replay replay/script.json --scenario scenarios/stone_bricks_chest.json\n\n  # local leg (LM Studio):\n  python3 run_spike.py --endpoint http://127.0.0.1:1234/v1 --model prism-ml/bonsai-27b \\\n      --mode all --iterations 2 --scenario scenarios/stone_bricks_chest.json\n\n  # cloud leg (OpenRouter config from the test world; key never printed):\n  python3 run_spike.py --cloud-config ../run/saves/TestLLM_01/serverconfig/siasworkshop-server.toml \\\n      --mode all --iterations 3 --scenario scenarios/stone_bricks_chest.json\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport statistics\nimport sys\nimport time\n\nfrom mcp import spawn_mock\nfrom model import FakeModel, OpenAiChat, profile_for\nfrom session import run_decision\n\nMODES = [\"v1\", \"mcp-prompt\", \"mcp-native\"]\n\n\ndef parse_llm_toml(path: str) -> dict:\n    \"\"\"Naive [llm] section parse (avoids a tomllib dependency floor); apiKey stays internal.\"\"\"\n    cfg: dict = {}\n    in_llm = False\n    with open(path, encoding=\"utf-8\") as fh:\n        for line in fh:\n            stripped = line.strip()\n            if stripped.startswith(\"[\"):\n                in_llm = stripped == \"[llm]\"\n                continue\n            if not in_llm or \"=\" not in stripped or stripped.startswith(\"#\"):\n                continue\n            key, _, val = stripped.partition(\"=\")\n            key, val = key.strip(), val.strip()\n            if val.startswith('\"') and val.endswith('\"'):\n                cfg[key] = val[1:-1]\n            else:\n                try:\n                    cfg[key] = int(val)\n                except ValueError:\n                    try:\n                        cfg[key] = float(val)\n                    except ValueError:\n                        cfg[key] = val.lower() == \"true\"\n    return cfg\n\n\ndef load_scenario(path: str) -> dict:\n    with open(path, encoding=\"utf-8\") as fh:\n        return json.load(fh)\n\n\ndef run_one(mode: str, model, model_tag: str, scenario_path: str, profile: dict) -> dict:\n    client = spawn_mock(scenario_path)\n    try:\n        client.start()\n        client.list_tools()  # exercises the catalog hop; result unused by S0 decisions\n        decision = run_decision(mode, model, model_tag, client, profile)\n        scenario = load_scenario(scenario_path)\n        return decision.to_row(model=model_tag, scenario=scenario.get(\"name\", scenario_path),\n                               iteration=0)\n    finally:\n        client.close()\n\n\ndef summarize(rows: list[dict]) -> None:\n    groups: dict[tuple, list[dict]] = {}\n    for row in rows:\n        groups.setdefault((row[\"model\"], row[\"mode\"]), []).append(row)\n    print(\"\\n=== summary (model × mode) ===\")\n    header = f'{\"model\":<34} {\"mode\":<11} {\"n\":>3} {\"ok%\":>6} {\"malformed%\":>10} {\"other%\":>7} {\"mean s\":>7} {\"p50 s\":>6} {\"tok/call\":>8}'\n    print(header)\n    print(\"-\" * len(header))\n    for (model, mode), group in sorted(groups.items()):\n        n = len(group)\n        oks = sum(1 for r in group if r[\"decision_outcome\"] == \"ok\" and (r[\"exec_outcome\"] or \"exec_ok\") == \"exec_ok\")\n        malformed = sum(1 for r in group if r[\"decision_outcome\"] == \"malformed_json\")\n        lat = [r[\"total_latency_ms\"] / 1000 for r in group]\n        toks = [r[\"completion_tokens\"] for r in group if r[\"completion_tokens\"] is not None]\n        print(f\"{model:<34} {mode:<11} {n:>3} {oks / n * 100:>5.0f}% {malformed / n * 100:>9.0f}% \"\n              f\"{(n - oks - malformed) / n * 100:>6.0f}% {statistics.mean(lat):>7.1f} \"\n              f\"{statistics.median(lat):>6.1f} \"\n              f\"{(int(statistics.mean(toks)) if toks else 0):>8}\")\n\n\ndef replay(script_path: str, scenario_path: str) -> int:\n    \"\"\"Deterministic plumbing test: scripted model replies, asserted outcomes (the gametest analog).\"\"\"\n    with open(script_path, encoding=\"utf-8\") as fh:\n        script = json.load(fh)\n    scenario = load_scenario(scenario_path)\n    failures = 0\n    rows = []\n    for mode in MODES:\n        applicable = [s for s in script if not s.get(\"modes\") or mode in s[\"modes\"]]\n        model = FakeModel(applicable, scenario)\n        for entry in applicable:\n            row = run_one(mode, model, mode, scenario_path, {})\n            rows.append(row)\n            checks = []\n            if \"expect_tool\" in entry:\n                checks.append((\"tool\", row[\"tool\"], entry[\"expect_tool\"]))\n            if \"expect_decision\" in entry:\n                checks.append((\"decision_outcome\", row[\"decision_outcome\"], entry[\"expect_decision\"]))\n            if \"expect_exec\" in entry:\n                checks.append((\"exec_outcome\", row[\"exec_outcome\"], entry[\"expect_exec\"]))\n            failed = [c for c in checks if c[1] != c[2]]\n            status = \"PASS\" if not failed else \"FAIL\"\n            if failed:\n                failures += 1\n            detail = f\"tool={row['tool']} decision={row['decision_outcome']} exec={row['exec_outcome']}\"\n            print(f\"[{status}] {mode:<11} {entry['name']:<22} {detail}\")\n            for kind, actual, expected in failed:\n                print(f\"        ^ {kind}: expected {expected!r}, got {actual!r}\")\n    print(f\"\\nreplay: {len(rows)} runs, {failures} failures\")\n    return 1 if failures else 0\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--scenario\", default=\"scenarios/stone_bricks_chest.json\")\n    ap.add_argument(\"--mode\", default=\"all\", choices=[\"all\"] + MODES)\n    ap.add_argument(\"--iterations\", type=int, default=1)\n    ap.add_argument(\"--endpoint\")\n    ap.add_argument(\"--model\")\n    ap.add_argument(\"--api-key-env\", default=\"OPENROUTER_API_KEY\")\n    ap.add_argument(\"--cloud-config\", help=\"path to siasworkshop-server.toml with an [llm] section\")\n    ap.add_argument(\"--replay\", metavar=\"SCRIPT.json\", help=\"scripted-reply plumbing self-test (no network)\")\n    ap.add_argument(\"--out\", help=\"metrics JSONL path (default: metrics-<ts>.jsonl)\")\n    args = ap.parse_args()\n\n    scenario_path = os.path.abspath(args.scenario)\n    if args.replay:\n        return replay(os.path.abspath(args.replay), scenario_path)\n\n    endpoint, model, api_key = args.endpoint, args.model, None\n    timeout_s = 120\n    if args.cloud_config:\n        cfg = parse_llm_toml(os.path.abspath(args.cloud_config))\n        endpoint = endpoint or cfg.get(\"endpoint\")\n        model = model or cfg.get(\"model\")\n        api_key = cfg.get(\"apiKey\") or None\n        timeout_s = int(cfg.get(\"timeoutSeconds\", 120))\n        print(f\"cloud config: endpoint={endpoint} model={model} apiKey={'<present>' if api_key else '<absent>'}\")\n    api_key = api_key or os.environ.get(args.api_key_env) or None\n    if not endpoint or not model:\n        ap.error(\"--endpoint and --model are required (or --cloud-config)\")\n    profile = profile_for(model)\n    profile = dict(profile, timeout_seconds=timeout_s)\n    chat = OpenAiChat(endpoint, api_key, timeout_s)\n    modes = MODES if args.mode == \"all\" else [args.mode]\n    out_path = args.out or f\"metrics-{time.strftime('%Y%m%d-%H%M%S')}.jsonl\"\n    rows: list[dict] = []\n    with open(out_path, \"a\", encoding=\"utf-8\") as out:\n        for iteration in range(1, args.iterations + 1):\n            for mode in modes:\n                mode_profile = dict(profile)\n                if args.mode == \"all\":\n                    pass  # profile's render mode is fixed per model; --mode forces the surface for A/B\n                if mode == \"mcp-native\" and profile[\"mode\"] == \"prompt\":\n                    print(f\"note: {model} profile is prompt-mode; mcp-native leg tests wire compat anyway\")\n                row = run_one(mode, chat, model, scenario_path, mode_profile)\n                row[\"iteration\"] = iteration\n                rows.append(row)\n                out.write(json.dumps(row) + \"\\n\")\n                out.flush()\n                print(f\"iter {iteration} {mode:<11} -> decision={row['decision_outcome']:<12} \"\n                      f\"tool={row['tool']} exec={row['exec_outcome']} \"\n                      f\"model={row['model_latency_ms']}ms total={row['total_latency_ms']}ms \"\n                      f\"ctoks={row['completion_tokens']}\")\n    summarize(rows)\n    print(f\"\\nmetrics -> {out_path}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","path":"sidecar/run_spike.py"}}}
