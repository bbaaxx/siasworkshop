{"timestamp":"2026-10-09T21:18:42.226Z","type":"tool","step":"COMPLETE","details":{"toolName":"bash","args":{"command":"./node_modules/.bin/mdocs command initiative.done --json \"$(cat <<'MDOCS_EOF'\n{\"id\":\"publish-to-curseforge\",\"progressNote\":\"Initiative wrapped up 2026-10-09: project created on CurseForge and submitted with v1.0.1 jars (both MC versions, NeoForge tags, Release type); under moderation review — verdict is external to this repo. DEFERRED follow-up (recorded in plan + wiki): after approval, add CF page link to README and optionally wire author-console API token (GitHub secret CURSEFORGE_TOKEN) + project ID into release.yml for auto-publish.\"}\nMDOCS_EOF\n)\" | head -3\n./node_modules/.bin/mdocs command lifecycle.graduate --json \"$(cat <<'MDOCS_EOF'\n{\"id\":\"publish-to-curseforge\",\"sections\":[{\"section\":\"CurseForge Publishing (v1.0.0/v1.0.1)\",\"body\":\"Published Sia's Workshop to CurseForge: project created with All Rights Reserved license + designer logo + paste-ready HTML description (docs/curseforge-description.html); uploaded one file per MC version (1.21.1 and 1.20.1 jars), each tagged Release with the NeoForge modloader tag — CF defaults untagged files to Forge, which would hide the mod from NeoForge app filters. New projects need an approved Release/Beta file to become visible; moderation review is the remaining gate. Full runbook lives in wiki setup/curseforge-publishing.\"}],\"logEntry\":\"publish-to-curseforge DONE: CF project submitted and under review; runbook in wiki; CI auto-publish deferred until approval + API token.\"}\nMDOCS_EOF\n)\" | head -4\n./node_modules/.bin/mdocs step COMPLETE >/dev/null && ./node_modules/.bin/mdocs validate --summary | head -2"}}}
