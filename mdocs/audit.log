{"timestamp":"2026-10-17T07:32:32.126Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    private static void releaseForAgent(WorkshopAgentEntity agent, TaskBoard board, BoardTask task, long now) {\n        board.release(task.id(), agent.getUUID(), now);\n        agent.setCurrentTaskLabel(\"\");\n        releaseCooldowns.computeIfAbsent(agent.getUUID(), k -> new HashMap<>())\n                .put(task.key(), now + RELEASE_COOLDOWN_TICKS);\n    }\n\n    /**\n     * True while {@code key} is in this agent's release cooldown (see {@link #releaseForAgent}).\n     * Public: shared by the MCP tool surface so a cooled-down task is neither listed nor\n     * claimable for the agent that just released it — otherwise the model burns a decision\n     * lap re-picking it every cycle.\n     */\n    public static boolean inReleaseCooldown(UUID agentUuid, String key, long now) {\n        Map<String, Long> cooldowns = releaseCooldowns.get(agentUuid);\n        if (cooldowns == null) {\n            return false;\n        }\n        cooldowns.entrySet().removeIf(entry -> entry.getValue() <= now);\n        Long until = cooldowns.get(key);\n        return until != null && until > now;\n    }","oldString":"    private static void releaseForAgent(WorkshopAgentEntity agent, TaskBoard board, BoardTask task, long now) {\n        board.release(task.id(), agent.getUUID(), now);\n        agent.setCurrentTaskLabel(\"\");\n        releaseCooldowns.computeIfAbsent(agent.getUUID(), k -> new HashMap<>())\n                .put(task.key(), now + RELEASE_COOLDOWN_TICKS);\n    }","path":"src/main/java/com/siaws/siawsmod/content/agents/AgentDecisionLoop.java"}}}
{"timestamp":"2026-10-17T07:32:32.131Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    private static void releaseForAgent(WorkshopAgentEntity agent, TaskBoard board, BoardTask task, long now) {\n        board.release(task.id(), agent.getUUID(), now);\n        agent.setCurrentTaskLabel(\"\");\n        releaseCooldowns.computeIfAbsent(agent.getUUID(), k -> new HashMap<>())\n                .put(task.key(), now + RELEASE_COOLDOWN_TICKS);\n    }\n\n    /**\n     * True while {@code key} is in this agent's release cooldown (see {@link #releaseForAgent}).\n     * Public: shared by the MCP tool surface so a cooled-down task is neither listed nor\n     * claimable for the agent that just released it — otherwise the model burns a decision\n     * lap re-picking it every cycle.\n     */\n    public static boolean inReleaseCooldown(UUID agentUuid, String key, long now) {\n        Map<String, Long> cooldowns = releaseCooldowns.get(agentUuid);\n        if (cooldowns == null) {\n            return false;\n        }\n        cooldowns.entrySet().removeIf(entry -> entry.getValue() <= now);\n        Long until = cooldowns.get(key);\n        return until != null && until > now;\n    }","oldString":"    private static void releaseForAgent(WorkshopAgentEntity agent, TaskBoard board, BoardTask task, long now) {\n        board.release(task.id(), agent.getUUID(), now);\n        agent.setCurrentTaskLabel(\"\");\n        releaseCooldowns.computeIfAbsent(agent.getUUID(), k -> new HashMap<>())\n                .put(task.key(), now + RELEASE_COOLDOWN_TICKS);\n    }","path":"src/main/java/com/siaws/siawsmod/content/agents/AgentDecisionLoop.java"}}}
