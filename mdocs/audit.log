{"timestamp":"2026-10-17T22:37:47.834Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Throwaway smoke: --replay + default --scenario must resolve {{build_key}}/{{player}}.\"\"\"\nimport json, os, subprocess, sys, threading, time\n\nHERE = \"/Users/bbaaxx/Code/projects/siasworkshop/sidecar\"\nscript = [{\"name\": \"placeholder_claim\", \"modes\": [\"prompt\"],\n           \"content\": '{\"tool\":\"claim\",\"args\":{\"task\":\"{{build_key}}\"}}'}]\nsp = \"/tmp/placeholder-script.json\"\nwith open(sp, \"w\") as fh:\n    json.dump(script, fh)\n\nmock = subprocess.Popen([sys.executable, os.path.join(HERE, \"mockmod.py\"),\n                         os.path.join(HERE, \"scenarios/stone_bricks_chest.json\")],\n                        stdin=subprocess.PIPE, stdout=subprocess.PIPE)\nsidecar = subprocess.Popen([sys.executable, os.path.join(HERE, \"sidecar.py\"),\n                            \"--replay\", sp],\n                           stdin=subprocess.PIPE, stdout=subprocess.PIPE)\nlock, done, seen = threading.Lock(), threading.Event(), {}\n\ndef relay(src, dst, tag):\n    for line in src:\n        with lock:\n            dst.write(line); dst.flush()\n        flat = line.decode(errors=\"replace\").replace(\" \", \"\")\n        if tag == \"s2m\" and '\"id\":99' in flat and '\"result\"' in flat:\n            try:\n                seen[\"response\"] = json.loads(line.decode())\n            except ValueError:\n                pass\n            done.set()\n    done.set()\n\nthreading.Thread(target=relay, args=(sidecar.stdout, mock.stdin, \"s2m\"), daemon=True).start()\nthreading.Thread(target=relay, args=(mock.stdout, sidecar.stdin, \"m2s\"), daemon=True).start()\ntime.sleep(0.7)\nreq = (json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"tools/call\",\n                   \"params\": {\"name\": \"decide\", \"arguments\": {\"agent\": \"agent-1\"}}}) + \"\\n\").encode()\nwith lock:\n    sidecar.stdin.write(req); sidecar.stdin.flush()\nfinished = done.wait(timeout=20)\nfor proc in (mock, sidecar):\n    try:\n        proc.terminate(); proc.wait(timeout=5)\n    except Exception:\n        proc.kill()\n\nif not finished or \"response\" not in seen:\n    print(\"SMOKE FAIL: no decide response\")\n    sys.exit(1)\ncontent = seen[\"response\"].get(\"result\", {}).get(\"content\", [])\nsummary = json.loads(content[0][\"text\"]) if content else {}\nprint(\"decide summary:\", json.dumps(summary))\nok = summary.get(\"decision\") == \"claim\" and summary.get(\"task\") == \"build:mazons:7d2f\"\nprint(\"placeholder smoke:\", \"PASS\" if ok else \"FAIL ({{build_key}} did not resolve)\")\nsys.exit(0 if ok else 1)\n","path":"/tmp/placeholder-smoke.py"}}}
