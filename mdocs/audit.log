{"timestamp":"2026-10-07T21:09:07.325Z","type":"tool","initiativeId":"mod-ecosystem-research","step":"EXECUTE","details":{"toolName":"bash","args":{"command":"curl -s \"https://api.github.com/repos/Luke100000/minecraft-comes-alive/git/trees/1.21.1?recursive=1\" | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\npaths=[t['path'] for t in d.get('tree',[]) if t['type']=='blob']\nprint('total files:',len(paths))\ndirs={}\nfor p in paths:\n    parts=p.split('/')\n    if len(parts)>4:\n        k='/'.join(parts[:4])\n        dirs[k]=dirs.get(k,0)+1\nfor k,v in sorted(dirs.items()):\n    print(v,'|',k)\n\" | head -80"}}}
{"timestamp":"2026-10-07T21:09:07.330Z","type":"tool","initiativeId":"mod-ecosystem-research","step":"EXECUTE","details":{"toolName":"bash","args":{"command":"curl -s \"https://api.github.com/repos/Luke100000/minecraft-comes-alive/git/trees/1.21.1?recursive=1\" | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\npaths=[t['path'] for t in d.get('tree',[]) if t['type']=='blob']\nprint('total files:',len(paths))\ndirs={}\nfor p in paths:\n    parts=p.split('/')\n    if len(parts)>4:\n        k='/'.join(parts[:4])\n        dirs[k]=dirs.get(k,0)+1\nfor k,v in sorted(dirs.items()):\n    print(v,'|',k)\n\" | head -80"}}}
{"timestamp":"2026-10-07T21:09:17.406Z","type":"tool","initiativeId":"mod-ecosystem-research","step":"EXECUTE","details":{"toolName":"bash","args":{"command":"curl -s \"https://api.github.com/repos/Luke100000/minecraft-comes-alive/git/trees/1.21.1?recursive=1\" | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\npaths=[t['path'] for t in d.get('tree',[]) if t['type']=='blob' and t['path'].endswith('.java')]\npkgs={}\nfor p in paths:\n    if '/src/' in p:\n        # package = dirs under java root\n        idx=p.index('/java/')+6\n        seg=p[idx:].rsplit('/',1)[0]\n        parts=seg.split('/')\n        for depth in (2,3):\n            if len(parts)>=depth:\n                k='/'.join(parts[:depth])\n                pkgs[k]=pkgs.get(k,0)+1\nfor k,v in sorted(pkgs.items()):\n    print(v,'|',k)\n\" | grep -v '/src' | head -60"}}}
