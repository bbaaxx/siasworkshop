{"timestamp":"2026-10-14T19:39:29.534Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"write","args":{"content":"package com.siaws.siawsmod.content.agents.build;\n\nimport java.io.IOException;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Locale;\nimport java.util.Map;\nimport java.util.stream.Stream;\n\nimport javax.annotation.Nullable;\n\nimport com.siaws.siawsmod.SiasWorkshop;\n\nimport net.neoforged.fml.loading.FMLPaths;\n\n/**\n * The blueprint library: everything the build queue can build, scanned once per server start\n * from {@code config/siasworkshop/blueprints/} (player-imported .schem/.nbt files — the\n * BYO-library model from the design's build-knowledge table). Malformed files are skipped\n * with one WARN line each, never fatal. Singleton: scanned from ServerStartingEvent, read by\n * the build queue and the decision loop.\n */\npublic final class BlueprintLibrary {\n    public static final BlueprintLibrary INSTANCE = new BlueprintLibrary();\n\n    private final Map<String, Blueprint> blueprints = new LinkedHashMap<>();\n\n    private BlueprintLibrary() {}\n\n    /** Rescans the import folder. Call on server start (and after dropping new files, via restart). */\n    public void reload() {\n        blueprints.clear();\n        Path folder = FMLPaths.CONFIGDIR.get().resolve(\"siasworkshop/blueprints\");\n        if (!Files.isDirectory(folder)) {\n            return;\n        }\n        try (Stream<Path> files = Files.list(folder)) {\n            for (Path file : files.filter(Files::isRegularFile).toList()) {\n                String fileName = file.getFileName().toString().toLowerCase(Locale.ROOT);\n                try {\n                    Blueprint blueprint = fileName.endsWith(\".schem\")\n                            ? SchemParser.parse(file)\n                            : fileName.endsWith(\".nbt\")\n                                    ? StructureNbtParser.parse(file)\n                                    : null;\n                    if (blueprint != null) {\n                        blueprints.put(blueprint.name().toLowerCase(Locale.ROOT), blueprint);\n                    }\n                } catch (BlueprintParseException e) {\n                    SiasWorkshop.LOGGER.warn(\"[BlueprintLibrary] skipping {}: {}\", file.getFileName(), e.getMessage());\n                }\n            }\n        } catch (IOException e) {\n            SiasWorkshop.LOGGER.warn(\"[BlueprintLibrary] could not scan {}: {}\", folder, e.getMessage());\n        }\n        if (!blueprints.isEmpty()) {\n            SiasWorkshop.LOGGER.info(\"[BlueprintLibrary] loaded {} blueprint(s) from {}\", blueprints.size(), folder);\n        }\n    }\n\n    /** Case-insensitive lookup by blueprint name; null when unknown. */\n    @Nullable\n    public Blueprint get(String name) {\n        return blueprints.get(name.toLowerCase(Locale.ROOT));\n    }\n\n    /** All loaded blueprints, in load order. */\n    public List<Blueprint> all() {\n        return List.copyOf(blueprints.values());\n    }\n\n    public int size() {\n        return blueprints.size();\n    }\n\n    /** Test/dev hook: register a blueprint without an import file on disk. */\n    public void registerForTest(Blueprint blueprint) {\n        blueprints.put(blueprint.name().toLowerCase(Locale.ROOT), blueprint);\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BlueprintLibrary.java"}}}
{"timestamp":"2026-10-14T19:39:29.537Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"write","args":{"content":"package com.siaws.siawsmod.content.agents.build;\n\nimport java.io.IOException;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Locale;\nimport java.util.Map;\nimport java.util.stream.Stream;\n\nimport javax.annotation.Nullable;\n\nimport com.siaws.siawsmod.SiasWorkshop;\n\nimport net.neoforged.fml.loading.FMLPaths;\n\n/**\n * The blueprint library: everything the build queue can build, scanned once per server start\n * from {@code config/siasworkshop/blueprints/} (player-imported .schem/.nbt files — the\n * BYO-library model from the design's build-knowledge table). Malformed files are skipped\n * with one WARN line each, never fatal. Singleton: scanned from ServerStartingEvent, read by\n * the build queue and the decision loop.\n */\npublic final class BlueprintLibrary {\n    public static final BlueprintLibrary INSTANCE = new BlueprintLibrary();\n\n    private final Map<String, Blueprint> blueprints = new LinkedHashMap<>();\n\n    private BlueprintLibrary() {}\n\n    /** Rescans the import folder. Call on server start (and after dropping new files, via restart). */\n    public void reload() {\n        blueprints.clear();\n        Path folder = FMLPaths.CONFIGDIR.get().resolve(\"siasworkshop/blueprints\");\n        if (!Files.isDirectory(folder)) {\n            return;\n        }\n        try (Stream<Path> files = Files.list(folder)) {\n            for (Path file : files.filter(Files::isRegularFile).toList()) {\n                String fileName = file.getFileName().toString().toLowerCase(Locale.ROOT);\n                try {\n                    Blueprint blueprint = fileName.endsWith(\".schem\")\n                            ? SchemParser.parse(file)\n                            : fileName.endsWith(\".nbt\")\n                                    ? StructureNbtParser.parse(file)\n                                    : null;\n                    if (blueprint != null) {\n                        blueprints.put(blueprint.name().toLowerCase(Locale.ROOT), blueprint);\n                    }\n                } catch (BlueprintParseException e) {\n                    SiasWorkshop.LOGGER.warn(\"[BlueprintLibrary] skipping {}: {}\", file.getFileName(), e.getMessage());\n                }\n            }\n        } catch (IOException e) {\n            SiasWorkshop.LOGGER.warn(\"[BlueprintLibrary] could not scan {}: {}\", folder, e.getMessage());\n        }\n        if (!blueprints.isEmpty()) {\n            SiasWorkshop.LOGGER.info(\"[BlueprintLibrary] loaded {} blueprint(s) from {}\", blueprints.size(), folder);\n        }\n    }\n\n    /** Case-insensitive lookup by blueprint name; null when unknown. */\n    @Nullable\n    public Blueprint get(String name) {\n        return blueprints.get(name.toLowerCase(Locale.ROOT));\n    }\n\n    /** All loaded blueprints, in load order. */\n    public List<Blueprint> all() {\n        return List.copyOf(blueprints.values());\n    }\n\n    public int size() {\n        return blueprints.size();\n    }\n\n    /** Test/dev hook: register a blueprint without an import file on disk. */\n    public void registerForTest(Blueprint blueprint) {\n        blueprints.put(blueprint.name().toLowerCase(Locale.ROOT), blueprint);\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BlueprintLibrary.java"}}}
{"timestamp":"2026-10-14T19:39:50.817Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"write","args":{"content":"package com.siaws.siawsmod.content.agents.build;\n\nimport java.util.Locale;\n\nimport javax.annotation.Nullable;\n\nimport com.siaws.siawsmod.content.agents.AgentWorldData;\nimport com.siaws.siawsmod.content.agents.tasks.BoardTask;\nimport com.siaws.siawsmod.content.agents.tasks.TaskBoard;\n\nimport net.minecraft.core.BlockPos;\nimport net.minecraft.server.level.ServerLevel;\n\n/**\n * The build queue: how blueprint builds become board tasks. v1 enqueue path is the\n * {@code /siasworkshop build} command (a GUI on the village foundation block is deliberately\n * deferred). Session-scoped manager — it owns no state of its own: the single task store is\n * the {@link TaskBoard} (a BUILD task is a normal singleton board task keyed by\n * {@code build:<name>:<anchor>}). The job description travels in the task detail as\n * {@code blueprint=<name> anchor=<x>,<y>,<z>}, which the execution loop parses back.\n */\npublic final class BuildQueue {\n    /** Detail prefix encoding the job; kept parseable-by-construction for the executor. */\n    private static final String DETAIL_FORMAT = \"blueprint=%s anchor=%d,%d,%d\";\n\n    private BuildQueue() {}\n\n    /**\n     * Enqueues a build of {@code blueprintName} at {@code anchor}. Returns the task when it\n     * exists afterwards (new or already-raised), or null when the blueprint is unknown —\n     * callers surface that feedback in chat.\n     */\n    @Nullable\n    public static BoardTask enqueue(ServerLevel level, String blueprintName, BlockPos anchor) {\n        Blueprint blueprint = BlueprintLibrary.INSTANCE.get(blueprintName);\n        if (blueprint == null) {\n            return null;\n        }\n        String name = blueprint.name();\n        String key = \"build:\" + name + \":\" + anchor.getX() + \",\" + anchor.getY() + \",\" + anchor.getZ();\n        String detail = DETAIL_FORMAT.formatted(name, anchor.getX(), anchor.getY(), anchor.getZ());\n        return AgentWorldData.board(level).raiseIfAbsent(key, BoardTask.Type.BUILD, detail, level.getGameTime());\n    }\n\n    /** A parsed build job. */\n    public record BuildJob(String blueprintName, BlockPos anchor) {}\n\n    /**\n     * Parses the job description back out of a BUILD task's key/detail. Returns null when the\n     * task is not a BUILD task or the description is malformed — the caller then fails the\n     * task as {@code malformed_job}.\n     */\n    @Nullable\n    public static BuildJob parseJob(BoardTask task) {\n        if (task.type() != BoardTask.Type.BUILD) {\n            return null;\n        }\n        String detail = task.detail();\n        String blueprint = null;\n        BlockPos anchor = null;\n        for (String field : detail.split(\" \")) {\n            if (field.startsWith(\"blueprint=\")) {\n                blueprint = field.substring(\"blueprint=\".length());\n            } else if (field.startsWith(\"anchor=\")) {\n                anchor = parsePos(field.substring(\"anchor=\".length()));\n            }\n        }\n        if (blueprint == null || blueprint.isEmpty() || anchor == null) {\n            return null;\n        }\n        return new BuildJob(blueprint, anchor);\n    }\n\n    @Nullable\n    private static BlockPos parsePos(String value) {\n        String[] parts = value.split(\",\");\n        if (parts.length != 3) {\n            return null;\n        }\n        try {\n            return new BlockPos(Integer.parseInt(parts[0].trim()),\n                    Integer.parseInt(parts[1].trim()), Integer.parseInt(parts[2].trim()));\n        } catch (NumberFormatException e) {\n            return null;\n        }\n    }\n\n    /** Lowercase tokens of the blueprint name, used as style-tag candidates for card retrieval. */\n    public static java.util.Set<String> nameTokens(String blueprintName) {\n        java.util.Set<String> tokens = new java.util.HashSet<>();\n        for (String token : blueprintName.toLowerCase(Locale.ROOT).split(\"[^a-z0-9]+\")) {\n            if (!token.isEmpty()) {\n                tokens.add(token);\n            }\n        }\n        return tokens;\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BuildQueue.java"}}}
