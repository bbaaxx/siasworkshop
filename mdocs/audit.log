{"timestamp":"2026-10-18T04:47:55.005Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"bash","args":{"command":"python3 - <<'EOF'\nimport json, glob\nfrom collections import defaultdict\nfor f in sorted(glob.glob(\"metrics/corpus-*20261017-22*.jsonl\")):\n    rows = [json.loads(l) for l in open(f)]\n    print(\"==\", f, \"n=\", len(rows))\n    by = defaultdict(list)\n    for r in rows: by[r[\"scenario\"]].append(r)\n    for sc, rs in by.items():\n        pyes = [r[\"p_yes\"] for r in rs if r.get(\"p_yes\") is not None]\n        mass_forbid = []\n        argmax_forbid = 0\n        for r in rs:\n            probs = r.get(\"option_probs\") or {}\n            forbid = set()\n            # forbidden keys are not in the row; approximate via scenario assert is not available here\n            if probs:\n                top = max(probs, key=probs.get)\n                # unroutable/missing/station scenarios: first-listed key in assert notes; use board_order[0] as proxy only for unroutable\n        print(f\"  {sc:36s} n={len(rs):3d} meanP(yes)={sum(pyes)/len(pyes):.3f} min={min(pyes):.3f} max={max(pyes):.3f}\")\n        # show two sample rows' option_probs\n        for r in rs[:2]:\n            print(f\"    sample t{r['trial']}.{r['permutation']} p_yes={r['p_yes']:.3f} option_probs={ {k: round(v,3) for k,v in (r.get('option_probs') or {}).items()} }\")\nEOF","cwd":"sidecar"}}}
{"timestamp":"2026-10-18T04:47:55.001Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"bash","args":{"command":"python3 - <<'EOF'\nimport json, glob\nfrom collections import defaultdict\nfor f in sorted(glob.glob(\"metrics/corpus-*20261017-22*.jsonl\")):\n    rows = [json.loads(l) for l in open(f)]\n    print(\"==\", f, \"n=\", len(rows))\n    by = defaultdict(list)\n    for r in rows: by[r[\"scenario\"]].append(r)\n    for sc, rs in by.items():\n        pyes = [r[\"p_yes\"] for r in rs if r.get(\"p_yes\") is not None]\n        mass_forbid = []\n        argmax_forbid = 0\n        for r in rs:\n            probs = r.get(\"option_probs\") or {}\n            forbid = set()\n            # forbidden keys are not in the row; approximate via scenario assert is not available here\n            if probs:\n                top = max(probs, key=probs.get)\n                # unroutable/missing/station scenarios: first-listed key in assert notes; use board_order[0] as proxy only for unroutable\n        print(f\"  {sc:36s} n={len(rs):3d} meanP(yes)={sum(pyes)/len(pyes):.3f} min={min(pyes):.3f} max={max(pyes):.3f}\")\n        # show two sample rows' option_probs\n        for r in rs[:2]:\n            print(f\"    sample t{r['trial']}.{r['permutation']} p_yes={r['p_yes']:.3f} option_probs={ {k: round(v,3) for k,v in (r.get('option_probs') or {}).items()} }\")\nEOF","cwd":"sidecar"}}}
{"timestamp":"2026-10-18T04:48:54.815Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"bash","args":{"command":"python3 - <<'EOF'\nimport json, glob, sys\nsys.path.insert(0, \".\")\nfrom corpus_score import null_auc\n\nGT = {  # ground truth per scenario: (forbidden_keys, null_ground_truth)\n \"unroutable_anchor_first_listed\": ({\"build:mazons:-20,86,0\"}, False),\n \"missing_material_stone_vs_bricks\": ({\"build:mazons:3a21\"}, False),\n \"station_radius_edge\": ({\"build:mazons:62c4\"}, False),\n \"null_board_cooling\": (set(), True),\n}\nfor f in sorted(glob.glob(\"metrics/corpus-*20261017-22*.jsonl\")):\n    rows = [json.loads(l) for l in open(f)]\n    print(\"==\", f.split(\"/\")[-1])\n    mixed = []\n    for sc in GT:\n        forbid, null_true = GT[sc]\n        rs = [r for r in rows if r[\"scenario\"] == sc]\n        # argmax content stats\n        argmax_forbid = argmax_ok = 0\n        for r in rs:\n            probs = r.get(\"option_probs\") or {}\n            if not probs: continue\n            top = max(probs, key=probs.get)\n            if top in forbid: argmax_forbid += 1\n            elif not null_true: argmax_ok += 1\n        # flip across permutations within a trial (by argmax)\n        flips = groups = 0\n        by_trial = {}\n        for r in rs:\n            probs = r.get(\"option_probs\") or {}\n            if not probs: continue\n            by_trial.setdefault(r[\"trial\"], set()).add(max(probs, key=probs.get))\n        for choices in by_trial.values():\n            groups += 1\n            if len(choices) > 1: flips += 1\n        print(f\"  {sc:36s} argmax_forbidden={argmax_forbid}/{len(rs)}  argmax_permitted={argmax_ok}/{len(rs)}  argmax_flip_rate={flips}/{groups}\")\n    for r in rows:\n        _, null_true = GT[r[\"scenario\"]]\n        if r.get(\"p_yes\") is not None:\n            mixed.append({\"coverage_confidence\": r[\"p_yes\"], \"null_ground_truth\": null_true})\n    print(\"  cross-scenario null_auc:\", null_auc(mixed))\nEOF","cwd":"sidecar"}}}
{"timestamp":"2026-10-18T04:48:54.818Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"PLAN","details":{"toolName":"bash","args":{"command":"python3 - <<'EOF'\nimport json, glob, sys\nsys.path.insert(0, \".\")\nfrom corpus_score import null_auc\n\nGT = {  # ground truth per scenario: (forbidden_keys, null_ground_truth)\n \"unroutable_anchor_first_listed\": ({\"build:mazons:-20,86,0\"}, False),\n \"missing_material_stone_vs_bricks\": ({\"build:mazons:3a21\"}, False),\n \"station_radius_edge\": ({\"build:mazons:62c4\"}, False),\n \"null_board_cooling\": (set(), True),\n}\nfor f in sorted(glob.glob(\"metrics/corpus-*20261017-22*.jsonl\")):\n    rows = [json.loads(l) for l in open(f)]\n    print(\"==\", f.split(\"/\")[-1])\n    mixed = []\n    for sc in GT:\n        forbid, null_true = GT[sc]\n        rs = [r for r in rows if r[\"scenario\"] == sc]\n        # argmax content stats\n        argmax_forbid = argmax_ok = 0\n        for r in rs:\n            probs = r.get(\"option_probs\") or {}\n            if not probs: continue\n            top = max(probs, key=probs.get)\n            if top in forbid: argmax_forbid += 1\n            elif not null_true: argmax_ok += 1\n        # flip across permutations within a trial (by argmax)\n        flips = groups = 0\n        by_trial = {}\n        for r in rs:\n            probs = r.get(\"option_probs\") or {}\n            if not probs: continue\n            by_trial.setdefault(r[\"trial\"], set()).add(max(probs, key=probs.get))\n        for choices in by_trial.values():\n            groups += 1\n            if len(choices) > 1: flips += 1\n        print(f\"  {sc:36s} argmax_forbidden={argmax_forbid}/{len(rs)}  argmax_permitted={argmax_ok}/{len(rs)}  argmax_flip_rate={flips}/{groups}\")\n    for r in rows:\n        _, null_true = GT[r[\"scenario\"]]\n        if r.get(\"p_yes\") is not None:\n            mixed.append({\"coverage_confidence\": r[\"p_yes\"], \"null_ground_truth\": null_true})\n    print(\"  cross-scenario null_auc:\", null_auc(mixed))\nEOF","cwd":"sidecar"}}}
