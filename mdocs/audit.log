ck:\n    sidecar.stdin.write(req); sidecar.stdin.flush()\nfinished = done.wait(timeout=20)\nfor proc in (mock, sidecar):\n    try:\n        proc.terminate(); proc.wait(timeout=5)\n    except Exception:\n        proc.kill()\n\nif not finished or \"response\" not in seen:\n    print(\"SMOKE FAIL: no decide response\")\n    sys.exit(1)\ncontent = seen[\"response\"].get(\"result\", {}).get(\"content\", [])\nsummary = json.loads(content[0][\"text\"]) if content else {}\nprint(\"decide summary:\", json.dumps(summary))\nok = summary.get(\"decision\") == \"claim\" and summary.get(\"task\") == \"build:mazons:7d2f\"\nprint(\"placeholder smoke:\", \"PASS\" if ok else \"FAIL ({{build_key}} did not resolve)\")\nsys.exit(0 if ok else 1)\n","path":"/tmp/placeholder-smoke.py"}}}
