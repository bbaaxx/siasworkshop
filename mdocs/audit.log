{"timestamp":"2026-10-17T04:37:59.777Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"import com.siaws.siawsmod.content.mcp.McpSidecar;\nimport com.siaws.siawsmod.data.ModDataGenerators;","oldString":"import com.siaws.siawsmod.data.ModDataGenerators;","path":"src/main/java/com/siaws/siawsmod/SiasWorkshop.java"}}}
{"timestamp":"2026-10-17T04:39:01.064Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Sia's Workshop MCP sidecar (S1 bridge) — the real child-role process the mod spawns.\n\nTopology (reference/mcp-pattern-tree-design D1/D2): the mod is the MCP server and owns\nthe tool registry; THIS process is the MCP client + model host. It speaks newline-delimited\nJSON-RPC over its own stdio: requests go to stdout (the mod reads them), responses arrive\non stdin. Single-threaded and strictly sequential: the mod only talks to us inside a\n`decide` call, and our mod-tool requests happen inside that call, so a blocking stdin loop\ncannot deadlock (the mod's server thread is never parked on us).\n\nFlow: initialize handshake -> the mod may tools/list (we offer `decide`) -> mod calls\n`decide(agent)` -> we pull observation/board via mod tools, ask the model (OpenAI-compatible\nendpoint, or --replay scripted replies for offline tests), validate against the catalog,\nexecute claim/rest/say via mod tools, and answer with a small summary JSON.\n\nStdlib only. Never prints the API key.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport itertools\nimport json\nimport sys\n\nfrom catalog import (S0_TOOLS, by_wire, check_args, first_json_object, render_native,\n                     render_prompt)\nfrom model import FakeModel, OpenAiChat, profile_for\n\n\nclass ModPeer:\n    \"\"\"JSON-RPC peer on our own stdio: send requests on stdout, read traffic on stdin.\"\"\"\n\n    def __init__(self):\n        self._reader = sys.stdin.buffer\n        self._writer = sys.stdout.buffer\n        self._ids = itertools.count(1)\n        self._pending: dict[int, dict] = {}\n\n    def _send(self, msg: dict):\n        self._writer.write(json.dumps(msg).encode() + b\"\\n\")\n        self._writer.flush()\n\n    def request(self, method: str, params: dict | None = None) -> dict:\n        msg_id = next(self._ids)\n        msg = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"method\": method}\n        if params is not None:\n            msg[\"params\"] = params\n        self._send(msg)\n        while True:\n            reply = self.recv()\n            if reply is None:\n                raise RuntimeError(\"mod closed the pipe\")\n            if reply.get(\"id\") == msg_id and (reply.get(\"result\") is not None or reply.get(\"error\") is not None):\n                if reply.get(\"error\") is not None:\n                    raise RuntimeError(f\"mod rejected {method}: {reply['error']}\")\n                return reply[\"result\"]\n            # anything else inbound here is unexpected mid-request; ignore defensively\n\n    def respond(self, msg_id, result):\n        self._send({\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": result})\n\n    def notify(self, method: str, params: dict | None = None):\n        msg = {\"jsonrpc\": \"2.0\", \"method\": method}\n        if params is not None:\n            msg[\"params\"] = params\n        self._send(msg)\n\n    def recv(self) -> dict | None:\n        line = self._reader.readline()\n        if not line:\n            return None\n        line = line.strip()\n        if not line:\n            return {}\n        try:\n            return json.loads(line.decode())\n        except ValueError:\n            return {}\n\n\ndef call_mod_tool(peer: ModPeer, name: str, args: dict) -> dict:\n    result = peer.request(\"tools/call\", {\"name\": name, \"arguments\": args})\n    content = result.get(\"content\") or []\n    text = \"\\n\".join(c.get(\"text\", \"\") for c in content if c.get(\"type\") == \"text\")\n    parsed = None\n    try:\n        parsed = json.loads(text) if text.strip() else None\n    except ValueError:\n        parsed = None\n    body = parsed if isinstance(parsed, dict) else {\"raw\": text}\n    if result.get(\"isError\"):\n        raise RuntimeError(f\"mod tool {name} rejected: {body}\")\n    return body\n\n\ndef decide(peer: ModPeer, model, model_tag: str, args: dict, mode: str,\n           temperature: float, max_tokens: int) -> dict:\n    agent = args.get(\"agent\", \"\")\n    obs = call_mod_tool(peer, \"observe_self\", {\"agent\": agent})\n    board = call_mod_tool(peer, \"observe_board\", {})\n    observation = obs.get(\"observation\", \"\")\n    open_lines = list(board.get(\"open_tasks\") or [])\n    open_keys = [line.split(\" — \")[0] for line in open_lines]\n\n    if mode == \"native\":\n        messages = [\n            {\"role\": \"system\", \"content\":\n                \"You control a Minecraft villager-agent. Observe the situation, then call exactly \"\n                \"one tool to decide: claim a task, rest, or say something.\"},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")},\n        ]\n        reply = model.chat(model_tag, messages, tools=render_native(),\n                           temperature=temperature, max_tokens=max_tokens)\n        if not reply.ok or not reply.tool_calls:\n            return {\"decision\": \"error\", \"detail\": reply.error or \"no_tool_call\"}\n        call = reply.tool_calls[0]\n        tool, call_args = call[\"name\"], call[\"args\"]\n    else:\n        messages = [\n            {\"role\": \"system\", \"content\": render_prompt()},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")\n             + '\\n\\nDecide: reply with exactly one JSON object {\"tool\":\"<id>\",\"args\":{...}}.'},\n        ]\n        reply = model.chat(model_tag, messages, temperature=temperature, max_tokens=max_tokens)\n        if not reply.ok:\n            return {\"decision\": \"error\", \"detail\": reply.error or \"unknown\"}\n        candidate = first_json_object(reply.content or \"\")\n        if candidate is None or not isinstance(candidate.get(\"tool\"), str):\n            return {\"decision\": \"error\", \"detail\": \"malformed_json\"}\n        tool = candidate[\"tool\"]\n        call_args = candidate.get(\"args\") if isinstance(candidate.get(\"args\"), dict) else {}\n\n    catalog_tool = by_wire(tool)\n    if catalog_tool is None:\n        return {\"decision\": \"error\", \"detail\": f\"unknown_tool:{tool}\"}\n    arg_err = check_args(catalog_tool.inputs, call_args)\n    if arg_err:\n        return {\"decision\": \"error\", \"detail\": f\"bad_args:{tool}:{arg_err}\"}\n\n    exec_args = dict(call_args)\n    if tool in (\"claim\", \"rest\", \"say\"):\n        exec_args[\"agent\"] = agent\n    outcome = call_mod_tool(peer, tool, exec_args)\n    if tool == \"claim\":\n        return {\"decision\": \"claim\", \"task\": outcome.get(\"claimed\", \"\"), \"detail\": json.dumps(outcome)}\n    return {\"decision\": tool, \"detail\": json.dumps(outcome)}\n\n\ndef serve(peer: ModPeer, model, model_tag: str, mode: str, temperature: float, max_tokens: int) -> None:\n    # client-role handshake: we initiate, the mod answers on our stdin\n    peer.request(\"initialize\", {\n        \"protocolVersion\": \"2025-06-18\",\n        \"capabilities\": {\"tools\": {\"listChanged\": False}},\n        \"clientInfo\": {\"name\": \"siasworkshop-sidecar\", \"version\": \"0.1.0\"},\n    })\n    peer.notify(\"notifications/initialized\")\n    while True:\n        msg = peer.recv()\n        if msg is None:\n            break\n        if msg.get(\"method\") == \"tools/list\" and msg.get(\"id\") is not None:\n            peer.respond(msg[\"id\"], {\"tools\": [{\n                \"name\": \"decide\",\n                \"description\": \"Run one decision cycle for an agent: observe, ask the model, \"\n                               \"execute claim/rest/say. Args: agent=<uuid>.\",\n                \"inputSchema\": {\"type\": \"object\",\n                                \"properties\": {\"agent\": {\"type\": \"string\"}},\n                                \"required\": [\"agent\"]}}]})\n        elif msg.get(\"method\") == \"tools/call\" and msg.get(\"id\") is not None:\n            params = msg.get(\"params\", {})\n            name = params.get(\"name\", \"\")\n            args = params.get(\"arguments\") or {}\n            if name != \"decide\":\n                peer.respond(msg[\"id\"], {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": f\"unknown tool '{name}'\"})}]})\n                continue\n            try:\n                summary = decide(peer, model, model_tag, args, mode, temperature, max_tokens)\n                peer.respond(msg[\"id\"], {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps(summary)}]})\n            except RuntimeError as e:\n                peer.respond(msg[\"id\"], {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": str(e)})}]})\n        # responses to our own requests are consumed inside ModPeer.request\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--endpoint\", default=\"http://127.0.0.1:1234/v1\")\n    ap.add_argument(\"--model\", default=\"prism-ml/bonsai-27b\")\n    ap.add_argument(\"--api-key-env\", default=\"OPENROUTER_API_KEY\")\n    ap.add_argument(\"--mode\", choices=[\"prompt\", \"native\"], default=None,\n                    help=\"model-facing surface (default: the model's profile)\")\n    ap.add_argument(\"--temperature\", type=float, default=None)\n    ap.add_argument(\"--max-tokens\", type=int, default=None)\n    ap.add_argument(\"--replay\", help=\"scripted replies JSON (offline tests; no network)\")\n    args = ap.parse_args()\n\n    profile = profile_for(args.model)\n    mode = args.mode or (\"native\" if profile[\"mode\"] == \"native\" else \"prompt\")\n    temperature = args.temperature if args.temperature is not None else profile.get(\"temperature\", 0.3)\n    max_tokens = args.max_tokens or profile.get(\"max_tokens\", 1024)\n\n    if args.replay:\n        with open(args.replay, encoding=\"utf-8\") as fh:\n            script = json.load(fh)\n        model = FakeModel(script, {})\n        model_tag = mode\n    else:\n        import os\n        api_key = os.environ.get(args.api_key_env) or None\n        model = OpenAiChat(args.endpoint, api_key, timeout_seconds=180)\n        model_tag = args.model\n\n    serve(ModPeer(), model, model_tag, mode, temperature, max_tokens)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","path":"sidecar/sidecar.py"}}}
{"timestamp":"2026-10-17T04:39:01.071Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Sia's Workshop MCP sidecar (S1 bridge) — the real child-role process the mod spawns.\n\nTopology (reference/mcp-pattern-tree-design D1/D2): the mod is the MCP server and owns\nthe tool registry; THIS process is the MCP client + model host. It speaks newline-delimited\nJSON-RPC over its own stdio: requests go to stdout (the mod reads them), responses arrive\non stdin. Single-threaded and strictly sequential: the mod only talks to us inside a\n`decide` call, and our mod-tool requests happen inside that call, so a blocking stdin loop\ncannot deadlock (the mod's server thread is never parked on us).\n\nFlow: initialize handshake -> the mod may tools/list (we offer `decide`) -> mod calls\n`decide(agent)` -> we pull observation/board via mod tools, ask the model (OpenAI-compatible\nendpoint, or --replay scripted replies for offline tests), validate against the catalog,\nexecute claim/rest/say via mod tools, and answer with a small summary JSON.\n\nStdlib only. Never prints the API key.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport itertools\nimport json\nimport sys\n\nfrom catalog import (S0_TOOLS, by_wire, check_args, first_json_object, render_native,\n                     render_prompt)\nfrom model import FakeModel, OpenAiChat, profile_for\n\n\nclass ModPeer:\n    \"\"\"JSON-RPC peer on our own stdio: send requests on stdout, read traffic on stdin.\"\"\"\n\n    def __init__(self):\n        self._reader = sys.stdin.buffer\n        self._writer = sys.stdout.buffer\n        self._ids = itertools.count(1)\n        self._pending: dict[int, dict] = {}\n\n    def _send(self, msg: dict):\n        self._writer.write(json.dumps(msg).encode() + b\"\\n\")\n        self._writer.flush()\n\n    def request(self, method: str, params: dict | None = None) -> dict:\n        msg_id = next(self._ids)\n        msg = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"method\": method}\n        if params is not None:\n            msg[\"params\"] = params\n        self._send(msg)\n        while True:\n            reply = self.recv()\n            if reply is None:\n                raise RuntimeError(\"mod closed the pipe\")\n            if reply.get(\"id\") == msg_id and (reply.get(\"result\") is not None or reply.get(\"error\") is not None):\n                if reply.get(\"error\") is not None:\n                    raise RuntimeError(f\"mod rejected {method}: {reply['error']}\")\n                return reply[\"result\"]\n            # anything else inbound here is unexpected mid-request; ignore defensively\n\n    def respond(self, msg_id, result):\n        self._send({\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": result})\n\n    def notify(self, method: str, params: dict | None = None):\n        msg = {\"jsonrpc\": \"2.0\", \"method\": method}\n        if params is not None:\n            msg[\"params\"] = params\n        self._send(msg)\n\n    def recv(self) -> dict | None:\n        line = self._reader.readline()\n        if not line:\n            return None\n        line = line.strip()\n        if not line:\n            return {}\n        try:\n            return json.loads(line.decode())\n        except ValueError:\n            return {}\n\n\ndef call_mod_tool(peer: ModPeer, name: str, args: dict) -> dict:\n    result = peer.request(\"tools/call\", {\"name\": name, \"arguments\": args})\n    content = result.get(\"content\") or []\n    text = \"\\n\".join(c.get(\"text\", \"\") for c in content if c.get(\"type\") == \"text\")\n    parsed = None\n    try:\n        parsed = json.loads(text) if text.strip() else None\n    except ValueError:\n        parsed = None\n    body = parsed if isinstance(parsed, dict) else {\"raw\": text}\n    if result.get(\"isError\"):\n        raise RuntimeError(f\"mod tool {name} rejected: {body}\")\n    return body\n\n\ndef decide(peer: ModPeer, model, model_tag: str, args: dict, mode: str,\n           temperature: float, max_tokens: int) -> dict:\n    agent = args.get(\"agent\", \"\")\n    obs = call_mod_tool(peer, \"observe_self\", {\"agent\": agent})\n    board = call_mod_tool(peer, \"observe_board\", {})\n    observation = obs.get(\"observation\", \"\")\n    open_lines = list(board.get(\"open_tasks\") or [])\n    open_keys = [line.split(\" — \")[0] for line in open_lines]\n\n    if mode == \"native\":\n        messages = [\n            {\"role\": \"system\", \"content\":\n                \"You control a Minecraft villager-agent. Observe the situation, then call exactly \"\n                \"one tool to decide: claim a task, rest, or say something.\"},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")},\n        ]\n        reply = model.chat(model_tag, messages, tools=render_native(),\n                           temperature=temperature, max_tokens=max_tokens)\n        if not reply.ok or not reply.tool_calls:\n            return {\"decision\": \"error\", \"detail\": reply.error or \"no_tool_call\"}\n        call = reply.tool_calls[0]\n        tool, call_args = call[\"name\"], call[\"args\"]\n    else:\n        messages = [\n            {\"role\": \"system\", \"content\": render_prompt()},\n            {\"role\": \"user\", \"content\": \"OBSERVATION:\\n\" + observation\n             + \"\\n\\nOPEN TASKS:\\n\" + (\"\\n\".join(\"- \" + l for l in open_lines) or \"none\")\n             + '\\n\\nDecide: reply with exactly one JSON object {\"tool\":\"<id>\",\"args\":{...}}.'},\n        ]\n        reply = model.chat(model_tag, messages, temperature=temperature, max_tokens=max_tokens)\n        if not reply.ok:\n            return {\"decision\": \"error\", \"detail\": reply.error or \"unknown\"}\n        candidate = first_json_object(reply.content or \"\")\n        if candidate is None or not isinstance(candidate.get(\"tool\"), str):\n            return {\"decision\": \"error\", \"detail\": \"malformed_json\"}\n        tool = candidate[\"tool\"]\n        call_args = candidate.get(\"args\") if isinstance(candidate.get(\"args\"), dict) else {}\n\n    catalog_tool = by_wire(tool)\n    if catalog_tool is None:\n        return {\"decision\": \"error\", \"detail\": f\"unknown_tool:{tool}\"}\n    arg_err = check_args(catalog_tool.inputs, call_args)\n    if arg_err:\n        return {\"decision\": \"error\", \"detail\": f\"bad_args:{tool}:{arg_err}\"}\n\n    exec_args = dict(call_args)\n    if tool in (\"claim\", \"rest\", \"say\"):\n        exec_args[\"agent\"] = agent\n    outcome = call_mod_tool(peer, tool, exec_args)\n    if tool == \"claim\":\n        return {\"decision\": \"claim\", \"task\": outcome.get(\"claimed\", \"\"), \"detail\": json.dumps(outcome)}\n    return {\"decision\": tool, \"detail\": json.dumps(outcome)}\n\n\ndef serve(peer: ModPeer, model, model_tag: str, mode: str, temperature: float, max_tokens: int) -> None:\n    # client-role handshake: we initiate, the mod answers on our stdin\n    peer.request(\"initialize\", {\n        \"protocolVersion\": \"2025-06-18\",\n        \"capabilities\": {\"tools\": {\"listChanged\": False}},\n        \"clientInfo\": {\"name\": \"siasworkshop-sidecar\", \"version\": \"0.1.0\"},\n    })\n    peer.notify(\"notifications/initialized\")\n    while True:\n        msg = peer.recv()\n        if msg is None:\n            break\n        if msg.get(\"method\") == \"tools/list\" and msg.get(\"id\") is not None:\n            peer.respond(msg[\"id\"], {\"tools\": [{\n                \"name\": \"decide\",\n                \"description\": \"Run one decision cycle for an agent: observe, ask the model, \"\n                               \"execute claim/rest/say. Args: agent=<uuid>.\",\n                \"inputSchema\": {\"type\": \"object\",\n                                \"properties\": {\"agent\": {\"type\": \"string\"}},\n                                \"required\": [\"agent\"]}}]})\n        elif msg.get(\"method\") == \"tools/call\" and msg.get(\"id\") is not None:\n            params = msg.get(\"params\", {})\n            name = params.get(\"name\", \"\")\n            args = params.get(\"arguments\") or {}\n            if name != \"decide\":\n                peer.respond(msg[\"id\"], {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": f\"unknown tool '{name}'\"})}]})\n                continue\n            try:\n                summary = decide(peer, model, model_tag, args, mode, temperature, max_tokens)\n                peer.respond(msg[\"id\"], {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps(summary)}]})\n            except RuntimeError as e:\n                peer.respond(msg[\"id\"], {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": str(e)})}]})\n        # responses to our own requests are consumed inside ModPeer.request\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--endpoint\", default=\"http://127.0.0.1:1234/v1\")\n    ap.add_argument(\"--model\", default=\"prism-ml/bonsai-27b\")\n    ap.add_argument(\"--api-key-env\", default=\"OPENROUTER_API_KEY\")\n    ap.add_argument(\"--mode\", choices=[\"prompt\", \"native\"], default=None,\n                    help=\"model-facing surface (default: the model's profile)\")\n    ap.add_argument(\"--temperature\", type=float, default=None)\n    ap.add_argument(\"--max-tokens\", type=int, default=None)\n    ap.add_argument(\"--replay\", help=\"scripted replies JSON (offline tests; no network)\")\n    args = ap.parse_args()\n\n    profile = profile_for(args.model)\n    mode = args.mode or (\"native\" if profile[\"mode\"] == \"native\" else \"prompt\")\n    temperature = args.temperature if args.temperature is not None else profile.get(\"temperature\", 0.3)\n    max_tokens = args.max_tokens or profile.get(\"max_tokens\", 1024)\n\n    if args.replay:\n        with open(args.replay, encoding=\"utf-8\") as fh:\n            script = json.load(fh)\n        model = FakeModel(script, {})\n        model_tag = mode\n    else:\n        import os\n        api_key = os.environ.get(args.api_key_env) or None\n        model = OpenAiChat(args.endpoint, api_key, timeout_seconds=180)\n        model_tag = args.model\n\n    serve(ModPeer(), model, model_tag, mode, temperature, max_tokens)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","path":"sidecar/sidecar.py"}}}
{"timestamp":"2026-10-17T04:39:48.040Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"[\n  {\n    \"name\": \"bridge_claim\",\n    \"modes\": [\"prompt\"],\n    \"content\": \"{\\\"tool\\\":\\\"claim\\\",\\\"args\\\":{\\\"task\\\":\\\"build:mazons:7d2f\\\"}}\"\n  }\n]\n","path":"sidecar/replay/bridge-script.json"}}}
{"timestamp":"2026-10-17T04:39:48.040Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Bridge test: sidecar.py (client role) against mockmod.py (server role) over crossed\npipes — the exact production topology, no Java required.\n\nThe driver spawns both, relays bytes both ways (line-locked), injects one tools/call\ndecide as the mod would, and asserts the decide summary reports the claimed task.\n\nRun: python3 test_sidecar_bridge.py\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport threading\nimport time\n\nHERE = os.path.dirname(os.path.abspath(__file__))\n\n\ndef main() -> int:\n    mock = subprocess.Popen([sys.executable, os.path.join(HERE, \"mockmod.py\"),\n                             os.path.join(HERE, \"scenarios/stone_bricks_chest.json\")],\n                            stdin=subprocess.PIPE, stdout=subprocess.PIPE)\n    sidecar = subprocess.Popen([sys.executable, os.path.join(HERE, \"sidecar.py\"),\n                                \"--replay\", os.path.join(HERE, \"replay/bridge-script.json\")],\n                               stdin=subprocess.PIPE, stdout=subprocess.PIPE)\n    write_lock = threading.Lock()\n    seen = {\"initialize\": False, \"initialized\": False, \"response\": None}\n    done = threading.Event()\n\n    def relay(src, dst, tag):\n        for line in src:\n            with write_lock:\n                dst.write(line)\n                dst.flush()\n            text = line.decode(errors=\"replace\").strip()\n            if tag == \"s2m\" and '\"method\": \"initialize\"' in text.replace(\" \", \"\"):\n                seen[\"initialize\"] = True\n            if tag == \"s2m\" and \"notifications/initialized\" in text:\n                seen[\"initialized\"] = True\n            if tag == \"s2m\" and '\"id\": 99' in text.replace(\" \", \"\") and '\"result\"' in text.replace(\" \", \"\"):\n                try:\n                    seen[\"response\"] = json.loads(text)\n                except ValueError:\n                    pass\n                done.set()\n        done.set()\n\n    threads = [\n        threading.Thread(target=relay, args=(sidecar.stdout, mock.stdin, \"s2m\"), daemon=True),\n        threading.Thread(target=relay, args=(mock.stdout, sidecar.stdin, \"m2s\"), daemon=True),\n    ]\n    for t in threads:\n        t.start()\n\n    time.sleep(0.7)  # handshake first\n    decide_request = (json.dumps({\"jsonrpc\": \"2.0\", \"id\": 99, \"method\": \"tools/call\",\n                                  \"params\": {\"name\": \"decide\",\n                                             \"arguments\": {\"agent\": \"agent-1\"}}}) + \"\\n\").encode()\n    with write_lock:\n        sidecar.stdin.write(decide_request)\n        sidecar.stdin.flush()\n\n    finished = done.wait(timeout=20)\n    for proc in (mock, sidecar):\n        try:\n            proc.terminate()\n            proc.wait(timeout=5)\n        except Exception:\n            proc.kill()\n\n    failures = 0\n    if not seen[\"initialize\"]:\n        failures += 1\n        print(\"FAIL: sidecar never sent initialize\")\n    if not seen[\"initialized\"]:\n        failures += 1\n        print(\"FAIL: initialized notification never seen\")\n    if not finished or seen[\"response\"] is None:\n        failures += 1\n        print(\"FAIL: no decide response captured\")\n    else:\n        content = seen[\"response\"].get(\"result\", {}).get(\"content\", [])\n        summary = json.loads(content[0][\"text\"]) if content else {}\n        print(\"decide summary:\", json.dumps(summary))\n        if summary.get(\"decision\") != \"claim\" or summary.get(\"task\") != \"build:mazons:7d2f\":\n            failures += 1\n            print(f\"FAIL: expected claim of build:mazons:7d2f, got {summary}\")\n    print(\"bridge test:\", \"PASS\" if failures == 0 else f\"{failures} failures\")\n    return 1 if failures else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","path":"sidecar/test_sidecar_bridge.py"}}}
