Z();\n        String detail = DETAIL_FORMAT.formatted(name, anchor.getX(), anchor.getY(), anchor.getZ());\n        return AgentWorldData.board(level).raiseIfAbsent(key, BoardTask.Type.BUILD, detail, level.getGameTime());\n    }\n\n    /** A parsed build job. */\n    public record BuildJob(String blueprintName, BlockPos anchor) {}\n\n    /**\n     * Parses the job description back out of a BUILD task's key/detail. Returns null when the\n     * task is not a BUILD task or the description is malformed — the caller then fails the\n     * task as {@code malformed_job}.\n     */\n    @Nullable\n    public static BuildJob parseJob(BoardTask task) {\n        if (task.type() != BoardTask.Type.BUILD) {\n            return null;\n        }\n        String detail = task.detail();\n        String blueprint = null;\n        BlockPos anchor = null;\n        for (String field : detail.split(\" \")) {\n            if (field.startsWith(\"blueprint=\")) {\n                blueprint = field.substring(\"blueprint=\".length());\n            } else if (field.startsWith(\"anchor=\")) {\n                anchor = parsePos(field.substring(\"anchor=\".length()));\n            }\n        }\n        if (blueprint == null || blueprint.isEmpty() || anchor == null) {\n            return null;\n        }\n        return new BuildJob(blueprint, anchor);\n    }\n\n    @Nullable\n    private static BlockPos parsePos(String value) {\n        String[] parts = value.split(\",\");\n        if (parts.length != 3) {\n            return null;\n        }\n        try {\n            return new BlockPos(Integer.parseInt(parts[0].trim()),\n                    Integer.parseInt(parts[1].trim()), Integer.parseInt(parts[2].trim()));\n        } catch (NumberFormatException e) {\n            return null;\n        }\n    }\n\n    /** Lowercase tokens of the blueprint name, used as style-tag candidates for card retrieval. */\n    public static java.util.Set<String> nameTokens(String blueprintName) {\n        java.util.Set<String> tokens = new java.util.HashSet<>();\n        for (String token : blueprintName.toLowerCase(Locale.ROOT).split(\"[^a-z0-9]+\")) {\n            if (!token.isEmpty()) {\n                tokens.add(token);\n            }\n        }\n        return tokens;\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BuildQueue.java"}}}
{"timestamp":"2026-10-14T19:40:09.364Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"write","args":{"content":"package com.siaws.siawsmod.content.agents.build;\n\nimport java.util.List;\nimport java.util.Map;\n\nimport net.minecraft.core.Vec3i;\n\n/**\n * One build card from the RAG corpus (design pillar 4 \"Build cards\"): a distilled build idea\n * datapacks can add under {@code data/<ns>/siasworkshop_build_cards/*.json}. The card is\n * grounded facts only — sizes, materials, palettes — never copied prose; the LLM selects and\n * adapts, it never fetches (retrieve-and-inject).\n *\n * @param name           unique-ish display name\n * @param styleTags      retrieval tags (e.g. defense, storage, cherry)\n * @param size           footprint width×height×length\n * @param materialsList  block id → count\n * @param palette        block ids the build uses\n * @param stepSummary    short procedural summary in our own words\n * @param sourceNote     where the idea came from (guide, player, own design)\n */\npublic record BuildCard(\n        String name,\n        List<String> styleTags,\n        Vec3i size,\n        Map<String, Integer> materialsList,\n        List<String> palette,\n        String stepSummary,\n        String sourceNote) {\n\n    public BuildCard {\n        styleTags = List.copyOf(styleTags);\n        materialsList = Map.copyOf(materialsList);\n        palette = List.copyOf(palette);\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BuildCard.java"}}}
{"timestamp":"2026-10-14T19:40:09.361Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"write","args":{"content":"package com.siaws.siawsmod.content.agents.build;\n\nimport java.util.List;\nimport java.util.Map;\n\nimport net.minecraft.core.Vec3i;\n\n/**\n * One build card from the RAG corpus (design pillar 4 \"Build cards\"): a distilled build idea\n * datapacks can add under {@code data/<ns>/siasworkshop_build_cards/*.json}. The card is\n * grounded facts only — sizes, materials, palettes — never copied prose; the LLM selects and\n * adapts, it never fetches (retrieve-and-inject).\n *\n * @param name           unique-ish display name\n * @param styleTags      retrieval tags (e.g. defense, storage, cherry)\n * @param size           footprint width×height×length\n * @param materialsList  block id → count\n * @param palette        block ids the build uses\n * @param stepSummary    short procedural summary in our own words\n * @param sourceNote     where the idea came from (guide, player, own design)\n */\npublic record BuildCard(\n        String name,\n        List<String> styleTags,\n        Vec3i size,\n        Map<String, Integer> materialsList,\n        List<String> palette,\n        String stepSummary,\n        String sourceNote) {\n\n    public BuildCard {\n        styleTags = List.copyOf(styleTags);\n        materialsList = Map.copyOf(materialsList);\n        palette = List.copyOf(palette);\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BuildCard.java"}}}
{"timestamp":"2026-10-14T19:40:42.680Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"write","args":{"content":"package com.siaws.siawsmod.content.agents.build;\n\nimport java.io.IOException;\nimport java.io.Reader;\nimport java.util.ArrayList;\nimport java.util.Comparator;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Set;\n\nimport javax.annotation.Nullable;\n\nimport com.google.gson.JsonElement;\nimport com.google.gson.JsonObject;\nimport com.google.gson.JsonParser;\nimport com.siaws.siawsmod.SiasWorkshop;\n\nimport net.minecraft.core.Vec3i;\nimport net.minecraft.resources.ResourceLocation;\nimport net.minecraft.server.packs.resources.ResourceManager;\nimport net.minecraft.server.packs.resources.SimplePreparableReloadListener;\nimport net.minecraft.util.profiling.ProfilerFiller;\n\n/**\n * The build-card corpus loader (design pillar 4, \"Build cards (the RAG corpus)\"): datapack\n * JSON under {@code data/<ns>/siasworkshop_build_cards/*.json}, reloaded with the datapacks\n * via {@code AddReloadListenerEvent}. Parsing is defensive — a bad card costs one WARN line\n * and is skipped. At decision time the loop retrieves 1–3 cards by style-tag overlap and\n * injects them into the prompt ({@link com.siaws.siawsmod.content.llm.LlmPrompts}).\n *\n * <p>Card JSON: {@code {name, style_tags:[], size:\"WxHxL\"|{w,h,l}, materials_list:{id:count},\n * palette:[], step_summary:\"\", source_note:\"\"}}.\n */\npublic final class BuildCards extends SimplePreparableReloadListener<Map<ResourceLocation, BuildCard>> {\n    public static final BuildCards INSTANCE = new BuildCards();\n    public static final String FOLDER = \"siasworkshop_build_cards\";\n\n    private volatile Map<ResourceLocation, BuildCard> cards = Map.of();\n\n    private BuildCards() {}\n\n    /** All loaded cards, in datapack order. */\n    public List<BuildCard> getCards() {\n        return List.copyOf(cards.values());\n    }\n\n    /** Ranked retrieval: most style-tag overlap first, then resource id for stability. */\n    public List<BuildCard> retrieve(Set<String> styleTags, int max) {\n        return cards.entrySet().stream()\n                .filter(entry -> !styleTags.isEmpty())\n                .map(entry -> new Object() {\n                    final ResourceLocation id = entry.getKey();\n                    final BuildCard card = entry.getValue();\n                    final int overlap = (int) card.styleTags().stream().filter(styleTags::contains).count();\n                })\n                .filter(hit -> hit.overlap > 0)\n                .sorted(Comparator.comparingInt((Object hit) -> ((hitClass) null) == null ? 0 : 0)\n                        .thenComparing(hit -> 0))\n                .map(hit -> hit.card)\n                .limit(max)\n                .toList();\n    }\n\n    @Override\n    protected Map<ResourceLocation, BuildCard> prepare(ResourceManager resourceManager, ProfilerFiller profiler) {\n        Map<ResourceLocation, BuildCard> loaded = new LinkedHashMap<>();\n        for (Map.Entry<ResourceLocation, net.minecraft.server.packs.resources.Resource> entry\n                : resourceManager.listResources(FOLDER, id -> id.getPath().endsWith(\".json\")).entrySet()) {\n            ResourceLocation id = entry.getKey();\n            try (Reader reader = entry.getValue().openAsReader()) {\n                BuildCard card = parseCard(JsonParser.parseReader(reader).toString(), id.toString());\n                loaded.put(id, card);\n            } catch (RuntimeException | IOException e) {\n                SiasWorkshop.LOGGER.warn(\"[BuildCards] skipping {}: {}\", id, e.getMessage());\n            }\n        }\n        return loaded;\n    }\n\n    @Override\n    protected void apply(Map<ResourceLocation, BuildCard> prepared, ResourceManager resourceManager,\n            ProfilerFiller profiler) {\n        this.cards = Map.copyOf(prepared);\n        if (!cards.isEmpty()) {\n            SiasWorkshop.LOGGER.info(\"[BuildCards] loaded {} build card(s)\", cards.size());\n        }\n    }\n\n    /**\n     * Parses one card from a JSON string (datapack file contents or tests). Throws\n     * {@link IllegalArgumentException} naming the source when anything required is missing\n     * or malformed.\n     */\n    public static BuildCard parseCard(String json, String sourceName) {\n        final String source = sourceName;\n        JsonObject root;\n        try {\n            JsonElement element = JsonParser.parseString(json);\n            if (!element.isJsonObject()) {\n                throw new IllegalArgumentException(source + \": not a JSON object\");\n            }\n            root = element.getAsJsonObject();\n        } catch (RuntimeException e) {\n            throw new IllegalArgumentException(source + \": invalid JSON (\" + e.getMessage() + \")\");\n        }\n\n        String name = requiredString(root, \"name\", source);\n        List<String> styleTags = stringArray(root, \"style_tags\", source);\n        Vec3i size = parseSize(root.get(\"size\"), source);\n        Map<String, Integer> materials = new LinkedHashMap<>();\n        if (root.has(\"materials_list\") && root.get(\"materials_list\").isJsonObject()) {\n            for (Map.Entry<String, JsonElement> entry : root.getAsJsonObject(\"materials_list\").entrySet()) {\n                try {\n                    materials.put(entry.getKey(), entry.getValue().getAsInt());\n                } catch (RuntimeException e) {\n                    throw new IllegalArgumentException(source + \": materials_list.\" + entry.getKey() + \" is not an int\");\n                }\n            }\n        }\n        List<String> palette = stringArray(root, \"palette\", source);\n        String stepSummary = root.has(\"step_summary\") && root.get(\"step_summary\").isJsonPrimitive()\n                ? root.get(\"step_summary\").getAsString()\n                : \"\";\n        String sourceNote = root.has(\"source_note\") && root.get(\"source_note\").isJsonPrimitive()\n                ? root.get(\"source_note\").getAsString()\n                : \"\";\n        return new BuildCard(name, styleTags, size, materials, palette, stepSummary, sourceNote);\n    }\n\n    private static String requiredString(JsonObject root, String key, String source) {\n        if (!root.has(key) || !root.get(key).isJsonPrimitive()) {\n            throw new IllegalArgumentException(source + \": missing \" + key);\n        }\n        return root.get(key).getAsString();\n    }\n\n    private static List<String> stringArray(JsonObject root, String key, String source) {\n        if (!root.has(key) || !root.get(key).isJsonArray()) {\n            throw new IllegalArgumentException(source + \": missing \" + key);\n        }\n        List<String> values = new ArrayList<>();\n        for (JsonElement element : root.getAsJsonArray(key)) {\n            values.add(element.getAsString());\n        }\n        return values;\n    }\n\n    private static Vec3i parseSize(@Nullable JsonElement element, String source) {\n        if (element == null || element.isJsonNull()) {\n            throw new IllegalArgumentException(source + \": missing size\");\n        }\n        try {\n            if (element.isJsonPrimitive()) {\n                String[] parts = element.getAsString().split(\"x\");\n                if (parts.length != 3) {\n                    throw new IllegalArgumentException(source + \": size must be WxHxL\");\n                }\n                return new Vec3i(Integer.parseInt(parts[0].trim()),\n                        Integer.parseInt(parts[1].trim()), Integer.parseInt(parts[2].trim()));\n            }\n            JsonObject object = element.getAsJsonObject();\n            return new Vec3i(object.get(\"w\").getAsInt(), object.get(\"h\").getAsInt(), object.get(\"l\").getAsInt());\n        } catch (RuntimeException | IllegalArgumentException e) {\n            throw new IllegalArgumentException(source + \": malformed size (\" + e.getMessage() + \")\");\n        }\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BuildCards.java"}}}
{"timestamp":"2026-10-14T19:40:42.684Z","type":"tool","initiativeId":"agents-v1-llm-build-knowledge--2026-10-14","step":"EXECUTE","details":{"toolName":"write","args":{"content":"package com.siaws.siawsmod.content.agents.build;\n\nimport java.io.IOException;\nimport java.io.Reader;\nimport java.util.ArrayList;\nimport java.util.Comparator;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Set;\n\nimport javax.annotation.Nullable;\n\nimport com.google.gson.JsonElement;\nimport com.google.gson.JsonObject;\nimport com.google.gson.JsonParser;\nimport com.siaws.siawsmod.SiasWorkshop;\n\nimport net.minecraft.core.Vec3i;\nimport net.minecraft.resources.ResourceLocation;\nimport net.minecraft.server.packs.resources.ResourceManager;\nimport net.minecraft.server.packs.resources.SimplePreparableReloadListener;\nimport net.minecraft.util.profiling.ProfilerFiller;\n\n/**\n * The build-card corpus loader (design pillar 4, \"Build cards (the RAG corpus)\"): datapack\n * JSON under {@code data/<ns>/siasworkshop_build_cards/*.json}, reloaded with the datapacks\n * via {@code AddReloadListenerEvent}. Parsing is defensive — a bad card costs one WARN line\n * and is skipped. At decision time the loop retrieves 1–3 cards by style-tag overlap and\n * injects them into the prompt ({@link com.siaws.siawsmod.content.llm.LlmPrompts}).\n *\n * <p>Card JSON: {@code {name, style_tags:[], size:\"WxHxL\"|{w,h,l}, materials_list:{id:count},\n * palette:[], step_summary:\"\", source_note:\"\"}}.\n */\npublic final class BuildCards extends SimplePreparableReloadListener<Map<ResourceLocation, BuildCard>> {\n    public static final BuildCards INSTANCE = new BuildCards();\n    public static final String FOLDER = \"siasworkshop_build_cards\";\n\n    private volatile Map<ResourceLocation, BuildCard> cards = Map.of();\n\n    private BuildCards() {}\n\n    /** All loaded cards, in datapack order. */\n    public List<BuildCard> getCards() {\n        return List.copyOf(cards.values());\n    }\n\n    /** Ranked retrieval: most style-tag overlap first, then resource id for stability. */\n    public List<BuildCard> retrieve(Set<String> styleTags, int max) {\n        return cards.entrySet().stream()\n                .filter(entry -> !styleTags.isEmpty())\n                .map(entry -> new Object() {\n                    final ResourceLocation id = entry.getKey();\n                    final BuildCard card = entry.getValue();\n                    final int overlap = (int) card.styleTags().stream().filter(styleTags::contains).count();\n                })\n                .filter(hit -> hit.overlap > 0)\n                .sorted(Comparator.comparingInt((Object hit) -> ((hitClass) null) == null ? 0 : 0)\n                        .thenComparing(hit -> 0))\n                .map(hit -> hit.card)\n                .limit(max)\n                .toList();\n    }\n\n    @Override\n    protected Map<ResourceLocation, BuildCard> prepare(ResourceManager resourceManager, ProfilerFiller profiler) {\n        Map<ResourceLocation, BuildCard> loaded = new LinkedHashMap<>();\n        for (Map.Entry<ResourceLocation, net.minecraft.server.packs.resources.Resource> entry\n                : resourceManager.listResources(FOLDER, id -> id.getPath().endsWith(\".json\")).entrySet()) {\n            ResourceLocation id = entry.getKey();\n            try (Reader reader = entry.getValue().openAsReader()) {\n                BuildCard card = parseCard(JsonParser.parseReader(reader).toString(), id.toString());\n                loaded.put(id, card);\n            } catch (RuntimeException | IOException e) {\n                SiasWorkshop.LOGGER.warn(\"[BuildCards] skipping {}: {}\", id, e.getMessage());\n            }\n        }\n        return loaded;\n    }\n\n    @Override\n    protected void apply(Map<ResourceLocation, BuildCard> prepared, ResourceManager resourceManager,\n            ProfilerFiller profiler) {\n        this.cards = Map.copyOf(prepared);\n        if (!cards.isEmpty()) {\n            SiasWorkshop.LOGGER.info(\"[BuildCards] loaded {} build card(s)\", cards.size());\n        }\n    }\n\n    /**\n     * Parses one card from a JSON string (datapack file contents or tests). Throws\n     * {@link IllegalArgumentException} naming the source when anything required is missing\n     * or malformed.\n     */\n    public static BuildCard parseCard(String json, String sourceName) {\n        final String source = sourceName;\n        JsonObject root;\n        try {\n            JsonElement element = JsonParser.parseString(json);\n            if (!element.isJsonObject()) {\n                throw new IllegalArgumentException(source + \": not a JSON object\");\n            }\n            root = element.getAsJsonObject();\n        } catch (RuntimeException e) {\n            throw new IllegalArgumentException(source + \": invalid JSON (\" + e.getMessage() + \")\");\n        }\n\n        String name = requiredString(root, \"name\", source);\n        List<String> styleTags = stringArray(root, \"style_tags\", source);\n        Vec3i size = parseSize(root.get(\"size\"), source);\n        Map<String, Integer> materials = new LinkedHashMap<>();\n        if (root.has(\"materials_list\") && root.get(\"materials_list\").isJsonObject()) {\n            for (Map.Entry<String, JsonElement> entry : root.getAsJsonObject(\"materials_list\").entrySet()) {\n                try {\n                    materials.put(entry.getKey(), entry.getValue().getAsInt());\n                } catch (RuntimeException e) {\n                    throw new IllegalArgumentException(source + \": materials_list.\" + entry.getKey() + \" is not an int\");\n                }\n            }\n        }\n        List<String> palette = stringArray(root, \"palette\", source);\n        String stepSummary = root.has(\"step_summary\") && root.get(\"step_summary\").isJsonPrimitive()\n                ? root.get(\"step_summary\").getAsString()\n                : \"\";\n        String sourceNote = root.has(\"source_note\") && root.get(\"source_note\").isJsonPrimitive()\n                ? root.get(\"source_note\").getAsString()\n                : \"\";\n        return new BuildCard(name, styleTags, size, materials, palette, stepSummary, sourceNote);\n    }\n\n    private static String requiredString(JsonObject root, String key, String source) {\n        if (!root.has(key) || !root.get(key).isJsonPrimitive()) {\n            throw new IllegalArgumentException(source + \": missing \" + key);\n        }\n        return root.get(key).getAsString();\n    }\n\n    private static List<String> stringArray(JsonObject root, String key, String source) {\n        if (!root.has(key) || !root.get(key).isJsonArray()) {\n            throw new IllegalArgumentException(source + \": missing \" + key);\n        }\n        List<String> values = new ArrayList<>();\n        for (JsonElement element : root.getAsJsonArray(key)) {\n            values.add(element.getAsString());\n        }\n        return values;\n    }\n\n    private static Vec3i parseSize(@Nullable JsonElement element, String source) {\n        if (element == null || element.isJsonNull()) {\n            throw new IllegalArgumentException(source + \": missing size\");\n        }\n        try {\n            if (element.isJsonPrimitive()) {\n                String[] parts = element.getAsString().split(\"x\");\n                if (parts.length != 3) {\n                    throw new IllegalArgumentException(source + \": size must be WxHxL\");\n                }\n                return new Vec3i(Integer.parseInt(parts[0].trim()),\n                        Integer.parseInt(parts[1].trim()), Integer.parseInt(parts[2].trim()));\n            }\n            JsonObject object = element.getAsJsonObject();\n            return new Vec3i(object.get(\"w\").getAsInt(), object.get(\"h\").getAsInt(), object.get(\"l\").getAsInt());\n        } catch (RuntimeException | IllegalArgumentException e) {\n            throw new IllegalArgumentException(source + \": malformed size (\" + e.getMessage() + \")\");\n        }\n    }\n}\n","path":"src/main/java/com/siaws/siawsmod/content/agents/build/BuildCards.java"}}}
