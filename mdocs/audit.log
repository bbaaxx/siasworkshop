erage\": {\"any_claimable\": True, \"confidence\": 70}}\n        if not keys:\n            reply = {\"tool\": \"rest\", \"args\": {},\n                     \"coverage\": {\"any_claimable\": False, \"confidence\": 80}}\n        return ModelReply(ok=True, content=json.dumps(reply),\n                          prompt_tokens=200, completion_tokens=10, latency_ms=1)","path":"sidecar/test_corpus.py"}}}
