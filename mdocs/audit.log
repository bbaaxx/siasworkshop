{"timestamp":"2026-10-08T20:10:36.009Z","type":"tool","step":"COMPLETE","details":{"toolName":"edit","args":{"newString":"      - name: Build with Gradle\n        run: ./gradlew build\n\n      - name: Upload mod jar\n        uses: actions/upload-artifact@v4\n        with:\n          name: siasworkshop-${{ github.ref_name }}\n          path: build/libs/\n          if-no-files-found: error\n\n  # The 1.20.1 line is Forge-compatible both ways: this job compiles the same\n  # sources against MinecraftForge (net.minecraftforge) to catch accidental\n  # NeoForge-only API usage. The published reobf jar is loader-agnostic.\n  build-minecraftforge:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Setup JDK 17\n        uses: actions/setup-java@v4\n        with:\n          java-version: '17'\n          distribution: 'temurin'\n\n      - name: Setup Gradle\n        uses: gradle/actions/setup-gradle@v4\n\n      - name: Make Gradle wrapper executable\n        run: chmod +x ./gradlew\n\n      - name: Build against MinecraftForge\n        run: ./gradlew build -Puse_minecraftforge\n","oldString":"      - name: Build with Gradle\n        run: ./gradlew build\n\n      - name: Upload mod jar\n        uses: actions/upload-artifact@v4\n        with:\n          name: siasworkshop-${{ github.ref_name }}\n          path: build/libs/\n          if-no-files-found: error\n","path":".github/workflows/build.yml"}}}
{"timestamp":"2026-10-08T20:10:36.013Z","type":"tool","step":"COMPLETE","details":{"toolName":"edit","args":{"newString":"      - name: Build with Gradle\n        run: ./gradlew build\n\n      - name: Upload mod jar\n        uses: actions/upload-artifact@v4\n        with:\n          name: siasworkshop-${{ github.ref_name }}\n          path: build/libs/\n          if-no-files-found: error\n\n  # The 1.20.1 line is Forge-compatible both ways: this job compiles the same\n  # sources against MinecraftForge (net.minecraftforge) to catch accidental\n  # NeoForge-only API usage. The published reobf jar is loader-agnostic.\n  build-minecraftforge:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Setup JDK 17\n        uses: actions/setup-java@v4\n        with:\n          java-version: '17'\n          distribution: 'temurin'\n\n      - name: Setup Gradle\n        uses: gradle/actions/setup-gradle@v4\n\n      - name: Make Gradle wrapper executable\n        run: chmod +x ./gradlew\n\n      - name: Build against MinecraftForge\n        run: ./gradlew build -Puse_minecraftforge\n","oldString":"      - name: Build with Gradle\n        run: ./gradlew build\n\n      - name: Upload mod jar\n        uses: actions/upload-artifact@v4\n        with:\n          name: siasworkshop-${{ github.ref_name }}\n          path: build/libs/\n          if-no-files-found: error\n","path":".github/workflows/build.yml"}}}
