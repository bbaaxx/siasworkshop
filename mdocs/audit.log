{"timestamp":"2026-10-17T03:53:27.137Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"def first_json_object(text: str) -> dict | None:\n    \"\"\"First {...} span parsed (fence/prose tolerant); mirrors LlmActions.parseJsonObject.\"\"\"\n    if text is None:\n        return None\n    trimmed = text.strip()\n    if not trimmed:\n        return None\n    for candidate in (trimmed,):\n        try:\n            val = json.loads(candidate)\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            pass\n    start, end = trimmed.find(\"{\"), trimmed.rfind(\"}\")\n    if start >= 0 and end > start:\n        try:\n            val = json.loads(trimmed[start:end + 1])\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            return None\n    return None\n\n\n# --- S2: the building walk (first real pattern tree) ---------------------------\n# Reference walk from mcp-pattern-tree-design.md; children wiring implements D5\n# situational gating — a pattern's card only offers the children valid right now.\n\nBUILDING_WALK_TOOLS: list[Tool] = [\n    Tool(id=\"building.think_through_request\", kind=\"pattern\",\n         description=\"Think through a build request: turn a free-form wish into a concrete design \"\n                     \"intent and open the next steps (site analysis, design).\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"request\": {\"type\": \"string\"}, \"near\": POS_REF},\n                 \"required\": [\"request\"]},\n         args_hint=\"request=<free-form wish>, near={x,y,z} optional\"),\n    Tool(id=\"building.analyze_terrain\", kind=\"pattern\",\n         description=\"Scan candidate build sites near a position: flatness, station/chest proximity, \"\n                     \"guard radius. Returns ranked sites.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"near\": POS_REF},\n                 \"required\": [\"near\"]},\n         args_hint=\"near={x,y,z}\"),\n    Tool(id=\"building.design\", kind=\"pattern\",\n         description=\"Retrieve matching build designs for the intent and site; returns options with \"\n                     \"size, step summary, style tags, palette.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"site\": POS_REF, \"style\": {\"type\": \"string\"}},\n                 \"required\": [\"site\"]},\n         args_hint=\"site={x,y,z}, style=<optional tag filter>\"),\n    Tool(id=\"building.select_materials\", kind=\"pattern\",\n         description=\"Compute the material bill of a design against nearby storage: needed vs \"\n                     \"available, missing list, affordability verdict.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"design\": {\"type\": \"string\"}},\n                 \"required\": [\"design\"]},\n         args_hint=\"design=<card name>\"),\n    Tool(id=\"building.create_blueprint\", kind=\"pattern\",\n         description=\"Compile a chosen design into a placeable blueprint at an anchor site.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"design\": {\"type\": \"string\"}, \"anchor\": POS_REF},\n                 \"required\": [\"design\", \"anchor\"]},\n         args_hint=\"design=<card name>, anchor={x,y,z}\"),\n    Tool(id=\"building.apply_blueprint\", kind=\"effect\",\n         description=\"Enqueue the build: claim/enqueue the board task and place blocks over time. \"\n                     \"Observe convergence via observe_task.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"blueprint\": {\"type\": \"string\"}, \"anchor\": POS_REF},\n                 \"required\": [\"blueprint\", \"anchor\"]},\n         args_hint=\"blueprint=<blueprint id from create_blueprint>, anchor={x,y,z}\"),\n]\n\n# children offered by each pattern once it completes (D5 card gating)\nWALK_CHILDREN: dict[str, list[str]] = {\n    \"building.think_through_request\": [\"building.analyze_terrain\", \"building.design\"],\n    \"building.analyze_terrain\": [\"building.design\"],\n    \"building.design\": [\"building.select_materials\", \"building.create_blueprint\"],\n    \"building.select_materials\": [\"building.create_blueprint\"],\n    \"building.create_blueprint\": [\"building.apply_blueprint\"],\n}\n\nWALK_ENTRY_TOOLS = [\"building.think_through_request\"]\nWALK_ESCAPE_TOOLS = [\"rest\"]  # an agent may always choose to idle out\n\n\ndef walk_tool_by_wire(name: str) -> Tool | None:\n    for tool in BUILDING_WALK_TOOLS:\n        if tool.wire == name:\n            return tool\n    return None\n\n\ndef render_walk_system() -> str:\n    return (\"You are a Minecraft villager-agent running the BUILDING workflow. Work the request \"\n            \"step by step with the tools you are offered; each result opens the next valid steps. \"\n            \"Finish by applying a blueprint (it executes in the world over time), or rest if the \"\n            \"request cannot be worked. Think briefly, act with one tool call at a time.\")\n\n\ndef render_walk_prompt_block(allowed: list[Tool]) -> str:\n    \"\"\"Prompt-mode rendering of the situationally-allowed tool set (re-sent every turn).\"\"\"\n    lines = [\"TOOLS AVAILABLE RIGHT NOW (call exactly one as {\\\"tool\\\":\\\"<id>\\\",\\\"args\\\":{...}}):\"]\n    for t in allowed:\n        hint = f\" args: {t.args_hint}\" if t.args_hint else \"\"\n        lines.append(f\"- {t.wire} — {t.description}{hint}\")\n    return \"\\n\".join(lines)","oldString":"def first_json_object(text: str) -> dict | None:\n    \"\"\"First {...} span parsed (fence/prose tolerant); mirrors LlmActions.parseJsonObject.\"\"\"\n    if text is None:\n        return None\n    trimmed = text.strip()\n    if not trimmed:\n        return None\n    for candidate in (trimmed,):\n        try:\n            val = json.loads(candidate)\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            pass\n    start, end = trimmed.find(\"{\"), trimmed.rfind(\"}\")\n    if start >= 0 and end > start:\n        try:\n            val = json.loads(trimmed[start:end + 1])\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            return None\n    return None","path":"sidecar/catalog.py"}}}
{"timestamp":"2026-10-17T03:53:27.133Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"def first_json_object(text: str) -> dict | None:\n    \"\"\"First {...} span parsed (fence/prose tolerant); mirrors LlmActions.parseJsonObject.\"\"\"\n    if text is None:\n        return None\n    trimmed = text.strip()\n    if not trimmed:\n        return None\n    for candidate in (trimmed,):\n        try:\n            val = json.loads(candidate)\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            pass\n    start, end = trimmed.find(\"{\"), trimmed.rfind(\"}\")\n    if start >= 0 and end > start:\n        try:\n            val = json.loads(trimmed[start:end + 1])\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            return None\n    return None\n\n\n# --- S2: the building walk (first real pattern tree) ---------------------------\n# Reference walk from mcp-pattern-tree-design.md; children wiring implements D5\n# situational gating — a pattern's card only offers the children valid right now.\n\nBUILDING_WALK_TOOLS: list[Tool] = [\n    Tool(id=\"building.think_through_request\", kind=\"pattern\",\n         description=\"Think through a build request: turn a free-form wish into a concrete design \"\n                     \"intent and open the next steps (site analysis, design).\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"request\": {\"type\": \"string\"}, \"near\": POS_REF},\n                 \"required\": [\"request\"]},\n         args_hint=\"request=<free-form wish>, near={x,y,z} optional\"),\n    Tool(id=\"building.analyze_terrain\", kind=\"pattern\",\n         description=\"Scan candidate build sites near a position: flatness, station/chest proximity, \"\n                     \"guard radius. Returns ranked sites.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"near\": POS_REF},\n                 \"required\": [\"near\"]},\n         args_hint=\"near={x,y,z}\"),\n    Tool(id=\"building.design\", kind=\"pattern\",\n         description=\"Retrieve matching build designs for the intent and site; returns options with \"\n                     \"size, step summary, style tags, palette.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"site\": POS_REF, \"style\": {\"type\": \"string\"}},\n                 \"required\": [\"site\"]},\n         args_hint=\"site={x,y,z}, style=<optional tag filter>\"),\n    Tool(id=\"building.select_materials\", kind=\"pattern\",\n         description=\"Compute the material bill of a design against nearby storage: needed vs \"\n                     \"available, missing list, affordability verdict.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"design\": {\"type\": \"string\"}},\n                 \"required\": [\"design\"]},\n         args_hint=\"design=<card name>\"),\n    Tool(id=\"building.create_blueprint\", kind=\"pattern\",\n         description=\"Compile a chosen design into a placeable blueprint at an anchor site.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"design\": {\"type\": \"string\"}, \"anchor\": POS_REF},\n                 \"required\": [\"design\", \"anchor\"]},\n         args_hint=\"design=<card name>, anchor={x,y,z}\"),\n    Tool(id=\"building.apply_blueprint\", kind=\"effect\",\n         description=\"Enqueue the build: claim/enqueue the board task and place blocks over time. \"\n                     \"Observe convergence via observe_task.\",\n         inputs={\"type\": \"object\",\n                 \"properties\": {\"blueprint\": {\"type\": \"string\"}, \"anchor\": POS_REF},\n                 \"required\": [\"blueprint\", \"anchor\"]},\n         args_hint=\"blueprint=<blueprint id from create_blueprint>, anchor={x,y,z}\"),\n]\n\n# children offered by each pattern once it completes (D5 card gating)\nWALK_CHILDREN: dict[str, list[str]] = {\n    \"building.think_through_request\": [\"building.analyze_terrain\", \"building.design\"],\n    \"building.analyze_terrain\": [\"building.design\"],\n    \"building.design\": [\"building.select_materials\", \"building.create_blueprint\"],\n    \"building.select_materials\": [\"building.create_blueprint\"],\n    \"building.create_blueprint\": [\"building.apply_blueprint\"],\n}\n\nWALK_ENTRY_TOOLS = [\"building.think_through_request\"]\nWALK_ESCAPE_TOOLS = [\"rest\"]  # an agent may always choose to idle out\n\n\ndef walk_tool_by_wire(name: str) -> Tool | None:\n    for tool in BUILDING_WALK_TOOLS:\n        if tool.wire == name:\n            return tool\n    return None\n\n\ndef render_walk_system() -> str:\n    return (\"You are a Minecraft villager-agent running the BUILDING workflow. Work the request \"\n            \"step by step with the tools you are offered; each result opens the next valid steps. \"\n            \"Finish by applying a blueprint (it executes in the world over time), or rest if the \"\n            \"request cannot be worked. Think briefly, act with one tool call at a time.\")\n\n\ndef render_walk_prompt_block(allowed: list[Tool]) -> str:\n    \"\"\"Prompt-mode rendering of the situationally-allowed tool set (re-sent every turn).\"\"\"\n    lines = [\"TOOLS AVAILABLE RIGHT NOW (call exactly one as {\\\"tool\\\":\\\"<id>\\\",\\\"args\\\":{...}}):\"]\n    for t in allowed:\n        hint = f\" args: {t.args_hint}\" if t.args_hint else \"\"\n        lines.append(f\"- {t.wire} — {t.description}{hint}\")\n    return \"\\n\".join(lines)","oldString":"def first_json_object(text: str) -> dict | None:\n    \"\"\"First {...} span parsed (fence/prose tolerant); mirrors LlmActions.parseJsonObject.\"\"\"\n    if text is None:\n        return None\n    trimmed = text.strip()\n    if not trimmed:\n        return None\n    for candidate in (trimmed,):\n        try:\n            val = json.loads(candidate)\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            pass\n    start, end = trimmed.find(\"{\"), trimmed.rfind(\"}\")\n    if start >= 0 and end > start:\n        try:\n            val = json.loads(trimmed[start:end + 1])\n            if isinstance(val, dict):\n                return val\n        except ValueError:\n            return None\n    return None","path":"sidecar/catalog.py"}}}
{"timestamp":"2026-10-17T03:54:33.888Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Mock mod: plays the mod's MCP-server role for the S0/S2 spike (D1/D2).\n\nSpeaks newline-delimited JSON-RPC on stdin/stdout (stdout is pure protocol — logs go to\nstderr). Owns a small scripted world (scenario JSON): observation text, open tasks, and\nfor the building walk (S2): candidate sites, build cards, storage, blueprint store, plus\na build task that converges over observe_task polls (simulated ticks).\n\nMirrors the mod's safety boundary (D7): unknown tools, bad args, out-of-order pattern\ncalls, and not-yet-created blueprints are rejected with structured errors the model side\ncan read and recover from. Pattern results are D5 cards: {\"result\": ..., \"children\": [...]}.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\n\nfrom catalog import (BUILDING_WALK_TOOLS, S0_TOOLS, WALK_CHILDREN, by_wire, check_args)\nfrom catalog import Tool, resolve\n\nOBSERVE_TASK = Tool(id=\"observe.task\", kind=\"observe\",\n                    description=\"Read-only: one board task's status and progress; polling a build \"\n                                \"task advances the world one tick.\",\n                    inputs={\"type\": \"object\",\n                            \"properties\": {\"task\": {\"type\": \"string\"}},\n                            \"required\": [\"task\"]},\n                    args_hint=\"task=<task id or key>\")\n\n\nclass MockWorld:\n    def __init__(self, scenario: dict):\n        self.scenario = scenario\n        self.claimed: dict[str, str] = {}      # key -> claimant\n        self.said: list[dict] = []\n        self.blueprints: dict[str, dict] = {}  # blueprint id -> {design, anchor, total}\n        self.walk_tasks: dict[str, dict] = {}  # key -> {status, done, total}\n        self._walk_seq = 0\n        self.intent: dict | None = None\n\n    def open_tasks(self) -> list[dict]:\n        tasks = [t for t in self.scenario.get(\"open_tasks\", [])\n                 if t[\"key\"] not in self.claimed and t.get(\"claimable\", True)]\n        for key, job in self.walk_tasks.items():\n            if job[\"status\"] in (\"OPEN\", \"CLAIMED\"):\n                tasks.append({\"key\": key, \"type\": \"BUILD\",\n                              \"detail\": f\"walk build {job['done']}/{job['total']} placed\"})\n        return tasks\n\n    # --- building walk helpers -------------------------------------------------\n\n    def cards(self) -> list[dict]:\n        return self.scenario.get(\"cards\", [])\n\n    def card(self, name: str) -> dict | None:\n        return next((c for c self.cards() if c[\"name\"] == name), None) \\\n            if False else next((c for c in self.cards() if c[\"name\"] == name), None)\n\n    def sites_ranked(self) -> list[dict]:\n        sites = list(self.scenario.get(\"sites\", []))\n        sites.sort(key=lambda s: (not s.get(\"flat\", True), s.get(\"chestDist\", 99)))\n        return sites\n\n    def advance(self, job: dict):\n        job[\"done\"] = min(job[\"total\"], job[\"done\"] + max(1, job[\"total\"] // 4))\n        if job[\"done\"] >= job[\"total\"]:\n            job[\"status\"] = \"DONE\"\n\n\ndef card_children(wire_name: str) -> list[dict]:\n    tool_id = wire_name.replace(\"_\", \".\", 1) if wire_name.count(\"_\") == 1 else None\n    # wire names -> dotted ids: replace the FIRST underscore only when the id has\n    # exactly two segments; building tools all share the \"building\" prefix.\n    ids = {t.wire: t.id for t in BUILDING_WALK_TOOLS}\n    dotted = ids.get(wire_name)\n    child_ids = WALK_CHILDREN.get(dotted, []) if dotted else []\n    children = []\n    for child_id in child_ids:\n        child = next((t for t in BUILDING_WALK_TOOLS if t.id == child_id), None)\n        if child:\n            children.append({\"name\": child.wire, \"description\": child.description,\n                             \"inputs\": resolve(child.inputs)})\n    return children\n\n\ndef _err(message: dict) -> dict:\n    return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": json.dumps(message)}]}\n\n\ndef _ok(result: dict, children: list[dict] | None = None) -> dict:\n    body = {\"result\": result}\n    if children is not None:\n        body[\"children\"] = children\n    return {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\": json.dumps(body)}]}\n\n\ndef handle_walk_call(world: MockWorld, wire_name: str, args: dict) -> dict | None:\n    \"\"\"Building-walk handlers; returns None when wire_name is not a walk tool.\"\"\"\n    if wire_name == \"observe_task\":\n        key = args.get(\"task\", \"\")\n        job = world.walk_tasks.get(key)\n        if job is None:\n            board = next((t for t in world.scenario.get(\"open_tasks\", [])\n                          if t[\"key\"] == key), None)\n            if board is None:\n                return _err({\"reject\": f\"unknown task '{key}'\"})\n            return _ok({\"task\": key, \"status\": \"OPEN\"})\n        world.advance(job)\n        return _ok({\"task\": key, \"status\": job[\"status\"],\n                    \"progress\": f\"{job['done']}/{job['total']}\"})\n\n    tool = next((t for t in BUILDING_WALK_TOOLS if t.wire == wire_name), None)\n    if tool is None:\n        return None\n    err = check_args(tool.inputs, args)\n    if err:\n        return _err({\"reject\": f\"bad args for {wire_name}: {err}\"})\n\n    if wire_name == \"building_think_through_request\":\n        request = args[\"request\"].strip()\n        if len(request) < 3:\n            return _err({\"reject\": \"request too vague (min 3 chars)\"})\n        world.intent = {\"request\": request, \"sizeHint\": \"small\"}\n        return _ok({\"designIntent\": world.intent,\n                    \"note\": \"intent set — analyze a site or pick a design next\"},\n                   card_children(wire_name))\n\n    if wire_name == \"building_analyze_terrain\":\n        sites = world.sites_ranked()\n        if not sites:\n            return _err({\"reject\": \"no candidate sites in this scenario\"})\n        near = args[\"near\"]\n        ranked = [{\"site\": s[\"pos\"], \"flat\": s.get(\"flat\", True),\n                   \"chestDist\": s.get(\"chestDist\"), \"note\": s.get(\"note\", \"\")}\n                  for s in sites]\n        return _ok({\"near\": near, \"sites\": ranked},\n                   card_children(wire_name))\n\n    if wire_name == \"building_design\":\n        style = args.get(\"style\", \"\").lower()\n        options = []\n        for card in world.cards():\n            tags = [t.lower() for t in card.get(\"styleTags\", [])]\n            if style and style not in tags:\n                continue\n            options.append({\"name\": card[\"name\"], \"size\": card[\"size\"],\n                            \"steps\": card[\"stepSummary\"], \"styleTags\": card[\"styleTags\"],\n                            \"palette\": card[\"palette\"]})\n        if not options:\n            return _err({\"reject\": f\"no designs match style '{style}'\",\n                         \"available\": [c[\"name\"] for c in world.cards()]})\n        return _ok({\"site\": args[\"site\"], \"options\": options},\n                   card_children(wire_name))\n\n    if wire_name == \"building_select_materials\":\n        card = world.card(args[\"design\"])\n        if card is None:\n            return _err({\"reject\": f\"unknown design '{args['design']}'\",\n                         \"available\": [c[\"name\"] for c in world.cards()]})\n        available = world.scenario.get(\"materials\", {})\n        needed = card[\"palette\"]\n        have = {k: min(v, available.get(k, 0)) for k, v in needed.items()}\n        missing = {k: v - have[k] for k, v in needed.items() if have[k] < v}\n        return _ok({\"design\": card[\"name\"], \"needed\": needed, \"have\": have,\n                    \"missing\": missing, \"affordable\": not missing},\n                   card_children(wire_name))\n\n    if wire_name == \"building_create_blueprint\":\n        card = world.card(args[\"design\"])\n        if card is None:\n            return _err({\"reject\": f\"unknown design '{args['design']}'\",\n                         \"available\": [c[\"name\"] for c in world.cards()]})\n        anchor = args[\"anchor\"]\n        blueprint_id = f\"bp:{card['name']}@{anchor['x']},{anchor['y']},{anchor['z']}\"\n        total = sum(card[\"palette\"].values())\n        world.blueprints[blueprint_id] = {\"design\": card[\"name\"], \"anchor\": anchor,\n                                          \"total\": total}\n        return _ok({\"blueprint\": blueprint_id, \"placements\": total},\n                   card_children(wire_name))\n\n    if wire_name == \"building_apply_blueprint\":\n        blueprint_id = args[\"blueprint\"]\n        job = world.blueprints.get(blueprint_id)\n        if job is None:\n            return _err({\"reject\": f\"unknown blueprint '{blueprint_id}' — run create_blueprint first\",\n                         \"blueprints\": sorted(world.blueprints)})\n        anchor = args[\"anchor\"]\n        if anchor != job[\"anchor\"]:\n            return _err({\"reject\": f\"anchor mismatch: blueprint was created at {job['anchor']}\"})\n        world._walk_seq += 1\n        key = f\"build:walk:{world._walk_seq:02d}\"\n        world.walk_tasks[key] = {\"status\": \"CLAIMED\", \"done\": 0, \"total\": job[\"total\"]}\n        return _ok({\"claimed\": key, \"blueprint\": blueprint_id,\n                    \"convergence\": \"poll observe_task until DONE\"})\n\n    return _err({\"reject\": f\"tool '{wire_name}' not implemented by mock\"})  # pragma: no cover\n\n\ndef handle_call(world: MockWorld, name: str, args: dict) -> dict:\n    walk = handle_walk_call(world, name, args)\n    if walk is not None:\n        return walk\n    tool = by_wire(name)\n    if tool is None and name == \"observe_task\":\n        tool = OBSERVE_TASK\n    if tool is None:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"unknown tool '{name}'\"})}]}\n    err = check_args(tool.inputs, args)\n    if err:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"bad args for {name}: {err}\"})}]}\n    if name == \"observe_self\":\n        result = {\"observation\": world.scenario.get(\"observation\", \"\")}\n    elif name == \"observe_board\":\n        open_tasks = world.open_tasks()\n        result = {\"open_tasks\": [f\"{t['key']} — {t.get('detail', '')}\" for t in open_tasks]} \\\n            if open_tasks else {\"open_tasks\": []}\n    elif name == \"claim\":\n        wanted = args.get(\"task\")\n        open_tasks = world.open_tasks()\n        target = None\n        if wanted:\n            target = next((t for t in open_tasks if t[\"key\"] == wanted), None)\n            if target is None:\n                return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": json.dumps(\n                    {\"reject\": f\"unknown or claimed task key '{wanted}'\",\n                     \"open\": [t[\"key\"] for t in open_tasks]})}]}\n        elif open_tasks:\n            target = open_tasks[0]  # mock priority: board order\n        if target is None:\n            return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": \"no open tasks to claim\"})}]}\n        world.claimed[target[\"key\"]] = \"agent-1\"\n        result = {\"claimed\": target[\"key\"]}\n    elif name == \"rest\":\n        result = {\"resting\": True}\n    elif name == \"say\":\n        world.said.append({\"player\": args[\"player\"], \"msg\": args[\"msg\"]})\n        result = {\"said\": {\"player\": args[\"player\"], \"msg\": args[\"msg\"]}}\n    else:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"tool '{name}' not implemented by mock\"})}]}\n    return {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\": json.dumps(result)}]}\n\n\ndef tool_descriptor(t) -> dict:\n    return {\"name\": t.wire, \"description\": t.description, \"inputSchema\": resolve(t.inputs)}\n\n\ndef serve(scenario_path: str) -> None:\n    with open(scenario_path, encoding=\"utf-8\") as fh:\n        scenario = json.load(fh)\n    world = MockWorld(scenario)\n    catalog = list(S0_TOOLS)\n    if scenario.get(\"sites\"):\n        catalog = catalog + [OBSERVE_TASK] + BUILDING_WALK_TOOLS\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            msg = json.loads(line)\n        except ValueError:\n            continue\n        method, msg_id = msg.get(\"method\"), msg.get(\"id\")\n        if method == \"initialize\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\n                \"protocolVersion\": msg.get(\"params\", {}).get(\"protocolVersion\", \"2025-06-18\"),\n                \"capabilities\": {\"tools\": {}},\n                \"serverInfo\": {\"name\": \"siasworkshop-mockmod\", \"version\": \"0.2.0\"}}}\n        elif method == \"notifications/initialized\":\n            continue\n        elif method == \"tools/list\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"result\": {\"tools\": [tool_descriptor(t) for t in catalog]}}\n        elif method == \"tools/call\":\n            params = msg.get(\"params\", {})\n            result = handle_call(world, params.get(\"name\", \"\"), params.get(\"arguments\") or {})\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": result}\n        else:\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"error\": {\"code\": -32601, \"message\": f\"method not found: {method}\"}}\n        sys.stdout.write(json.dumps(reply) + \"\\n\")\n        sys.stdout.flush()\n        if method == \"tools/call\" and world.said:\n            sys.stderr.write(f\"[mockmod] say: {world.said[-1]}\\n\")\n            sys.stderr.flush()\n\n\nif __name__ == \"__main__\":\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"usage: mockmod.py <scenario.json>\\n\")\n        sys.exit(2)\n    serve(sys.argv[1])\n","path":"sidecar/mockmod.py"}}}
{"timestamp":"2026-10-17T03:54:33.892Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"content":"\"\"\"Mock mod: plays the mod's MCP-server role for the S0/S2 spike (D1/D2).\n\nSpeaks newline-delimited JSON-RPC on stdin/stdout (stdout is pure protocol — logs go to\nstderr). Owns a small scripted world (scenario JSON): observation text, open tasks, and\nfor the building walk (S2): candidate sites, build cards, storage, blueprint store, plus\na build task that converges over observe_task polls (simulated ticks).\n\nMirrors the mod's safety boundary (D7): unknown tools, bad args, out-of-order pattern\ncalls, and not-yet-created blueprints are rejected with structured errors the model side\ncan read and recover from. Pattern results are D5 cards: {\"result\": ..., \"children\": [...]}.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\n\nfrom catalog import (BUILDING_WALK_TOOLS, S0_TOOLS, WALK_CHILDREN, by_wire, check_args)\nfrom catalog import Tool, resolve\n\nOBSERVE_TASK = Tool(id=\"observe.task\", kind=\"observe\",\n                    description=\"Read-only: one board task's status and progress; polling a build \"\n                                \"task advances the world one tick.\",\n                    inputs={\"type\": \"object\",\n                            \"properties\": {\"task\": {\"type\": \"string\"}},\n                            \"required\": [\"task\"]},\n                    args_hint=\"task=<task id or key>\")\n\n\nclass MockWorld:\n    def __init__(self, scenario: dict):\n        self.scenario = scenario\n        self.claimed: dict[str, str] = {}      # key -> claimant\n        self.said: list[dict] = []\n        self.blueprints: dict[str, dict] = {}  # blueprint id -> {design, anchor, total}\n        self.walk_tasks: dict[str, dict] = {}  # key -> {status, done, total}\n        self._walk_seq = 0\n        self.intent: dict | None = None\n\n    def open_tasks(self) -> list[dict]:\n        tasks = [t for t in self.scenario.get(\"open_tasks\", [])\n                 if t[\"key\"] not in self.claimed and t.get(\"claimable\", True)]\n        for key, job in self.walk_tasks.items():\n            if job[\"status\"] in (\"OPEN\", \"CLAIMED\"):\n                tasks.append({\"key\": key, \"type\": \"BUILD\",\n                              \"detail\": f\"walk build {job['done']}/{job['total']} placed\"})\n        return tasks\n\n    # --- building walk helpers -------------------------------------------------\n\n    def cards(self) -> list[dict]:\n        return self.scenario.get(\"cards\", [])\n\n    def card(self, name: str) -> dict | None:\n        return next((c for c self.cards() if c[\"name\"] == name), None) \\\n            if False else next((c for c in self.cards() if c[\"name\"] == name), None)\n\n    def sites_ranked(self) -> list[dict]:\n        sites = list(self.scenario.get(\"sites\", []))\n        sites.sort(key=lambda s: (not s.get(\"flat\", True), s.get(\"chestDist\", 99)))\n        return sites\n\n    def advance(self, job: dict):\n        job[\"done\"] = min(job[\"total\"], job[\"done\"] + max(1, job[\"total\"] // 4))\n        if job[\"done\"] >= job[\"total\"]:\n            job[\"status\"] = \"DONE\"\n\n\ndef card_children(wire_name: str) -> list[dict]:\n    tool_id = wire_name.replace(\"_\", \".\", 1) if wire_name.count(\"_\") == 1 else None\n    # wire names -> dotted ids: replace the FIRST underscore only when the id has\n    # exactly two segments; building tools all share the \"building\" prefix.\n    ids = {t.wire: t.id for t in BUILDING_WALK_TOOLS}\n    dotted = ids.get(wire_name)\n    child_ids = WALK_CHILDREN.get(dotted, []) if dotted else []\n    children = []\n    for child_id in child_ids:\n        child = next((t for t in BUILDING_WALK_TOOLS if t.id == child_id), None)\n        if child:\n            children.append({\"name\": child.wire, \"description\": child.description,\n                             \"inputs\": resolve(child.inputs)})\n    return children\n\n\ndef _err(message: dict) -> dict:\n    return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": json.dumps(message)}]}\n\n\ndef _ok(result: dict, children: list[dict] | None = None) -> dict:\n    body = {\"result\": result}\n    if children is not None:\n        body[\"children\"] = children\n    return {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\": json.dumps(body)}]}\n\n\ndef handle_walk_call(world: MockWorld, wire_name: str, args: dict) -> dict | None:\n    \"\"\"Building-walk handlers; returns None when wire_name is not a walk tool.\"\"\"\n    if wire_name == \"observe_task\":\n        key = args.get(\"task\", \"\")\n        job = world.walk_tasks.get(key)\n        if job is None:\n            board = next((t for t in world.scenario.get(\"open_tasks\", [])\n                          if t[\"key\"] == key), None)\n            if board is None:\n                return _err({\"reject\": f\"unknown task '{key}'\"})\n            return _ok({\"task\": key, \"status\": \"OPEN\"})\n        world.advance(job)\n        return _ok({\"task\": key, \"status\": job[\"status\"],\n                    \"progress\": f\"{job['done']}/{job['total']}\"})\n\n    tool = next((t for t in BUILDING_WALK_TOOLS if t.wire == wire_name), None)\n    if tool is None:\n        return None\n    err = check_args(tool.inputs, args)\n    if err:\n        return _err({\"reject\": f\"bad args for {wire_name}: {err}\"})\n\n    if wire_name == \"building_think_through_request\":\n        request = args[\"request\"].strip()\n        if len(request) < 3:\n            return _err({\"reject\": \"request too vague (min 3 chars)\"})\n        world.intent = {\"request\": request, \"sizeHint\": \"small\"}\n        return _ok({\"designIntent\": world.intent,\n                    \"note\": \"intent set — analyze a site or pick a design next\"},\n                   card_children(wire_name))\n\n    if wire_name == \"building_analyze_terrain\":\n        sites = world.sites_ranked()\n        if not sites:\n            return _err({\"reject\": \"no candidate sites in this scenario\"})\n        near = args[\"near\"]\n        ranked = [{\"site\": s[\"pos\"], \"flat\": s.get(\"flat\", True),\n                   \"chestDist\": s.get(\"chestDist\"), \"note\": s.get(\"note\", \"\")}\n                  for s in sites]\n        return _ok({\"near\": near, \"sites\": ranked},\n                   card_children(wire_name))\n\n    if wire_name == \"building_design\":\n        style = args.get(\"style\", \"\").lower()\n        options = []\n        for card in world.cards():\n            tags = [t.lower() for t in card.get(\"styleTags\", [])]\n            if style and style not in tags:\n                continue\n            options.append({\"name\": card[\"name\"], \"size\": card[\"size\"],\n                            \"steps\": card[\"stepSummary\"], \"styleTags\": card[\"styleTags\"],\n                            \"palette\": card[\"palette\"]})\n        if not options:\n            return _err({\"reject\": f\"no designs match style '{style}'\",\n                         \"available\": [c[\"name\"] for c in world.cards()]})\n        return _ok({\"site\": args[\"site\"], \"options\": options},\n                   card_children(wire_name))\n\n    if wire_name == \"building_select_materials\":\n        card = world.card(args[\"design\"])\n        if card is None:\n            return _err({\"reject\": f\"unknown design '{args['design']}'\",\n                         \"available\": [c[\"name\"] for c in world.cards()]})\n        available = world.scenario.get(\"materials\", {})\n        needed = card[\"palette\"]\n        have = {k: min(v, available.get(k, 0)) for k, v in needed.items()}\n        missing = {k: v - have[k] for k, v in needed.items() if have[k] < v}\n        return _ok({\"design\": card[\"name\"], \"needed\": needed, \"have\": have,\n                    \"missing\": missing, \"affordable\": not missing},\n                   card_children(wire_name))\n\n    if wire_name == \"building_create_blueprint\":\n        card = world.card(args[\"design\"])\n        if card is None:\n            return _err({\"reject\": f\"unknown design '{args['design']}'\",\n                         \"available\": [c[\"name\"] for c in world.cards()]})\n        anchor = args[\"anchor\"]\n        blueprint_id = f\"bp:{card['name']}@{anchor['x']},{anchor['y']},{anchor['z']}\"\n        total = sum(card[\"palette\"].values())\n        world.blueprints[blueprint_id] = {\"design\": card[\"name\"], \"anchor\": anchor,\n                                          \"total\": total}\n        return _ok({\"blueprint\": blueprint_id, \"placements\": total},\n                   card_children(wire_name))\n\n    if wire_name == \"building_apply_blueprint\":\n        blueprint_id = args[\"blueprint\"]\n        job = world.blueprints.get(blueprint_id)\n        if job is None:\n            return _err({\"reject\": f\"unknown blueprint '{blueprint_id}' — run create_blueprint first\",\n                         \"blueprints\": sorted(world.blueprints)})\n        anchor = args[\"anchor\"]\n        if anchor != job[\"anchor\"]:\n            return _err({\"reject\": f\"anchor mismatch: blueprint was created at {job['anchor']}\"})\n        world._walk_seq += 1\n        key = f\"build:walk:{world._walk_seq:02d}\"\n        world.walk_tasks[key] = {\"status\": \"CLAIMED\", \"done\": 0, \"total\": job[\"total\"]}\n        return _ok({\"claimed\": key, \"blueprint\": blueprint_id,\n                    \"convergence\": \"poll observe_task until DONE\"})\n\n    return _err({\"reject\": f\"tool '{wire_name}' not implemented by mock\"})  # pragma: no cover\n\n\ndef handle_call(world: MockWorld, name: str, args: dict) -> dict:\n    walk = handle_walk_call(world, name, args)\n    if walk is not None:\n        return walk\n    tool = by_wire(name)\n    if tool is None and name == \"observe_task\":\n        tool = OBSERVE_TASK\n    if tool is None:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"unknown tool '{name}'\"})}]}\n    err = check_args(tool.inputs, args)\n    if err:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"bad args for {name}: {err}\"})}]}\n    if name == \"observe_self\":\n        result = {\"observation\": world.scenario.get(\"observation\", \"\")}\n    elif name == \"observe_board\":\n        open_tasks = world.open_tasks()\n        result = {\"open_tasks\": [f\"{t['key']} — {t.get('detail', '')}\" for t in open_tasks]} \\\n            if open_tasks else {\"open_tasks\": []}\n    elif name == \"claim\":\n        wanted = args.get(\"task\")\n        open_tasks = world.open_tasks()\n        target = None\n        if wanted:\n            target = next((t for t in open_tasks if t[\"key\"] == wanted), None)\n            if target is None:\n                return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\": json.dumps(\n                    {\"reject\": f\"unknown or claimed task key '{wanted}'\",\n                     \"open\": [t[\"key\"] for t in open_tasks]})}]}\n        elif open_tasks:\n            target = open_tasks[0]  # mock priority: board order\n        if target is None:\n            return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                    json.dumps({\"reject\": \"no open tasks to claim\"})}]}\n        world.claimed[target[\"key\"]] = \"agent-1\"\n        result = {\"claimed\": target[\"key\"]}\n    elif name == \"rest\":\n        result = {\"resting\": True}\n    elif name == \"say\":\n        world.said.append({\"player\": args[\"player\"], \"msg\": args[\"msg\"]})\n        result = {\"said\": {\"player\": args[\"player\"], \"msg\": args[\"msg\"]}}\n    else:\n        return {\"isError\": True, \"content\": [{\"type\": \"text\", \"text\":\n                json.dumps({\"reject\": f\"tool '{name}' not implemented by mock\"})}]}\n    return {\"isError\": False, \"content\": [{\"type\": \"text\", \"text\": json.dumps(result)}]}\n\n\ndef tool_descriptor(t) -> dict:\n    return {\"name\": t.wire, \"description\": t.description, \"inputSchema\": resolve(t.inputs)}\n\n\ndef serve(scenario_path: str) -> None:\n    with open(scenario_path, encoding=\"utf-8\") as fh:\n        scenario = json.load(fh)\n    world = MockWorld(scenario)\n    catalog = list(S0_TOOLS)\n    if scenario.get(\"sites\"):\n        catalog = catalog + [OBSERVE_TASK] + BUILDING_WALK_TOOLS\n    for line in sys.stdin:\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            msg = json.loads(line)\n        except ValueError:\n            continue\n        method, msg_id = msg.get(\"method\"), msg.get(\"id\")\n        if method == \"initialize\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": {\n                \"protocolVersion\": msg.get(\"params\", {}).get(\"protocolVersion\", \"2025-06-18\"),\n                \"capabilities\": {\"tools\": {}},\n                \"serverInfo\": {\"name\": \"siasworkshop-mockmod\", \"version\": \"0.2.0\"}}}\n        elif method == \"notifications/initialized\":\n            continue\n        elif method == \"tools/list\":\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"result\": {\"tools\": [tool_descriptor(t) for t in catalog]}}\n        elif method == \"tools/call\":\n            params = msg.get(\"params\", {})\n            result = handle_call(world, params.get(\"name\", \"\"), params.get(\"arguments\") or {})\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id, \"result\": result}\n        else:\n            reply = {\"jsonrpc\": \"2.0\", \"id\": msg_id,\n                     \"error\": {\"code\": -32601, \"message\": f\"method not found: {method}\"}}\n        sys.stdout.write(json.dumps(reply) + \"\\n\")\n        sys.stdout.flush()\n        if method == \"tools/call\" and world.said:\n            sys.stderr.write(f\"[mockmod] say: {world.said[-1]}\\n\")\n            sys.stderr.flush()\n\n\nif __name__ == \"__main__\":\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"usage: mockmod.py <scenario.json>\\n\")\n        sys.exit(2)\n    serve(sys.argv[1])\n","path":"sidecar/mockmod.py"}}}
