{"timestamp":"2026-10-20T06:26:56.421Z","type":"tool","step":"COMPLETE","details":{"toolName":"bash","args":{"command":"python3 -c \"\nimport json, statistics as st\nrows=[json.loads(l) for l in open('metrics/corpus-kev-live-20261020-20261020-002538.jsonl')]\nprint('rows:', len(rows))\nby={}\nfor r in rows: by.setdefault(r['scenario'],[]).append(r)\nfor sc,rs in sorted(by.items()):\n    pyes=[r.get('p_yes') for r in rs if r.get('p_yes') is not None]\n    ch=[r.get('decision') for r in rs]\n    print(f'{sc:38s} n={len(rs)} p_yes mean={st.mean(pyes):.3f} min={min(pyes):.3f} max={max(pyes):.3f} distinct={len(set(round(p,4) for p in pyes))} decisions={set(ch)}')\n\"","cwd":"/Users/bbaaxx/Code/projects/siasworkshop/sidecar"}}}
