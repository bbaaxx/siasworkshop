{"timestamp":"2026-10-08T06:27:03.849Z","type":"tool","initiativeId":"village-tools-wilderness-compass-village-foundation-block","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    /** True only on a thread currently placing a block-ordered cherry village (see VillagePlacer). */\n    private static final ThreadLocal<Boolean> FORCED = ThreadLocal.withInitial(() -> false);\n\n    public static void force(boolean enabled) {\n        FORCED.set(enabled);\n    }\n\n    private static boolean enabled() {\n        return FORCED.get() || Config.CHERRYFY_VILLAGES.getAsBoolean();\n    }\n\n    @Override\n    public StructureBlockInfo processBlock(LevelReader level, BlockPos pos, BlockPos pivotPos,\n            StructureBlockInfo localBlockInfo, StructureBlockInfo worldBlockInfo, StructurePlaceSettings settings) {\n        BlockState state = worldBlockInfo.state();\n        if (!enabled()) return worldBlockInfo;","oldString":"    @Override\n    public StructureBlockInfo processBlock(LevelReader level, BlockPos pos, BlockPos pivotPos,\n            StructureBlockInfo localBlockInfo, StructureBlockInfo worldBlockInfo, StructurePlaceSettings settings) {\n        BlockState state = worldBlockInfo.state();\n        if (!Config.CHERRYFY_VILLAGES.getAsBoolean()) return worldBlockInfo;","path":"src/main/java/com/siaws/siawsmod/worldgen/processor/CherryfyProcessor.java"}}}
{"timestamp":"2026-10-08T06:27:03.850Z","type":"tool","initiativeId":"village-tools-wilderness-compass-village-foundation-block","step":"EXECUTE","details":{"toolName":"edit","args":{"newString":"    /** True only on a thread currently placing a block-ordered cherry village (see VillagePlacer). */\n    private static final ThreadLocal<Boolean> FORCED = ThreadLocal.withInitial(() -> false);\n\n    public static void force(boolean enabled) {\n        FORCED.set(enabled);\n    }\n\n    private static boolean enabled() {\n        return FORCED.get() || Config.CHERRYFY_VILLAGES.getAsBoolean();\n    }\n\n    @Override\n    public StructureBlockInfo processBlock(LevelReader level, BlockPos pos, BlockPos pivotPos,\n            StructureBlockInfo localBlockInfo, StructureBlockInfo worldBlockInfo, StructurePlaceSettings settings) {\n        BlockState state = worldBlockInfo.state();\n        if (!enabled()) return worldBlockInfo;","oldString":"    @Override\n    public StructureBlockInfo processBlock(LevelReader level, BlockPos pos, BlockPos pivotPos,\n            StructureBlockInfo localBlockInfo, StructureBlockInfo worldBlockInfo, StructurePlaceSettings settings) {\n        BlockState state = worldBlockInfo.state();\n        if (!Config.CHERRYFY_VILLAGES.getAsBoolean()) return worldBlockInfo;","path":"src/main/java/com/siaws/siawsmod/worldgen/processor/CherryfyProcessor.java"}}}
