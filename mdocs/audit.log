istryAccess());\n\n        helper.assertTrue(reloaded.size() == 2, \"round trip lost entries: \" + reloaded.size());\n        helper.assertTrue(reloaded.entries().contains(success), \"success entry mismatch:\\n\" + reloaded.entries());\n        helper.assertTrue(reloaded.entries().contains(failure), \"failure entry mismatch:\\n\" + reloaded.entries());\n        PoolEntry stamped = reloaded.entries().stream()\n                .filter(e -> e.id().equals(success.id())).findFirst().orElseThrow();\n        helper.assertTrue(stamped.uses() == 1 && stamped.lastUsedGameTime() == now + 100,\n                \"uses/lastUsed not persisted:\\n\" + stamped);\n        helper.succeed();","path":"src/main/java/com/siaws/siawsmod/gametest/AgentsGoalsGameTest.java"}}}
