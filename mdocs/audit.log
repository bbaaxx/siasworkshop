{"timestamp":"2026-10-15T17:52:30.051Z","type":"tool","step":"COMPLETE","details":{"toolName":"edit","args":{"newString":"    public static final ModConfigSpec.ConfigValue<String> LLM_ENDPOINT = BUILDER\n            .comment(\"Base URL of the OpenAI-compatible endpoint (no trailing path). Prefer\",\n                    \"127.0.0.1 over localhost: dev launchers set -Djava.net.preferIPv6Addresses=system,\",\n                    \"so localhost may resolve to ::1 first and java.net.http can fail to fall back\",\n                    \"(ClosedChannelException) — while LM Studio binds 127.0.0.1 only.\")\n            .define(\"llm.endpoint\", \"http://127.0.0.1:1234/v1\");","oldString":"    public static final ModConfigSpec.ConfigValue<String> LLM_ENDPOINT = BUILDER\n            .comment(\"Base URL of the OpenAI-compatible endpoint (no trailing path).\")\n            .define(\"llm.endpoint\", \"http://localhost:1234/v1\");","path":"src/main/java/com/siaws/siawsmod/config/Config.java"}}}
