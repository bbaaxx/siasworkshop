{"timestamp":"2026-10-08T01:47:38.100Z","type":"tool","initiativeId":"cherry-village-worldgen","step":"EXECUTE","details":{"toolName":"bash","args":{"command":"curl -sL \"https://api.github.com/repos/Luke100000/minecraft-comes-alive/git/trees/1.21.1?recursive=1\" -o /tmp/mca-tree.json && python3 -c \"\nimport json\nd=json.load(open('/tmp/mca-tree.json'))\npaths=[t['path'] for t in d.get('tree',[])]\nprint(len(paths),'entries')\nimport re\nfor p in paths:\n    if re.search(r'(structure|village|template|jigsaw|pool|worldgen|mixin)', p, re.I):\n        print(p)\n\""}}}
