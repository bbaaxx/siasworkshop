e\",\n    \"modes\": [\"mcp-prompt\"],\n    \"content\": \"{\\\"action\\\":\\\"claim\\\",\\\"args\\\":{\\\"task\\\":\\\"{{build_key}}\\\"}}\",\n    \"expect_decision\": \"malformed_json\"\n  },\n  {\n    \"name\": \"mcp_shape_in_v1_mode\",\n    \"modes\": [\"v1\"],\n    \"content\": \"{\\\"tool\\\":\\\"claim\\\",\\\"args\\\":{\\\"task\\\":\\\"{{build_key}}\\\"}}\",\n    \"expect_decision\": \"malformed_json\"\n  },\n  {\n    \"name\": \"unknown_tool\",\n    \"modes\": [\"mcp-prompt\"],\n    \"content\": \"{\\\"tool\\\":\\\"dig\\\",\\\"args\\\":{\\\"block\\\":\\\"stone\\\"}}\",\n    \"expect_decision\": \"unknown_tool\"\n  },\n  {\n    \"name\": \"unknown_tool_v1shape\",\n    \"modes\": [\"v1\"],\n    \"content\": \"{\\\"action\\\":\\\"dig\\\",\\\"args\\\":{\\\"block\\\":\\\"stone\\\"}}\",\n    \"expect_decision\": \"unknown_tool\"\n  },\n  {\n    \"name\": \"bad_args_missing_msg\",\n    \"modes\": [\"mcp-prompt\"],\n    \"content\": \"{\\\"tool\\\":\\\"say\\\",\\\"args\\\":{\\\"player\\\":\\\"Dev\\\"}}\",\n    \"expect_tool\": \"say\",\n    \"expect_decision\": \"bad_args\"\n  },\n  {\n    \"name\": \"bad_args_missing_msg_v1shape\",\n    \"modes\": [\"v1\"],\n    \"content\": \"{\\\"action\\\":\\\"say\\\",\\\"args\\\":{\\\"player\\\":\\\"Dev\\\"}}\",\n    \"expect_tool\": \"say\",\n    \"expect_decision\": \"bad_args\"\n  },\n  {\n    \"name\": \"unknown_task_key_exec_reject\",\n    \"modes\": [\"mcp-prompt\"],\n    \"content\": \"{\\\"tool\\\":\\\"claim\\\",\\\"args\\\":{\\\"task\\\":\\\"build:nonexistent:00\\\"}}\",\n    \"expect_tool\": \"claim\",\n    \"expect_decision\": \"ok\",\n    \"expect_exec\": \"exec_reject:unknown or claimed task key 'build:nonexistent:00'\"\n  },\n  {\n    \"name\": \"unknown_task_key_exec_reject_v1shape\",\n    \"modes\": [\"v1\"],\n    \"content\": \"{\\\"action\\\":\\\"claim\\\",\\\"args\\\":{\\\"task\\\":\\\"build:nonexistent:00\\\"}}\",\n    \"expect_tool\": \"claim\",\n    \"expect_decision\": \"ok\",\n    \"expect_exec\": \"exec_reject:unknown or claimed task key 'build:nonexistent:00'\"\n  },\n  {\n    \"name\": \"garbage_no_json\",\n    \"modes\": [\"v1\", \"mcp-prompt\", \"mcp-native\"],\n    \"content\": \"I cannot decide today, the moon is wrong.\",\n    \"expect_decision\": \"malformed_json\"\n  },\n  {\n    \"name\": \"native_say\",\n    \"modes\": [\"mcp-native\"],\n    \"tool_call\": {\"name\": \"say\", \"arguments\": {\"player\": \"{{player}}\", \"msg\": \"heading out\"}},\n    \"expect_tool\": \"say\",\n    \"expect_decision\": \"ok\",\n    \"expect_exec\": \"exec_ok\"\n  },\n  {\n    \"name\": \"native_bad_args\",\n    \"modes\": [\"mcp-native\"],\n    \"tool_call\": {\"name\": \"claim\", \"arguments\": {\"task\": 42}},\n    \"expect_tool\": \"claim\",\n    \"expect_decision\": \"bad_args\"\n  },\n  {\n    \"name\": \"native_text_instead_of_call\",\n    \"modes\": [\"mcp-native\"],\n    \"content\": \"I think I will just rest for this cycle.\",\n    \"expect_decision\": \"malformed_json\"\n  }\n]\n","path":"sidecar/replay/script.json"}}}
