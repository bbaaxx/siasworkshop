{"timestamp":"2026-10-17T22:42:31.409Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"path":"sidecar/corpus_score.py","content":"\"\"\"Corpus scoring: Player-1 verifiable-reward recipe + JEVA Tier-0 metrics.\n\nPure functions on plain dicts — no I/O and no session/mock imports, so the scorer is\nusable by any harness and testable offline.\n\nReward recipe (Player-1): claim of a permitted task = +1; wrong class = 0; invalid\ncall (malformed JSON / unknown tool / bad args / no tool call / model error) = -1 with\nthe decision recorded as wait_fallback; then a reasoning-length penalty of 0.005 per\ncompletion token beyond the budget, capped at 1.0. No terminal penalties, no clamping\nbeyond the cap. The world can also refuse an otherwise-valid claim (mock/mod reject,\ne.g. claimable:false cooldown): the claim happened — reward 0, marked exec_reject.\n\nJEVA Tier-0: null/coverage is a SEPARATE question from the decision, never a list\noption. A binary coverage answer gives no AUROC, so a soft coverage_confidence is\nrecorded per run — AUROC becomes computable at Tier 1 from the paired answers.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\nimport statistics\n\nINVALID_CLASSES = {\"wait_fallback\", \"error\"}\nBOOTSTRAP_RESAMPLES = 1000\nBOOTSTRAP_SEED = 20261017\n\n\ndef classify(tool, args, decision_outcome, exec_outcome, model_error) -> tuple:\n    \"\"\"Map one run's raw outcomes onto (decision_class, chosen_key, invalid_reason).\n\n    decision_class ∈ claim|rest|say|wait_fallback|error. invalid_reason carries the\n    session.py failure vocabulary (malformed_json/unknown_tool/bad_args/model_error:<x>)\n    or the exec_reject marker: a refused claim is still class claim with chosen_key set —\n    the decision happened, the world refused it.\n    \"\"\"\n    outcome = decision_outcome or \"\"\n    if outcome.startswith(\"model_error:\"):\n        return (\"error\", None, outcome)\n    if tool is None or outcome == \"malformed_json\":\n        return (\"wait_fallback\", None, outcome or \"malformed_json\")\n    if outcome == \"unknown_tool\":\n        return (\"error\", None, \"unknown_tool\")\n    if outcome == \"bad_args\":\n        return (\"error\", None, \"bad_args\" if not model_error else f\"bad_args:{model_error}\")\n    invalid = \"exec_reject\" if (exec_outcome or \"\").startswith(\"exec_reject:\") else None\n    if tool == \"claim\":\n        key = args.get(\"task\") if isinstance(args, dict) else None\n        return (\"claim\", key, invalid)\n    if tool in (\"rest\", \"say\"):\n        return (tool, None, invalid)\n    return (\"error\", None, \"unknown_tool\")\n\n\ndef is_invalid(classified) -> bool:\n    \"\"\"The invalid-call test: score_run's -1/wait_fallback rule, in one place.\"\"\"\n    return classified[0] in INVALID_CLASSES\n\n\ndef score_run(assert_spec, classified, completion_tokens, budget=512) -> dict:\n    \"\"\"Player-1 reward for one classified run against a scenario's assert block.\"\"\"\n    decision_class, chosen_key, invalid_reason = classified\n    spec = assert_spec or {}\n    forbidden = list(spec.get(\"forbid_claim_keys\") or [])\n    null_board = bool(spec.get(\"null_ground_truth\"))\n    failure_hit = False\n    if is_invalid(classified):\n        base, correct = -1, False\n    elif decision_class == \"claim\":\n        if chosen_key in forbidden:\n            base, correct, failure_hit = 0, False, True\n        elif invalid_reason == \"exec_reject\":\n            base, correct = 0, False\n        elif chosen_key is not None:\n            base, correct = 1, True\n        else:\n            base, correct = 0, False    # keyless claim: unverifiable, not forbidden\n    elif decision_class == \"rest\":\n        base, correct = (1, True) if null_board else (0, False)\n    else:  # say is never the verified class (on a null board rest is the answer)\n        base, correct = 0, False\n    penalty = 0.005 * max(0, (completion_tokens or 0) - budget)\n    reward = base - min(1.0, penalty)\n    return {\"reward\": reward, \"correct\": correct, \"failure_class_hit\": failure_hit}\n\n\ndef jeva_metrics(rows, assert_spec) -> dict:\n    \"\"\"Tier-0 metrics over the runs of ONE scenario (rows may mix trials/permutations).\n\n    flip_rate: fraction of trial-groups (grouped by \"trial\" across permutations, invalid\n    runs excluded) whose chosen_key varies — position sensitivity. all_order_accuracy:\n    fraction of all runs correct. per_order_accuracy: accuracy keyed by the board order\n    actually shown. null matrix: the coverage answer vs null_ground_truth.\n    \"\"\"\n    valid = [r for r in rows if r.get(\"decision_class\") not in INVALID_CLASSES]\n    by_trial: dict = {}\n    for r in valid:\n        by_trial.setdefault(r.get(\"trial\"), []).append(r)\n    eligible = [g for g in by_trial.values() if len(g) >= 2]\n    flipped = sum(1 for g in eligible if len({r.get(\"chosen_key\") for r in g}) > 1)\n    n_runs = len(rows)\n    all_order_accuracy = (sum(1 for r in rows if r.get(\"correct\")) / n_runs) if n_runs else 0.0\n    order_totals: dict = {}\n    order_correct: dict = {}\n    for r in rows:\n        order = tuple(r.get(\"board_order\") or ())\n        order_totals[order] = order_totals.get(order, 0) + 1\n        if r.get(\"correct\"):\n            order_correct[order] = order_correct.get(order, 0) + 1\n    per_order_accuracy = {\" > \".join(order) or \"<empty>\": order_correct.get(order, 0) / order_totals[order]\n                          for order in order_totals}\n    null_truth = bool((assert_spec or {}).get(\"null_ground_truth\"))\n    tp = fp = tn = fn = 0\n    for r in rows:\n        cov = r.get(\"coverage_any_claimable\")\n        if not isinstance(cov, bool):\n            continue\n        if null_truth:\n            fp, tn = (fp + 1, tn) if cov else (fp, tn + 1)\n        else:\n            tp, fn = (tp + 1, fn) if cov else (tp, fn + 1)\n    tpr = tp / (tp + fn) if (tp + fn) else None\n    fpr = fp / (fp + tn) if (fp + tn) else None\n    return {\n        \"flip_rate\": flipped / len(eligible) if eligible else 0.0,\n        \"flip_trials\": flipped,\n        \"eligible_trials\": len(eligible),\n        \"all_order_accuracy\": all_order_accuracy,\n        \"n_runs\": n_runs,\n        \"per_order_accuracy\": per_order_accuracy,\n        \"null_matrix\": {\"tp\": tp, \"fp\": fp, \"tn\": tn, \"fn\": fn, \"tpr\": tpr, \"fpr\": fpr},\n    }\n\n\ndef summarize(rows) -> dict:\n    \"\"\"Per-scenario aggregate: n, mean reward, seeded bootstrap CI of the mean, and\n    Player-1 coverage — trials with >=1/>=2/>=4 successful (correct) runs.\"\"\"\n    rewards = [r[\"reward\"] for r in rows if isinstance(r.get(\"reward\"), (int, float))]\n    mean = statistics.mean(rewards) if rewards else 0.0\n    ci_low, ci_high = _bootstrap_ci(rewards)\n    by_trial: dict = {}\n    for r in rows:\n        by_trial.setdefault(r.get(\"trial\"), []).append(r)\n\n    def trials_with_at_least(k: int) -> int:\n        return sum(1 for g in by_trial.values()\n                   if sum(1 for r in g if r.get(\"correct\")) >= k)\n\n    t = len(by_trial)\n    ge1, ge2, ge4 = trials_with_at_least(1), trials_with_at_least(2), trials_with_at_least(4)\n    return {\n        \"n\": len(rows),\n        \"mean_reward\": mean,\n        \"ci_low\": ci_low,\n        \"ci_high\": ci_high,\n        \"trials\": t,\n        \"trials_success_ge1\": ge1, \"coverage_ge1\": ge1 / t if t else 0.0, \"covered_ge1\": ge1 > 0,\n        \"trials_success_ge2\": ge2, \"coverage_ge2\": ge2 / t if t else 0.0, \"covered_ge2\": ge2 > 0,\n        \"trials_success_ge4\": ge4, \"coverage_ge4\": ge4 / t if t else 0.0, \"covered_ge4\": ge4 > 0,\n    }\n\n\ndef _bootstrap_ci(values: list, resamples: int = BOOTSTRAP_RESAMPLES,\n                  seed: int = BOOTSTRAP_SEED) -> tuple:\n    \"\"\"Percentile bootstrap CI of the mean; seeded RNG — same rows, same interval.\"\"\"\n    if not values:\n        return (0.0, 0.0)\n    if len(values) == 1:\n        return (values[0], values[0])\n    rng = random.Random(seed)\n    means = sorted(statistics.mean(values[rng.randrange(len(values))]\n                                   for _ in range(len(values)))\n                   for _ in range(resamples))\n    low = means[int(0.025 * resamples)]\n    high = means[min(resamples - 1, int(0.975 * resamples))]\n    return (low, high)\n"}}}
{"timestamp":"2026-10-17T22:42:31.412Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"path":"sidecar/corpus_score.py","content":"\"\"\"Corpus scoring: Player-1 verifiable-reward recipe + JEVA Tier-0 metrics.\n\nPure functions on plain dicts — no I/O and no session/mock imports, so the scorer is\nusable by any harness and testable offline.\n\nReward recipe (Player-1): claim of a permitted task = +1; wrong class = 0; invalid\ncall (malformed JSON / unknown tool / bad args / no tool call / model error) = -1 with\nthe decision recorded as wait_fallback; then a reasoning-length penalty of 0.005 per\ncompletion token beyond the budget, capped at 1.0. No terminal penalties, no clamping\nbeyond the cap. The world can also refuse an otherwise-valid claim (mock/mod reject,\ne.g. claimable:false cooldown): the claim happened — reward 0, marked exec_reject.\n\nJEVA Tier-0: null/coverage is a SEPARATE question from the decision, never a list\noption. A binary coverage answer gives no AUROC, so a soft coverage_confidence is\nrecorded per run — AUROC becomes computable at Tier 1 from the paired answers.\n\"\"\"\nfrom __future__ import annotations\n\nimport random\nimport statistics\n\nINVALID_CLASSES = {\"wait_fallback\", \"error\"}\nBOOTSTRAP_RESAMPLES = 1000\nBOOTSTRAP_SEED = 20261017\n\n\ndef classify(tool, args, decision_outcome, exec_outcome, model_error) -> tuple:\n    \"\"\"Map one run's raw outcomes onto (decision_class, chosen_key, invalid_reason).\n\n    decision_class ∈ claim|rest|say|wait_fallback|error. invalid_reason carries the\n    session.py failure vocabulary (malformed_json/unknown_tool/bad_args/model_error:<x>)\n    or the exec_reject marker: a refused claim is still class claim with chosen_key set —\n    the decision happened, the world refused it.\n    \"\"\"\n    outcome = decision_outcome or \"\"\n    if outcome.startswith(\"model_error:\"):\n        return (\"error\", None, outcome)\n    if tool is None or outcome == \"malformed_json\":\n        return (\"wait_fallback\", None, outcome or \"malformed_json\")\n    if outcome == \"unknown_tool\":\n        return (\"error\", None, \"unknown_tool\")\n    if outcome == \"bad_args\":\n        return (\"error\", None, \"bad_args\" if not model_error else f\"bad_args:{model_error}\")\n    invalid = \"exec_reject\" if (exec_outcome or \"\").startswith(\"exec_reject:\") else None\n    if tool == \"claim\":\n        key = args.get(\"task\") if isinstance(args, dict) else None\n        return (\"claim\", key, invalid)\n    if tool in (\"rest\", \"say\"):\n        return (tool, None, invalid)\n    return (\"error\", None, \"unknown_tool\")\n\n\ndef is_invalid(classified) -> bool:\n    \"\"\"The invalid-call test: score_run's -1/wait_fallback rule, in one place.\"\"\"\n    return classified[0] in INVALID_CLASSES\n\n\ndef score_run(assert_spec, classified, completion_tokens, budget=512) -> dict:\n    \"\"\"Player-1 reward for one classified run against a scenario's assert block.\"\"\"\n    decision_class, chosen_key, invalid_reason = classified\n    spec = assert_spec or {}\n    forbidden = list(spec.get(\"forbid_claim_keys\") or [])\n    null_board = bool(spec.get(\"null_ground_truth\"))\n    failure_hit = False\n    if is_invalid(classified):\n        base, correct = -1, False\n    elif decision_class == \"claim\":\n        if chosen_key in forbidden:\n            base, correct, failure_hit = 0, False, True\n        elif invalid_reason == \"exec_reject\":\n            base, correct = 0, False\n        elif chosen_key is not None:\n            base, correct = 1, True\n        else:\n            base, correct = 0, False    # keyless claim: unverifiable, not forbidden\n    elif decision_class == \"rest\":\n        base, correct = (1, True) if null_board else (0, False)\n    else:  # say is never the verified class (on a null board rest is the answer)\n        base, correct = 0, False\n    penalty = 0.005 * max(0, (completion_tokens or 0) - budget)\n    reward = base - min(1.0, penalty)\n    return {\"reward\": reward, \"correct\": correct, \"failure_class_hit\": failure_hit}\n\n\ndef jeva_metrics(rows, assert_spec) -> dict:\n    \"\"\"Tier-0 metrics over the runs of ONE scenario (rows may mix trials/permutations).\n\n    flip_rate: fraction of trial-groups (grouped by \"trial\" across permutations, invalid\n    runs excluded) whose chosen_key varies — position sensitivity. all_order_accuracy:\n    fraction of all runs correct. per_order_accuracy: accuracy keyed by the board order\n    actually shown. null matrix: the coverage answer vs null_ground_truth.\n    \"\"\"\n    valid = [r for r in rows if r.get(\"decision_class\") not in INVALID_CLASSES]\n    by_trial: dict = {}\n    for r in valid:\n        by_trial.setdefault(r.get(\"trial\"), []).append(r)\n    eligible = [g for g in by_trial.values() if len(g) >= 2]\n    flipped = sum(1 for g in eligible if len({r.get(\"chosen_key\") for r in g}) > 1)\n    n_runs = len(rows)\n    all_order_accuracy = (sum(1 for r in rows if r.get(\"correct\")) / n_runs) if n_runs else 0.0\n    order_totals: dict = {}\n    order_correct: dict = {}\n    for r in rows:\n        order = tuple(r.get(\"board_order\") or ())\n        order_totals[order] = order_totals.get(order, 0) + 1\n        if r.get(\"correct\"):\n            order_correct[order] = order_correct.get(order, 0) + 1\n    per_order_accuracy = {\" > \".join(order) or \"<empty>\": order_correct.get(order, 0) / order_totals[order]\n                          for order in order_totals}\n    null_truth = bool((assert_spec or {}).get(\"null_ground_truth\"))\n    tp = fp = tn = fn = 0\n    for r in rows:\n        cov = r.get(\"coverage_any_claimable\")\n        if not isinstance(cov, bool):\n            continue\n        if null_truth:\n            fp, tn = (fp + 1, tn) if cov else (fp, tn + 1)\n        else:\n            tp, fn = (tp + 1, fn) if cov else (tp, fn + 1)\n    tpr = tp / (tp + fn) if (tp + fn) else None\n    fpr = fp / (fp + tn) if (fp + tn) else None\n    return {\n        \"flip_rate\": flipped / len(eligible) if eligible else 0.0,\n        \"flip_trials\": flipped,\n        \"eligible_trials\": len(eligible),\n        \"all_order_accuracy\": all_order_accuracy,\n        \"n_runs\": n_runs,\n        \"per_order_accuracy\": per_order_accuracy,\n        \"null_matrix\": {\"tp\": tp, \"fp\": fp, \"tn\": tn, \"fn\": fn, \"tpr\": tpr, \"fpr\": fpr},\n    }\n\n\ndef summarize(rows) -> dict:\n    \"\"\"Per-scenario aggregate: n, mean reward, seeded bootstrap CI of the mean, and\n    Player-1 coverage — trials with >=1/>=2/>=4 successful (correct) runs.\"\"\"\n    rewards = [r[\"reward\"] for r in rows if isinstance(r.get(\"reward\"), (int, float))]\n    mean = statistics.mean(rewards) if rewards else 0.0\n    ci_low, ci_high = _bootstrap_ci(rewards)\n    by_trial: dict = {}\n    for r in rows:\n        by_trial.setdefault(r.get(\"trial\"), []).append(r)\n\n    def trials_with_at_least(k: int) -> int:\n        return sum(1 for g in by_trial.values()\n                   if sum(1 for r in g if r.get(\"correct\")) >= k)\n\n    t = len(by_trial)\n    ge1, ge2, ge4 = trials_with_at_least(1), trials_with_at_least(2), trials_with_at_least(4)\n    return {\n        \"n\": len(rows),\n        \"mean_reward\": mean,\n        \"ci_low\": ci_low,\n        \"ci_high\": ci_high,\n        \"trials\": t,\n        \"trials_success_ge1\": ge1, \"coverage_ge1\": ge1 / t if t else 0.0, \"covered_ge1\": ge1 > 0,\n        \"trials_success_ge2\": ge2, \"coverage_ge2\": ge2 / t if t else 0.0, \"covered_ge2\": ge2 > 0,\n        \"trials_success_ge4\": ge4, \"coverage_ge4\": ge4 / t if t else 0.0, \"covered_ge4\": ge4 > 0,\n    }\n\n\ndef _bootstrap_ci(values: list, resamples: int = BOOTSTRAP_RESAMPLES,\n                  seed: int = BOOTSTRAP_SEED) -> tuple:\n    \"\"\"Percentile bootstrap CI of the mean; seeded RNG — same rows, same interval.\"\"\"\n    if not values:\n        return (0.0, 0.0)\n    if len(values) == 1:\n        return (values[0], values[0])\n    rng = random.Random(seed)\n    means = sorted(statistics.mean(values[rng.randrange(len(values))]\n                                   for _ in range(len(values)))\n                   for _ in range(resamples))\n    low = means[int(0.025 * resamples)]\n    high = means[min(resamples - 1, int(0.975 * resamples))]\n    return (low, high)\n"}}}
{"timestamp":"2026-10-17T22:44:04.097Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"path":"sidecar/run_corpus.py","content":"\"\"\"Corpus runner (Q4): seeded trials × board permutations of corpus/*.json scenarios\nagainst any model surface (v1 | mcp-prompt | mcp-native), scored Player-1 + JEVA Tier-0.\n\nExamples:\n  # deterministic stub/replay run (no network), Tier-0 decide path:\n  python3 run_corpus.py --corpus corpus --replay replay/script.json --tier0 --tag t0\n\n  # live local leg:\n  python3 run_corpus.py --corpus corpus --endpoint http://127.0.0.1:1234/v1 \\\n      --model prism-ml/bonsai-27b --trials 4 --permutations 2\n\n  # cloud leg (TOML like run_spike; apiKey never printed):\n  python3 run_corpus.py --corpus corpus --cloud-config siasworkshop-server.toml --tag cloud\n\nSeeding: seed = scenario.seed + trial*1000 + permutation (the runner owns it and writes\nit into every row). Without --tier0 and perms>1 the scenario file itself is pre-permuted\ninto a temp copy (session sees that order); with --tier0 the session-side seeded shuffle\nof the board lines is the order variation.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport glob\nimport json\nimport os\nimport random\nimport shutil\nimport sys\nimport tempfile\nimport time\n\nimport corpus_score\nfrom mcp import spawn_mock\nfrom model import FakeModel, OpenAiChat, profile_for\nfrom run_spike import parse_llm_toml\nfrom session import run_decision\n\nMODES = [\"v1\", \"mcp-prompt\", \"mcp-native\"]\n\n\ndef discover_scenarios(path: str) -> list:\n    if os.path.isdir(path):\n        return sorted(glob.glob(os.path.join(path, \"*.json\")))\n    return [path]\n\n\ndef build_chat(args) -> tuple:\n    \"\"\"Endpoint leg, mirroring run_spike: cloud TOML fills gaps over --endpoint/--model.\"\"\"\n    endpoint, model, api_key = args.endpoint, args.model, None\n    timeout_s = 120\n    if args.cloud_config:\n        cfg = parse_llm_toml(os.path.abspath(args.cloud_config))\n        endpoint = endpoint or cfg.get(\"endpoint\")\n        model = model or cfg.get(\"model\")\n        api_key = cfg.get(\"apiKey\") or None\n        timeout_s = int(cfg.get(\"timeoutSeconds\", 120))\n        print(f\"cloud config: endpoint={endpoint} model={model} \"\n              f\"apiKey={'<present>' if api_key else '<absent>'}\")\n    api_key = api_key or os.environ.get(args.api_key_env) or None\n    if not endpoint or not model:\n        raise SystemExit(\"--endpoint and --model are required (or --cloud-config)\")\n    profile = dict(profile_for(model), timeout_seconds=timeout_s)\n    return OpenAiChat(endpoint, api_key, timeout_s), profile\n\n\ndef run(args, model=None, model_tag: str | None = None) -> list:\n    \"\"\"Run the corpus; returns the metric rows. `model` overrides model construction\n    (tests pass stubs); otherwise --replay or the endpoint legs build one per run.\"\"\"\n    scenario_paths = discover_scenarios(args.corpus)\n    if not scenario_paths:\n        print(f\"no corpus scenarios found at {args.corpus}\")\n        return []\n    replay_script = None\n    chat = None\n    profile: dict = {}\n    if model is None:\n        if args.replay:\n            with open(args.replay, encoding=\"utf-8\") as fh:\n                script = json.load(fh)\n            replay_script = [s for s in script if not s.get(\"modes\") or args.mode in s[\"modes\"]]\n        else:\n            chat, profile = build_chat(args)\n    if model_tag is None:\n        model_tag = args.model or (\"replay:\" + os.path.basename(args.replay)\n                                   if args.replay else \"model\")\n    out_path = args.out or os.path.join(\n        \"metrics\", f\"corpus-{args.tag or args.mode}-{time.strftime('%Y%m%d-%H%M%S')}.jsonl\")\n    out_dir = os.path.dirname(os.path.abspath(out_path))\n    if out_dir:\n        os.makedirs(out_dir, exist_ok=True)\n\n    all_rows: list = []\n    assert_specs: dict = {}\n    with open(out_path, \"a\", encoding=\"utf-8\") as out:\n        for path in scenario_paths:\n            with open(path, encoding=\"utf-8\") as fh:\n                scenario = json.load(fh)\n            name = scenario.get(\"name\", path)\n            assert_spec = scenario.get(\"assert\") or {}\n            assert_specs[name] = assert_spec\n            rows = run_scenario(args, path, scenario, profile, model, model_tag,\n                                replay_script, chat, assert_spec, out)\n            all_rows.extend(rows)\n            if not args.quiet:\n                for row in rows:\n                    print(f\"{row['scenario']} t{row['trial']}.{row['permutation']} \"\n                          f\"seed={row['seed']} -> {row['decision_class']}:{row['chosen_key']} \"\n                          f\"reward={row['reward']:+.2f} cov={row['coverage_any_claimable']} \"\n                          f\"board={' > '.join(row['board_order']) or '<empty>'}\")\n    print_summary(all_rows, args, assert_specs)\n    if not args.quiet:\n        print(f\"\\nmetrics -> {out_path}\")\n    return all_rows\n\n\ndef run_scenario(args, path: str, scenario: dict, profile: dict, model, model_tag: str,\n                 replay_script, chat, assert_spec: dict, out) -> list:\n    trials = args.trials or scenario.get(\"trials\") or 8\n    perms = args.permutations or scenario.get(\"permutations\") or 1\n    budget = profile.get(\"budget\", 512) if hasattr(profile, \"get\") else 512\n    rows = []\n    for trial in range(1, trials + 1):\n        for perm in range(1, perms + 1):\n            seed = scenario.get(\"seed\", 0) + trial * 1000 + perm\n            rng = random.Random(seed)\n            effective, eff_path, tmpdir = scenario, path, None\n            if not args.tier0 and perms > 1:\n                effective = copy.deepcopy(scenario)\n                rng.shuffle(effective.get(\"open_tasks\", []))\n                tmpdir = tempfile.mkdtemp(prefix=\"siasworkshop-corpus-\")\n                eff_path = os.path.join(tmpdir, \"scenario.json\")\n                with open(eff_path, \"w\", encoding=\"utf-8\") as fh:\n                    json.dump(effective, fh)\n            try:\n                client = spawn_mock(eff_path)\n                try:\n                    client.start()\n                    run_model = model if model is not None else (\n                        FakeModel(replay_script, effective) if replay_script is not None else chat)\n                    decision = run_decision(args.mode, run_model, model_tag, client, profile,\n                                            tier0=args.tier0, rng=rng)\n                finally:\n                    client.close()\n            finally:\n                if tmpdir:\n                    shutil.rmtree(tmpdir, ignore_errors=True)\n            row = build_row(scenario, effective, trial, perm, seed, args, model_tag,\n                            decision, assert_spec, budget)\n            rows.append(row)\n            out.write(json.dumps(row) + \"\\n\")\n            out.flush()\n    return rows\n\n\ndef build_row(scenario, effective, trial, perm, seed, args, model_tag, decision,\n              assert_spec, budget) -> dict:\n    classified = corpus_score.classify(decision.tool, decision.args,\n                                       decision.decision_outcome, decision.exec_outcome,\n                                       decision.model_error)\n    scored = corpus_score.score_run(assert_spec, classified, decision.completion_tokens, budget)\n    decision_class = (\"wait_fallback\" if corpus_score.is_invalid(classified)\n                      else classified[0])\n    board_order = decision.board_order or [t[\"key\"] for t in effective.get(\"open_tasks\", [])]\n    return {\n        \"scenario\": scenario.get(\"name\", \"?\"),\n        \"trial\": trial,\n        \"permutation\": perm,\n        \"seed\": seed,\n        \"mode\": args.mode,\n        \"model\": model_tag,\n        \"tier0\": bool(args.tier0),\n        \"decision_class\": decision_class,\n        \"chosen_key\": classified[1],\n        \"correct\": scored[\"correct\"],\n        \"failure_class_hit\": scored[\"failure_class_hit\"],\n        \"invalid_reason\": classified[2],\n        \"coverage_any_claimable\": decision.coverage_any_claimable,\n        \"coverage_confidence\": decision.coverage_confidence,\n        \"completion_tokens\": decision.completion_tokens,\n        \"prompt_tokens\": decision.prompt_tokens,\n        \"latency_ms\": decision.total_latency_ms,\n        \"reward\": scored[\"reward\"],\n        \"board_order\": board_order,\n    }\n\n\ndef print_summary(rows: list, args, assert_specs: dict) -> None:\n    groups: dict = {}\n    for row in rows:\n        groups.setdefault((row[\"scenario\"], row[\"mode\"]), []).append(row)\n    print(\"\\n=== corpus summary (scenario × mode) ===\")\n    for (name, mode), group in sorted(groups.items()):\n        agg = corpus_score.summarize(group)\n        print(f\"{name:<36} {mode:<11} n={agg['n']:>3} \"\n              f\"mean_reward={agg['mean_reward']:+.3f} \"\n              f\"CI[{agg['ci_low']:+.3f},{agg['ci_high']:+.3f}] \"\n              f\"cov>=1/2/4 {agg['trials_success_ge1']}/{agg['trials_success_ge2']}/\"\n              f\"{agg['trials_success_ge4']} of {agg['trials']} trials\")\n        trials = args.trials if args.trials else None\n        perms = args.permutations if args.permutations else None\n        if perms and perms > 1 or args.tier0:\n            jm = corpus_score.jeva_metrics(group, assert_specs.get(name, {}))\n            nm = jm[\"null_matrix\"]\n            print(f\"{'':<36} {'':<11} flip_rate={jm['flip_rate']:.2f} \"\n                  f\"({jm['flip_trials']}/{jm['eligible_trials']} trials) \"\n                  f\"all_order_acc={jm['all_order_accuracy']:.2f} \"\n                  f\"per_order={json.dumps(jm['per_order_accuracy'])}\")\n            print(f\"{'':<36} {'':<11} null_matrix tp={nm['tp']} fp={nm['fp']} tn={nm['tn']} \"\n                  f\"fn={nm['fn']} tpr={nm['tpr']} fpr={nm['fpr']}\")\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--corpus\", required=True,\n                    help=\"corpus scenario .json file or directory of them\")\n    ap.add_argument(\"--trials\", type=int, default=None, help=\"override scenario trials\")\n    ap.add_argument(\"--permutations\", type=int, default=None,\n                    help=\"override scenario permutations\")\n    ap.add_argument(\"--mode\", default=\"mcp-prompt\", choices=MODES)\n    src = ap.add_mutually_exclusive_group(required=True)\n    src.add_argument(\"--replay\", metavar=\"SCRIPT.json\",\n                     help=\"scripted-reply FakeModel per run (no network)\")\n    src.add_argument(\"--endpoint\", help=\"OpenAI-compatible base URL\")\n    ap.add_argument(\"--model\")\n    ap.add_argument(\"--api-key-env\", default=\"OPENROUTER_API_KEY\")\n    ap.add_argument(\"--cloud-config\", help=\"siasworkshop-server.toml with an [llm] section\")\n    ap.add_argument(\"--tier0\", action=\"store_true\",\n                    help=\"JEVA Tier-0 decide path: seeded board shuffle + coverage answer\")\n    ap.add_argument(\"--tag\", help=\"run-batch tag (default: mode)\")\n    ap.add_argument(\"--out\", help=\"metrics JSONL path (default: metrics/corpus-<tag>-<ts>.jsonl)\")\n    ap.add_argument(\"--quiet\", action=\"store_true\", help=\"suppress per-run lines\")\n    args = ap.parse_args(argv)\n    run(args)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}}}
{"timestamp":"2026-10-17T22:44:04.101Z","type":"tool","initiativeId":"mcp-model-behavior-research--2026-10-15","step":"EXECUTE","details":{"toolName":"write","args":{"path":"sidecar/run_corpus.py","content":"\"\"\"Corpus runner (Q4): seeded trials × board permutations of corpus/*.json scenarios\nagainst any model surface (v1 | mcp-prompt | mcp-native), scored Player-1 + JEVA Tier-0.\n\nExamples:\n  # deterministic stub/replay run (no network), Tier-0 decide path:\n  python3 run_corpus.py --corpus corpus --replay replay/script.json --tier0 --tag t0\n\n  # live local leg:\n  python3 run_corpus.py --corpus corpus --endpoint http://127.0.0.1:1234/v1 \\\n      --model prism-ml/bonsai-27b --trials 4 --permutations 2\n\n  # cloud leg (TOML like run_spike; apiKey never printed):\n  python3 run_corpus.py --corpus corpus --cloud-config siasworkshop-server.toml --tag cloud\n\nSeeding: seed = scenario.seed + trial*1000 + permutation (the runner owns it and writes\nit into every row). Without --tier0 and perms>1 the scenario file itself is pre-permuted\ninto a temp copy (session sees that order); with --tier0 the session-side seeded shuffle\nof the board lines is the order variation.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport glob\nimport json\nimport os\nimport random\nimport shutil\nimport sys\nimport tempfile\nimport time\n\nimport corpus_score\nfrom mcp import spawn_mock\nfrom model import FakeModel, OpenAiChat, profile_for\nfrom run_spike import parse_llm_toml\nfrom session import run_decision\n\nMODES = [\"v1\", \"mcp-prompt\", \"mcp-native\"]\n\n\ndef discover_scenarios(path: str) -> list:\n    if os.path.isdir(path):\n        return sorted(glob.glob(os.path.join(path, \"*.json\")))\n    return [path]\n\n\ndef build_chat(args) -> tuple:\n    \"\"\"Endpoint leg, mirroring run_spike: cloud TOML fills gaps over --endpoint/--model.\"\"\"\n    endpoint, model, api_key = args.endpoint, args.model, None\n    timeout_s = 120\n    if args.cloud_config:\n        cfg = parse_llm_toml(os.path.abspath(args.cloud_config))\n        endpoint = endpoint or cfg.get(\"endpoint\")\n        model = model or cfg.get(\"model\")\n        api_key = cfg.get(\"apiKey\") or None\n        timeout_s = int(cfg.get(\"timeoutSeconds\", 120))\n        print(f\"cloud config: endpoint={endpoint} model={model} \"\n              f\"apiKey={'<present>' if api_key else '<absent>'}\")\n    api_key = api_key or os.environ.get(args.api_key_env) or None\n    if not endpoint or not model:\n        raise SystemExit(\"--endpoint and --model are required (or --cloud-config)\")\n    profile = dict(profile_for(model), timeout_seconds=timeout_s)\n    return OpenAiChat(endpoint, api_key, timeout_s), profile\n\n\ndef run(args, model=None, model_tag: str | None = None) -> list:\n    \"\"\"Run the corpus; returns the metric rows. `model` overrides model construction\n    (tests pass stubs); otherwise --replay or the endpoint legs build one per run.\"\"\"\n    scenario_paths = discover_scenarios(args.corpus)\n    if not scenario_paths:\n        print(f\"no corpus scenarios found at {args.corpus}\")\n        return []\n    replay_script = None\n    chat = None\n    profile: dict = {}\n    if model is None:\n        if args.replay:\n            with open(args.replay, encoding=\"utf-8\") as fh:\n                script = json.load(fh)\n            replay_script = [s for s in script if not s.get(\"modes\") or args.mode in s[\"modes\"]]\n        else:\n            chat, profile = build_chat(args)\n    if model_tag is None:\n        model_tag = args.model or (\"replay:\" + os.path.basename(args.replay)\n                                   if args.replay else \"model\")\n    out_path = args.out or os.path.join(\n        \"metrics\", f\"corpus-{args.tag or args.mode}-{time.strftime('%Y%m%d-%H%M%S')}.jsonl\")\n    out_dir = os.path.dirname(os.path.abspath(out_path))\n    if out_dir:\n        os.makedirs(out_dir, exist_ok=True)\n\n    all_rows: list = []\n    assert_specs: dict = {}\n    with open(out_path, \"a\", encoding=\"utf-8\") as out:\n        for path in scenario_paths:\n            with open(path, encoding=\"utf-8\") as fh:\n                scenario = json.load(fh)\n            name = scenario.get(\"name\", path)\n            assert_spec = scenario.get(\"assert\") or {}\n            assert_specs[name] = assert_spec\n            rows = run_scenario(args, path, scenario, profile, model, model_tag,\n                                replay_script, chat, assert_spec, out)\n            all_rows.extend(rows)\n            if not args.quiet:\n                for row in rows:\n                    print(f\"{row['scenario']} t{row['trial']}.{row['permutation']} \"\n                          f\"seed={row['seed']} -> {row['decision_class']}:{row['chosen_key']} \"\n                          f\"reward={row['reward']:+.2f} cov={row['coverage_any_claimable']} \"\n                          f\"board={' > '.join(row['board_order']) or '<empty>'}\")\n    print_summary(all_rows, args, assert_specs)\n    if not args.quiet:\n        print(f\"\\nmetrics -> {out_path}\")\n    return all_rows\n\n\ndef run_scenario(args, path: str, scenario: dict, profile: dict, model, model_tag: str,\n                 replay_script, chat, assert_spec: dict, out) -> list:\n    trials = args.trials or scenario.get(\"trials\") or 8\n    perms = args.permutations or scenario.get(\"permutations\") or 1\n    budget = profile.get(\"budget\", 512) if hasattr(profile, \"get\") else 512\n    rows = []\n    for trial in range(1, trials + 1):\n        for perm in range(1, perms + 1):\n            seed = scenario.get(\"seed\", 0) + trial * 1000 + perm\n            rng = random.Random(seed)\n            effective, eff_path, tmpdir = scenario, path, None\n            if not args.tier0 and perms > 1:\n                effective = copy.deepcopy(scenario)\n                rng.shuffle(effective.get(\"open_tasks\", []))\n                tmpdir = tempfile.mkdtemp(prefix=\"siasworkshop-corpus-\")\n                eff_path = os.path.join(tmpdir, \"scenario.json\")\n                with open(eff_path, \"w\", encoding=\"utf-8\") as fh:\n                    json.dump(effective, fh)\n            try:\n                client = spawn_mock(eff_path)\n                try:\n                    client.start()\n                    run_model = model if model is not None else (\n                        FakeModel(replay_script, effective) if replay_script is not None else chat)\n                    decision = run_decision(args.mode, run_model, model_tag, client, profile,\n                                            tier0=args.tier0, rng=rng)\n                finally:\n                    client.close()\n            finally:\n                if tmpdir:\n                    shutil.rmtree(tmpdir, ignore_errors=True)\n            row = build_row(scenario, effective, trial, perm, seed, args, model_tag,\n                            decision, assert_spec, budget)\n            rows.append(row)\n            out.write(json.dumps(row) + \"\\n\")\n            out.flush()\n    return rows\n\n\ndef build_row(scenario, effective, trial, perm, seed, args, model_tag, decision,\n              assert_spec, budget) -> dict:\n    classified = corpus_score.classify(decision.tool, decision.args,\n                                       decision.decision_outcome, decision.exec_outcome,\n                                       decision.model_error)\n    scored = corpus_score.score_run(assert_spec, classified, decision.completion_tokens, budget)\n    decision_class = (\"wait_fallback\" if corpus_score.is_invalid(classified)\n                      else classified[0])\n    board_order = decision.board_order or [t[\"key\"] for t in effective.get(\"open_tasks\", [])]\n    return {\n        \"scenario\": scenario.get(\"name\", \"?\"),\n        \"trial\": trial,\n        \"permutation\": perm,\n        \"seed\": seed,\n        \"mode\": args.mode,\n        \"model\": model_tag,\n        \"tier0\": bool(args.tier0),\n        \"decision_class\": decision_class,\n        \"chosen_key\": classified[1],\n        \"correct\": scored[\"correct\"],\n        \"failure_class_hit\": scored[\"failure_class_hit\"],\n        \"invalid_reason\": classified[2],\n        \"coverage_any_claimable\": decision.coverage_any_claimable,\n        \"coverage_confidence\": decision.coverage_confidence,\n        \"completion_tokens\": decision.completion_tokens,\n        \"prompt_tokens\": decision.prompt_tokens,\n        \"latency_ms\": decision.total_latency_ms,\n        \"reward\": scored[\"reward\"],\n        \"board_order\": board_order,\n    }\n\n\ndef print_summary(rows: list, args, assert_specs: dict) -> None:\n    groups: dict = {}\n    for row in rows:\n        groups.setdefault((row[\"scenario\"], row[\"mode\"]), []).append(row)\n    print(\"\\n=== corpus summary (scenario × mode) ===\")\n    for (name, mode), group in sorted(groups.items()):\n        agg = corpus_score.summarize(group)\n        print(f\"{name:<36} {mode:<11} n={agg['n']:>3} \"\n              f\"mean_reward={agg['mean_reward']:+.3f} \"\n              f\"CI[{agg['ci_low']:+.3f},{agg['ci_high']:+.3f}] \"\n              f\"cov>=1/2/4 {agg['trials_success_ge1']}/{agg['trials_success_ge2']}/\"\n              f\"{agg['trials_success_ge4']} of {agg['trials']} trials\")\n        trials = args.trials if args.trials else None\n        perms = args.permutations if args.permutations else None\n        if perms and perms > 1 or args.tier0:\n            jm = corpus_score.jeva_metrics(group, assert_specs.get(name, {}))\n            nm = jm[\"null_matrix\"]\n            print(f\"{'':<36} {'':<11} flip_rate={jm['flip_rate']:.2f} \"\n                  f\"({jm['flip_trials']}/{jm['eligible_trials']} trials) \"\n                  f\"all_order_acc={jm['all_order_accuracy']:.2f} \"\n                  f\"per_order={json.dumps(jm['per_order_accuracy'])}\")\n            print(f\"{'':<36} {'':<11} null_matrix tp={nm['tp']} fp={nm['fp']} tn={nm['tn']} \"\n                  f\"fn={nm['fn']} tpr={nm['tpr']} fpr={nm['fpr']}\")\n\n\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(description=__doc__,\n                                 formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--corpus\", required=True,\n                    help=\"corpus scenario .json file or directory of them\")\n    ap.add_argument(\"--trials\", type=int, default=None, help=\"override scenario trials\")\n    ap.add_argument(\"--permutations\", type=int, default=None,\n                    help=\"override scenario permutations\")\n    ap.add_argument(\"--mode\", default=\"mcp-prompt\", choices=MODES)\n    src = ap.add_mutually_exclusive_group(required=True)\n    src.add_argument(\"--replay\", metavar=\"SCRIPT.json\",\n                     help=\"scripted-reply FakeModel per run (no network)\")\n    src.add_argument(\"--endpoint\", help=\"OpenAI-compatible base URL\")\n    ap.add_argument(\"--model\")\n    ap.add_argument(\"--api-key-env\", default=\"OPENROUTER_API_KEY\")\n    ap.add_argument(\"--cloud-config\", help=\"siasworkshop-server.toml with an [llm] section\")\n    ap.add_argument(\"--tier0\", action=\"store_true\",\n                    help=\"JEVA Tier-0 decide path: seeded board shuffle + coverage answer\")\n    ap.add_argument(\"--tag\", help=\"run-batch tag (default: mode)\")\n    ap.add_argument(\"--out\", help=\"metrics JSONL path (default: metrics/corpus-<tag>-<ts>.jsonl)\")\n    ap.add_argument(\"--quiet\", action=\"store_true\", help=\"suppress per-run lines\")\n    args = ap.parse_args(argv)\n    run(args)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}}}
